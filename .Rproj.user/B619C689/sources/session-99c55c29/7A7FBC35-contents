stat_is_enabled <- function(
    stat_id,
    section_id,
    include_all,
    include_sections,
    include_stats
) {
  section_is_on <-
    section_id %in% names(include_sections) &&
    isTRUE(include_sections[[section_id]])

  stat_is_on <-
    isTRUE(include_all) ||
    (
      stat_id %in% names(include_stats) &&
      isTRUE(include_stats[[stat_id]])
    )

  section_is_on && stat_is_on
}

stat_is_emphasized <- function(stat_id, emphasize_stats = NULL) {
  !is.null(emphasize_stats) &&
    stat_id %in% names(emphasize_stats) &&
    isTRUE(emphasize_stats[[stat_id]])
}

# Add a plus sign to positive values. Negative values retain their sign.
sign_prefix <- function(value) {
  ifelse(value > 0, "+", "")
}

# Standard value types use Chapter 1 precision and notation.
# Currency names state whether the incoming value is already in billions.
format_value <- function(value, value_type) {
  switch(
    value_type,

    count = scales::comma(value, accuracy = 1),

    signed_count = paste0(
      sign_prefix(value),
      scales::comma(value, accuracy = 1)
    ),

    share = scales::percent(value, accuracy = 0.1),

    signed_share = paste0(
      sign_prefix(value),
      scales::percent(value, accuracy = 0.1)
    ),

    percent_value = paste0(
      scales::number(value, accuracy = 0.1),
      "%"
    ),

    rate = scales::number(value, accuracy = 0.1),

    signed_score = paste0(
      sign_prefix(value),
      scales::number(value, accuracy = 0.1)
    ),

    ratio = paste0(
      scales::number(value, accuracy = 0.1),
      ":1"
    ),

    currency_billions = paste0(
      "$",
      scales::number(value, accuracy = 0.1, big.mark = ","),
      "B"
    ),

    signed_currency_billions = paste0(
      sign_prefix(value),
      "$",
      scales::number(abs(value), accuracy = 0.1, big.mark = ","),
      "B"
    ),

    currency_billions_from_dollars = paste0(
      "$",
      scales::number(value / 1e9, accuracy = 0.1, big.mark = ","),
      "B"
    ),

    stop("Unknown value type: ", value_type)
  )
}

format_cell <- function(
    value,
    year_label,
    value_type,
    projected = FALSE
) {
  label <- calendar_year_label(year_label)
  if (projected) label <- paste0(label, "P")
  paste0(format_value(value, value_type), " (", label, ")")
}

format_change <- function(first, last, change_type) {
  difference <- last - first
  relative_change <- if (isTRUE(all.equal(first, 0))) NA_real_ else (last / first) - 1
  multiple_value <- if (isTRUE(all.equal(first, 0))) NA_real_ else last / first

  unavailable <- function(value) {
    if (!is.finite(value)) "—" else NULL
  }

  if (change_type == "multiple" && !is.null(unavailable(multiple_value))) return("—")
  if (change_type == "percent" && !is.null(unavailable(relative_change))) return("—")

  switch(
    change_type,

    multiple = paste0(
      scales::number(multiple_value, accuracy = 0.1),
      "×"
    ),

    percent = paste0(
      sign_prefix(relative_change),
      scales::percent(relative_change, accuracy = 1)
    ),

    pp_share = paste0(
      sign_prefix(difference),
      scales::number(difference * 100, accuracy = 0.1),
      " pp"
    ),

    pp_percent = paste0(
      sign_prefix(difference),
      scales::number(difference, accuracy = 0.1),
      " pp"
    ),

    ratio_points = paste0(
      sign_prefix(difference),
      scales::number(difference, accuracy = 0.1),
      " ratio points"
    ),

    points = paste0(
      sign_prefix(difference),
      scales::number(difference, accuracy = 0.1),
      " points"
    ),

    count_delta = paste0(
      sign_prefix(difference),
      scales::comma(difference, accuracy = 1)
    ),

    currency_delta_billions = paste0(
      sign_prefix(difference),
      "$",
      scales::number(abs(difference), accuracy = 0.1, big.mark = ","),
      "B"
    ),

    currency_delta_from_dollars = paste0(
      sign_prefix(difference),
      "$",
      scales::number(abs(difference) / 1e9, accuracy = 0.1, big.mark = ","),
      "B"
    ),

    stop("Unknown change type: ", change_type)
  )
}

# Chapter 1 typography is the shared default. panel_font_px is included so
# chapters with a panel label can use the same scale without a second layout.
layout_for_rows <- function(n_rows) {
  if (n_rows <= 16) {
    out <- list(
      data_font_px = 20,
      header_font_px = 18,
      chapter_font_px = 17,
      title_font_px = 31,
      subtitle_font_px = 18,
      group_font_px = 18,
      source_font_px = 16,
      initial_padding_px = 6
    )
  } else if (n_rows <= 24) {
    out <- list(
      data_font_px = 18,
      header_font_px = 17,
      chapter_font_px = 16,
      title_font_px = 29,
      subtitle_font_px = 17,
      group_font_px = 17,
      source_font_px = 15,
      initial_padding_px = 4
    )
  } else if (n_rows <= 32) {
    out <- list(
      data_font_px = 17,
      header_font_px = 16,
      chapter_font_px = 15,
      title_font_px = 27,
      subtitle_font_px = 16,
      group_font_px = 16,
      source_font_px = 14,
      initial_padding_px = 2.5
    )
  } else {
    out <- list(
      data_font_px = 15.5,
      header_font_px = 15,
      chapter_font_px = 14,
      title_font_px = 25,
      subtitle_font_px = 15,
      group_font_px = 15,
      source_font_px = 13.5,
      initial_padding_px = 1.25
    )
  }

  out$panel_font_px <- out$group_font_px
  out
}

font_sizes <- function(layout, font_scale = 1, minimums = NULL) {
  minimums <- modifyList(
    list(
      data = 12,
      header = 12,
      chapter = 12,
      title = 20,
      subtitle = 12,
      panel = 12,
      group = 12,
      source = 11
    ),
    minimums %||% list()
  )

  list(
    data = max(minimums$data, layout$data_font_px * font_scale),
    header = max(minimums$header, layout$header_font_px * font_scale),
    chapter = max(minimums$chapter, layout$chapter_font_px * font_scale),
    title = max(minimums$title, layout$title_font_px * font_scale),
    subtitle = max(minimums$subtitle, layout$subtitle_font_px * font_scale),
    panel = max(
      minimums$panel,
      (layout$panel_font_px %||% layout$group_font_px) * font_scale
    ),
    group = max(minimums$group, layout$group_font_px * font_scale),
    source = max(minimums$source, layout$source_font_px * font_scale)
  )
}

build_infographic_table <- function(
    data,
    id,
    chapter_number,
    title,
    subtitle = NULL,
    panel_label = NULL,
    column_labels = c(
      Earlier = "Earlier<br>value",
      Latest = "Latest or projected<br>value",
      Change = "Change"
    ),
    notes = character(),
    layout = layout_for_rows(nrow(data)),
    row_padding_px = layout$initial_padding_px,
    font_scale = 1,
    minimum_fonts = NULL,
    nowrap_values = FALSE,
    top_border = FALSE
) {
  sizes <- font_sizes(layout, font_scale, minimum_fonts)

  hidden_columns <- intersect(
    c("StatID", "SectionID", "Emphasis", "RowOrder", "SnapshotOrder"),
    names(data)
  )

  title_html <- if (is.null(chapter_number)) {
    paste0("<span class='infographic-panel-title'>", title, "</span>")
  } else {
    paste0(
      "<span class='infographic-kicker'>CHAPTER ", chapter_number, "</span>",
      "<br>",
      "<span class='infographic-main-title'>", title, "</span>"
    )
  }

  subtitle_html <- NULL
  if (!is.null(subtitle) || !is.null(panel_label)) {
    subtitle_html <- paste0(
      if (!is.null(subtitle)) {
        paste0("<span class='infographic-subtitle'>", subtitle, "</span>")
      } else {
        ""
      },
      if (!is.null(subtitle) && !is.null(panel_label)) "<br>" else "",
      if (!is.null(panel_label)) {
        paste0("<span class='infographic-panel-label'>", panel_label, "</span>")
      } else {
        ""
      }
    )
  }

  tbl <- data %>%
    gt::gt(
      rowname_col = "Measure",
      groupname_col = "Section",
      id = id
    ) %>%
    gt::tab_stubhead(label = "Measure") %>%
    gt::cols_label(
      Earlier = gt::html(unname(column_labels[["Earlier"]])),
      Latest = gt::html(unname(column_labels[["Latest"]])),
      Change = gt::html(unname(column_labels[["Change"]]))
    ) %>%
    gt::cols_align(
      align = "center",
      columns = c(Earlier, Latest, Change)
    ) %>%
    gt::cols_hide(columns = tidyselect::any_of(hidden_columns)) %>%
    theme_gt_tpa() %>%
    gt::tab_header(
      title = gt::html(title_html),
      subtitle = if (is.null(subtitle_html)) NULL else gt::html(subtitle_html)
    )

  for (note in notes) {
    tbl <- gt::tab_source_note(tbl, source_note = gt::md(note))
  }

  tbl <- tbl %>%
    gt::tab_style(
      style = gt::cell_text(align = "left"),
      locations = gt::cells_stub(rows = TRUE)
    ) %>%
    gt::tab_style(
      style = list(
        gt::cell_fill(color = INFOGRAPHIC_PALETTE$gray),
        gt::cell_text(color = "white", weight = "bold")
      ),
      locations = gt::cells_column_labels(tidyselect::everything())
    ) %>%
    gt::tab_style(
      style = gt::cell_borders(
        sides = "top",
        color = INFOGRAPHIC_PALETTE$red,
        weight = gt::px(3)
      ),
      locations = gt::cells_column_labels(tidyselect::everything())
    ) %>%
    gt::tab_style(
      style = list(
        gt::cell_fill(color = INFOGRAPHIC_PALETTE$tint),
        gt::cell_text(
          color = INFOGRAPHIC_PALETTE$red,
          weight = "bold",
          transform = "uppercase"
        )
      ),
      locations = gt::cells_row_groups()
    ) %>%
    gt::tab_style(
      style = list(
        gt::cell_fill(color = INFOGRAPHIC_PALETTE$pink),
        gt::cell_text(color = INFOGRAPHIC_PALETTE$red, weight = "bold")
      ),
      locations = gt::cells_body(columns = Latest)
    )

  if ("Emphasis" %in% names(data)) {
    tbl <- tbl %>%
      gt::tab_style(
        style = gt::cell_text(weight = "bold"),
        locations = list(
          gt::cells_stub(rows = Emphasis == TRUE),
          gt::cells_body(rows = Emphasis == TRUE)
        )
      )
  }

  tbl <- tbl %>%
    gt::tab_style(
      style = gt::cell_text(color = INFOGRAPHIC_PALETTE$muted),
      locations = gt::cells_source_notes()
    ) %>%
    gt::tab_options(
      table.font.size = gt::px(sizes$data),
      table.font.color = INFOGRAPHIC_PALETTE$text,
      column_labels.font.size = gt::px(sizes$header),
      column_labels.padding = gt::px(5),
      data_row.padding = gt::px(row_padding_px),
      heading.title.font.size = gt::px(sizes$title),
      heading.subtitle.font.size = gt::px(sizes$subtitle),
      heading.padding = gt::px(8),
      heading.align = "left",
      source_notes.font.size = gt::px(sizes$source),
      source_notes.padding = gt::px(5),
      table.background.color = "white",
      row.striping.background_color = "white",
      table_body.hlines.color = INFOGRAPHIC_PALETTE$rule,
      table_body.hlines.width = gt::px(1),
      row_group.border.top.color = INFOGRAPHIC_PALETTE$rule,
      row_group.border.bottom.color = INFOGRAPHIC_PALETTE$rule,
      table.width = gt::px(INFOGRAPHIC_SPEC$css_width_px),
      container.width = gt::px(INFOGRAPHIC_SPEC$css_width_px)
    ) %>%
    fixed_table_width(
      profile = "ultrawide",
      width_px = INFOGRAPHIC_SPEC$css_width_px,
      stub_width_px = unname(INFOGRAPHIC_COLUMNS[["measure"]])
    ) %>%
    gt::cols_width(
      gt::stub() ~ gt::px(unname(INFOGRAPHIC_COLUMNS[["measure"]])),
      Earlier ~ gt::px(unname(INFOGRAPHIC_COLUMNS[["earlier"]])),
      Latest ~ gt::px(unname(INFOGRAPHIC_COLUMNS[["latest"]])),
      Change ~ gt::px(unname(INFOGRAPHIC_COLUMNS[["change"]]))
    )

  css <- paste0(
    "#", id, " .infographic-kicker {",
    "color:", INFOGRAPHIC_PALETTE$red, ";",
    "font-size:", sizes$chapter, "px;",
    "font-weight:700;letter-spacing:1.5px;line-height:1.0;}",

    "#", id, " .infographic-main-title {",
    "color:", INFOGRAPHIC_PALETTE$text, ";",
    "font-size:", sizes$title, "px;",
    "font-weight:700;line-height:1.04;}",

    "#", id, " .infographic-subtitle {",
    "color:", INFOGRAPHIC_PALETTE$muted, ";",
    "font-size:", sizes$subtitle, "px;line-height:1.1;}",

    "#", id, " .infographic-panel-label {",
    "color:", INFOGRAPHIC_PALETTE$red, ";",
    "font-size:", sizes$panel, "px;",
    "font-weight:700;letter-spacing:1px;line-height:1.5;}",

    "#", id, " .infographic-panel-title {",
    "color:", INFOGRAPHIC_PALETTE$text, ";",
    "font-size:", sizes$panel, "px;",
    "font-weight:700;letter-spacing:0.4px;line-height:1.0;}",

    "#", id, " .gt_heading {padding-left:8px !important;",
    "padding-right:8px !important;}",

    "#", id, " .gt_subtitle {font-size:", sizes$subtitle,
    "px !important;line-height:1.1 !important;}",

    "#", id, " .gt_group_heading {font-size:", sizes$group,
    "px !important;line-height:1.05 !important;",
    "padding-top:4px !important;padding-bottom:4px !important;",
    "white-space:normal !important;}",

    "#", id, " .gt_row {line-height:1.03 !important;}",
    "#", id, " .gt_stub, #", id, " .gt_rowname {",
    "padding-left:8px !important;padding-right:8px !important;}",
    "#", id, " .gt_source_notes {line-height:1.08 !important;",
    "padding-left:8px !important;padding-right:8px !important;}",
    "#", id, " .gt_col_heading {line-height:1.05 !important;}",
    if (nowrap_values) {
      paste0(
        "#", id,
        " tbody td:not(.gt_stub):not(.gt_rowname) {white-space:nowrap !important;}"
      )
    } else {
      ""
    },
    if (top_border) {
      paste0(
        "#", id, " .gt_table {border-top:4px solid ",
        INFOGRAPHIC_PALETTE$red, " !important;}"
      )
    } else {
      ""
    }
  )

  gt::opt_css(tbl, css = css)
}

export_infographic_table <- function(
    build_table,
    name,
    n_rows,
    initial_row_padding_px,
    max_iterations = 6,
    min_font_scale = 0.78,
    output_dir = "final_infographics"
) {
  if (!requireNamespace("magick", quietly = TRUE)) {
    stop("The magick package is required for exact infographic export.")
  }

  if (!is.function(build_table)) {
    stop("`build_table` must be a function accepting row_padding_px and font_scale.")
  }

  if (n_rows < 1) {
    stop("`n_rows` must be at least 1.")
  }

  html_dir <- file.path(output_dir, "html")
  png_dir <- file.path(output_dir, "pngs")
  dir.create(html_dir, recursive = TRUE, showWarnings = FALSE)
  dir.create(png_dir, recursive = TRUE, showWarnings = FALSE)

  html_path <- file.path(html_dir, paste0(name, ".html"))
  png_path <- file.path(png_dir, paste0(name, ".png"))
  raw_path <- file.path(png_dir, paste0(name, "_raw.png"))

  row_padding_px <- initial_row_padding_px
  font_scale <- 1

  for (iteration in seq_len(max_iterations)) {
    trial_table <- build_table(
      row_padding_px = row_padding_px,
      font_scale = font_scale
    )

    gt::gtsave(
      trial_table,
      raw_path,
      vwidth = INFOGRAPHIC_SPEC$css_width_px,
      vheight = INFOGRAPHIC_SPEC$css_height_px,
      zoom = INFOGRAPHIC_SPEC$zoom,
      expand = 0
    )

    rendered_height_px <- magick::image_info(
      magick::image_read(raw_path)
    )$height[[1]]

    height_difference_px <-
      INFOGRAPHIC_SPEC$output_height_px - rendered_height_px

    if (abs(height_difference_px) <= 10) {
      break
    }

    padding_correction_px <-
      (height_difference_px / INFOGRAPHIC_SPEC$zoom) / (2 * n_rows)

    proposed_padding_px <- row_padding_px + padding_correction_px

    if (height_difference_px < 0 && proposed_padding_px < 0.25) {
      row_padding_px <- 0.25
      proportional_scale <-
        INFOGRAPHIC_SPEC$output_height_px / rendered_height_px
      font_scale <- max(
        min_font_scale,
        font_scale * min(0.98, proportional_scale)
      )
    } else {
      row_padding_px <- max(0.25, min(30, proposed_padding_px))
    }
  }

  final_table <- build_table(
    row_padding_px = row_padding_px,
    font_scale = font_scale
  )

  gt::gtsave(final_table, html_path)
  gt::gtsave(
    final_table,
    raw_path,
    vwidth = INFOGRAPHIC_SPEC$css_width_px,
    vheight = INFOGRAPHIC_SPEC$css_height_px,
    zoom = INFOGRAPHIC_SPEC$zoom,
    expand = 0
  )

  image <- magick::image_read(raw_path)
  image_info <- magick::image_info(image)

  if (image_info$width[[1]] != INFOGRAPHIC_SPEC$output_width_px) {
    image <- magick::image_resize(
      image,
      paste0(INFOGRAPHIC_SPEC$output_width_px, "x")
    )
  }

  image_info <- magick::image_info(image)
  if (image_info$height[[1]] > INFOGRAPHIC_SPEC$output_height_px) {
    image <- magick::image_resize(
      image,
      paste0(
        INFOGRAPHIC_SPEC$output_width_px,
        "x",
        INFOGRAPHIC_SPEC$output_height_px,
        ">"
      )
    )
  }

  image <- magick::image_extent(
    image,
    geometry = paste0(
      INFOGRAPHIC_SPEC$output_width_px,
      "x",
      INFOGRAPHIC_SPEC$output_height_px
    ),
    gravity = "north",
    color = "white"
  )

  magick::image_write(
    image,
    path = png_path,
    format = "png",
    density = paste0(INFOGRAPHIC_SPEC$dpi, "x", INFOGRAPHIC_SPEC$dpi)
  )

  final_info <- magick::image_info(magick::image_read(png_path))
  if (
    final_info$width[[1]] != INFOGRAPHIC_SPEC$output_width_px ||
    final_info$height[[1]] != INFOGRAPHIC_SPEC$output_height_px
  ) {
    stop(
      "Final PNG is ", final_info$width[[1]], " × ", final_info$height[[1]],
      " pixels; expected ", INFOGRAPHIC_SPEC$output_width_px, " × ",
      INFOGRAPHIC_SPEC$output_height_px, "."
    )
  }

  if (file.exists(raw_path)) {
    unlink(raw_path)
  }

  message(
    "Saved ", png_path, " at ", final_info$width[[1]], " × ",
    final_info$height[[1]], " pixels. Included statistics: ", n_rows,
    ". Final row padding: ", round(row_padding_px, 2),
    " CSS px. Font scale: ", round(font_scale, 3), "."
  )

  invisible(
    list(
      table = final_table,
      html_path = html_path,
      png_path = png_path,
      width_px = final_info$width[[1]],
      height_px = final_info$height[[1]],
      row_padding_px = row_padding_px,
      font_scale = font_scale,
      included_statistics = n_rows
    )
  )
}
