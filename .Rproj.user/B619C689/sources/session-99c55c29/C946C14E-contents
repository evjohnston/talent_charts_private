ch2_make_metric <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    first,
    first_year,
    last,
    last_year,
    value_type,
    change_type,
    emphasis = FALSE
) {

  if (
    !ch2_stat_enabled(
      stat_id,
      section_id
    )
  ) {
    return(NULL)
  }

  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,

    Earlier = ch2_format_cell(
      value = first,
      year_label = first_year,
      value_type = value_type
    ),

    Latest = ch2_format_cell(
      value = last,
      year_label = last_year,
      value_type = value_type
    ),

    Change = ch2_format_change(
      first = first,
      last = last,
      change_type = change_type
    ),

    Emphasis = emphasis
  )
}


ch2_make_snapshot <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    change,
    emphasis = FALSE
) {

  if (
    !ch2_stat_enabled(
      stat_id,
