# ============================================================================
# 8. FORMATTING HELPERS
# ============================================================================

ch5_sign_prefix <- function(value) {

  if (value > 0) {
    "+"
  } else {
    ""
  }
}


ch5_format_value <- function(
    value,
    value_type
) {

  switch(
    value_type,

    share = scales::percent(
      value,
      accuracy = 0.1
    ),

    signed_share = paste0(
      ch5_sign_prefix(value),
      scales::percent(
        value,
        accuracy = 0.1
      )
    ),

    count = scales::comma(
      value,
      accuracy = 1
    ),

    signed_count = paste0(
      ch5_sign_prefix(value),
      scales::comma(
        value,
        accuracy = 1
      )
    ),

    currency_bn = paste0(
      "$",
      scales::number(
        value,
        accuracy = 0.1,
        big.mark = ","
      ),
      "B"
    ),

    signed_currency_bn = paste0(
      ch5_sign_prefix(value),
      "$",
      scales::number(
        abs(value),
        accuracy = 0.1,
        big.mark = ","
      ),
      "B"
    ),

    stop(
      "Unknown Chapter 5 value type: ",
      value_type
    )
  )
}


ch5_format_cell <- function(
    value,
    label,
    value_type
) {

  paste0(
    ch5_format_value(
      value,
      value_type
    ),
    " (",
    label,
    ")"
  )
}


ch5_format_change <- function(
    first,
    last,
    change_type
) {

  difference <- last - first


  switch(
    change_type,

    pp = paste0(
      ch5_sign_prefix(
        difference
      ),
      scales::number(
        difference *
          100,
        accuracy = 0.1
      ),
      " pp"
    ),

    count_delta = paste0(
      ch5_sign_prefix(
        difference
      ),
      scales::comma(
        difference,
        accuracy = 1
      )
    ),

    currency_delta = paste0(
      ch5_sign_prefix(
        difference
      ),
      "$",
      scales::number(
        abs(
          difference
        ),
        accuracy = 0.1,
        big.mark = ","
      ),
      "B"
    ),

    multiple = paste0(
      scales::number(
        last /
          first,
        accuracy = 0.1
      ),
      "×"
    ),

    stop(
      "Unknown Chapter 5 change type: ",
      change_type
    )
  )
}


# ============================================================================
# 9. ROW-BUILDING HELPERS
# ============================================================================

ch5_make_metric <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    first,
    first_label,
    last,
    last_label,
    value_type,
    change_type,
    emphasis = FALSE
) {

  if (
    !ch5_stat_enabled(
      stat_id,
      section_id
    )
  ) {

    return(NULL)
  }


  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,

    Earlier = ch5_format_cell(
      value = first,
      label = first_label,
      value_type = value_type
    ),

    Latest = ch5_format_cell(
      value = last,
      label = last_label,
      value_type = value_type
    ),

    Change = ch5_format_change(
      first = first,
      last = last,
      change_type = change_type
    ),

    Emphasis = emphasis
  )
}


ch5_make_display_row <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    earlier,
    latest,
    change,
    emphasis = FALSE
) {

  if (
    !ch5_stat_enabled(
      stat_id,
      section_id
    )
  ) {

    return(NULL)
  }


  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,
    Earlier = earlier,
    Latest = latest,
    Change = change,
    Emphasis = emphasis
  )
}


