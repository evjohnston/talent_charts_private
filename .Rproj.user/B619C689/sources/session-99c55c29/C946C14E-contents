# ============================================================================
# 13. BUILD ONE CHAPTER 5 TABLE
# ============================================================================

build_chapter5_table <- function(
    row_padding_px =
      CH5_INITIAL_ROW_PADDING_PX,
    font_scale = 1
) {

  data_font_px <- max(
    10,
    CH5_TABLE_LAYOUT$data_font_px *
      font_scale
  )


  header_font_px <- max(
    10,
    CH5_TABLE_LAYOUT$header_font_px *
      font_scale
  )


  chapter_font_px <- max(
    10,
    CH5_TABLE_LAYOUT$chapter_font_px *
      font_scale
  )


  title_font_px <- max(
    18,
    CH5_TABLE_LAYOUT$title_font_px *
      font_scale
  )


  subtitle_font_px <- max(
    10,
    CH5_TABLE_LAYOUT$subtitle_font_px *
      font_scale
  )


  panel_font_px <- max(
    10,
    CH5_TABLE_LAYOUT$panel_font_px *
      font_scale
  )


  group_font_px <- max(
    10,
    CH5_TABLE_LAYOUT$group_font_px *
      font_scale
  )


  source_font_px <- max(
    8.75,
    CH5_TABLE_LAYOUT$source_font_px *
      font_scale
  )


  ch5_table_data %>%
    gt(
      rowname_col = "Measure",
      groupname_col = "Section",
      id = "chapter5_numbers"
    ) %>%

    tab_stubhead(
      label = "Measure"
    ) %>%

    cols_label(
      Earlier = "Earlier",
      Latest = "Latest",
      Change = "Change"
    ) %>%

    cols_align(
      align = "center",
      columns = c(
        Earlier,
        Latest,
        Change
      )
    ) %>%

    cols_hide(
      columns = c(
        StatID,
        SectionID,
        Emphasis,
        RowOrder
      )
    ) %>%

    theme_gt_tpa() %>%

    tab_header(
      title = html(
        paste0(
          "<span class='ch5-kicker'>",
          "CHAPTER 5",
          "</span>",
          "<br>",
          "<span class='ch5-main-title'>",
          "THE TALENT MAGNET",
          "</span>"
        )
      ),

      subtitle = html(
        paste0(
          "<span class='ch5-subtitle'>",
          "America’s Narrowing Research Advantage",
          "</span>",
          "<br>",
          "<span class='ch5-panel-label'>",
          "BY THE NUMBERS",
          "</span>"
        )
      )
    ) %>%

    tab_source_note(
      source_note = md(
        paste0(
          "**Note:** Conference medians compare each venue’s first and ",
          "latest common U.S.–China observation; coverage windows therefore ",
          "differ. U.S.–China gaps equal U.S. values minus China values. ",
          "R&D spending is shown in current purchasing-power-parity dollars. ",
          "Patent measures count grants."
        )
      )
    ) %>%

    tab_source_note(
      source_note = md(
        paste0(
          "**Source:** See the Chapter 5 figures and tables for full ",
          "citations. Data sources include Paper Copilot, OpenAlex, ",
          "Clarivate, Times Higher Education, OECD, WIPO, IPO Association, ",
          "Harrity & Harrity, and USPTO PatentsView."
        )
      )
    ) %>%

    tab_style(
      style = cell_text(
        align = "left"
      ),
      locations = cells_stub(
        rows = TRUE
      )
    ) %>%

    tab_style(
      style = list(
        cell_fill(
          color = CH5_GRAY
        ),

        cell_text(
          color = "white",
          weight = "bold"
        )
      ),
      locations = cells_column_labels(
        everything()
      )
    ) %>%

    tab_style(
      style = cell_borders(
        sides = "top",
        color = CH5_RED,
        weight = px(3)
      ),
      locations = cells_column_labels(
        everything()
      )
    ) %>%

    tab_style(
      style = list(
        cell_fill(
          color = CH5_TINT
        ),

        cell_text(
          color = CH5_RED,
          weight = "bold",
          transform = "uppercase"
        )
      ),
      locations = cells_row_groups()
    ) %>%

    tab_style(
      style = list(
        cell_fill(
          color = CH5_PINK
        ),

        cell_text(
          color = CH5_RED,
          weight = "bold"
        )
      ),
      locations = cells_body(
        columns = Latest
      )
    ) %>%

    tab_style(
      style = cell_text(
        weight = "bold"
      ),
      locations = list(
        cells_stub(
          rows = Emphasis
        ),

        cells_body(
          rows = Emphasis
        )
      )
    ) %>%

    tab_style(
      style = cell_text(
        color = CH5_MUTED
      ),
      locations = cells_source_notes()
    ) %>%

    tab_options(
      table.font.size = px(
        data_font_px
      ),

      table.font.color = CH5_TEXT,

      column_labels.font.size = px(
        header_font_px
      ),

      column_labels.padding = px(3),

      data_row.padding = px(
        row_padding_px
      ),

      heading.title.font.size = px(
        title_font_px
      ),

      heading.subtitle.font.size = px(
        subtitle_font_px
      ),

      heading.padding = px(6),
      heading.align = "left",

      source_notes.font.size = px(
        source_font_px
      ),

      source_notes.padding = px(2),

      table.background.color = "white",
      row.striping.background_color = "white",

      table_body.hlines.color = CH5_RULE,
      table_body.hlines.width = px(1),

      row_group.border.top.color = CH5_RULE,
      row_group.border.bottom.color = CH5_RULE,

      table.width = px(
        CH5_CSS_WIDTH_PX
      ),

      container.width = px(
        CH5_CSS_WIDTH_PX
      )
    ) %>%

    fixed_table_width(
      profile = "ultrawide",
      width_px = CH5_CSS_WIDTH_PX,
      stub_width_px = CH5_COL_MEASURE_PX
    ) %>%

    cols_width(
      stub()  ~ px(CH5_COL_MEASURE_PX),
      Earlier ~ px(CH5_COL_EARLIER_PX),
      Latest  ~ px(CH5_COL_LATEST_PX),
      Change  ~ px(CH5_COL_CHANGE_PX)
    ) %>%

    opt_css(
      css = paste0(
        "#chapter5_numbers .ch5-kicker {",
        "color:", CH5_RED, ";",
        "font-size:", chapter_font_px, "px;",
