build_chapter2_table <- function(
    row_padding_px = CH2_INITIAL_ROW_PADDING_PX,
    font_scale = 1
) {

  data_font_px <- max(
    12,
    CH2_TABLE_LAYOUT$data_font_px * font_scale
  )

  header_font_px <- max(
    12,
    CH2_TABLE_LAYOUT$header_font_px * font_scale
  )

  chapter_font_px <- max(
    12,
    CH2_TABLE_LAYOUT$chapter_font_px * font_scale
  )

  title_font_px <- max(
    20,
    CH2_TABLE_LAYOUT$title_font_px * font_scale
  )

  subtitle_font_px <- max(
    12,
    CH2_TABLE_LAYOUT$subtitle_font_px * font_scale
  )

  group_font_px <- max(
    12,
    CH2_TABLE_LAYOUT$group_font_px * font_scale
  )

  source_font_px <- max(
    11,
    CH2_TABLE_LAYOUT$source_font_px * font_scale
  )


  ch2_table_data %>%
    gt(
      rowname_col = "Measure",
      groupname_col = "Section",
      id = "chapter2_numbers"
    ) %>%

    tab_stubhead(
      label = "Measure"
    ) %>%

    cols_label(
      Earlier = html(
        "Earlier or<br>baseline"
      ),
      Latest = html(
        "Latest or<br>comparison"
      ),
      Change = "Change"
    ) %>%

    cols_align(
      align = "center",
      columns = c(
        Earlier,
        Latest,
        Change
      )
    ) %>%

    cols_hide(
      columns = c(
        StatID,
        SectionID,
        Emphasis
      )
    ) %>%

    theme_gt_tpa() %>%

    tab_header(
      title = html(
        paste0(
          "<span class='ch2-kicker'>CHAPTER 2</span>",
          "<br>",
          "<span class='ch2-main-title'>WHO COMES TO THE UNITED STATES TO STUDY?</span>"
        )
      ),

      subtitle = md(
        "The changing sources of America's international STEM talent"
      )
    ) %>%

    tab_source_note(
      source_note = md(
        paste0(
          "**Note:** Academic-year data are labeled by the year in which ",
          "the academic year ended. The 2025 enrollment, recruitment, and ",
          "barrier measures come from the Fall 2025 Snapshot."
        )
      )
    ) %>%

    tab_source_note(
      source_note = md(
        paste0(
          "**Source:** See figures 2.01-2.08, and tables 2.01-2.02 ",
          "for full citations."
        )
      )
    ) %>%

    tab_style(
      style = cell_text(
        align = "left"
      ),
      locations = cells_stub(
        rows = TRUE
      )
    ) %>%

    tab_style(
      style = list(
        cell_fill(
          color = CH2_GRAY
        ),

        cell_text(
          color = "white",
          weight = "bold"
        )
      ),
      locations = cells_column_labels(
        everything()
      )
    ) %>%

    tab_style(
      style = cell_borders(
        sides = "top",
        color = CH2_RED,
        weight = px(3)
      ),
      locations = cells_column_labels(
        everything()
      )
    ) %>%

    tab_style(
      style = list(
        cell_fill(
          color = CH2_TINT
        ),

        cell_text(
          color = CH2_RED,
          weight = "bold",
          transform = "uppercase"
        )
      ),
      locations = cells_row_groups()
    ) %>%

    tab_style(
      style = list(
        cell_fill(
          color = CH2_PINK
        ),

        cell_text(
          color = CH2_RED,
          weight = "bold"
        )
      ),
      locations = cells_body(
        columns = Latest
      )
    ) %>%

    tab_style(
      style = cell_text(
