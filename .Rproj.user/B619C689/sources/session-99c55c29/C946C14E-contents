ch2_layout_for_rows <- function(n_rows) {

  if (n_rows <= 16) {

    list(
      data_font_px = 20,
      header_font_px = 18,
      chapter_font_px = 17,
      title_font_px = 31,
      subtitle_font_px = 18,
      group_font_px = 18,
      source_font_px = 16,
      initial_padding_px = 6
    )

  } else if (n_rows <= 24) {

    list(
      data_font_px = 18,
      header_font_px = 17,
      chapter_font_px = 16,
      title_font_px = 29,
      subtitle_font_px = 17,
      group_font_px = 17,
      source_font_px = 15,
      initial_padding_px = 4
    )

  } else if (n_rows <= 32) {

    list(
      data_font_px = 17,
      header_font_px = 16,
      chapter_font_px = 15,
      title_font_px = 27,
      subtitle_font_px = 16,
      group_font_px = 16,
      source_font_px = 14,
      initial_padding_px = 2.5
    )

  } else {

    list(
      data_font_px = 15.5,
      header_font_px = 15,
      chapter_font_px = 14,
      title_font_px = 25,
      subtitle_font_px = 15,
      group_font_px = 15,
      source_font_px = 13.5,
      initial_padding_px = 1.25
    )
  }
}


