ch6_numeric <- function(x) {

  suppressWarnings(
    as.numeric(
      gsub(
        pattern = "[,$%]",
        replacement = "",
        x = as.character(x)
      )
    )
  )
}


ch6_normalize_label <- function(x) {

  tolower(
    trimws(
      gsub(
        pattern = "\\*",
        replacement = "",
        x = as.character(x)
      )
    )
  )
}


ch6_value_at <- function(
    df,
    year,
    column,
    year_column = "Year"
) {

  if (!year_column %in% names(df)) {

    stop(
      "Year column `",
      year_column,
      "` was not found."
    )
  }


  if (!column %in% names(df)) {

    stop(
      "Column `",
      column,
      "` was not found."
    )
  }


  matching_values <- df[
    as.character(
      df[[year_column]]
    ) ==
      as.character(year),
    column,
    drop = TRUE
  ]


  matching_values <- ch6_numeric(
    matching_values
  )


  if (
    length(matching_values) != 1 ||
    is.na(matching_values[[1]])
  ) {

    stop(
      "Expected one nonmissing value for `",
      column,
      "` in ",
      year,
      "."
    )
  }


  matching_values[[1]]
}


