ch4_mobility_series <- function(
    indicator,
    country
) {

  out <- ch4_mobility_raw %>%
    filter(
      .data$Indicator ==
        .env$indicator,

      .data$Country ==
        .env$country
    ) %>%
    arrange(
      Year
    )


  if (nrow(out) == 0) {

    stop(
      "No mobility data found for ",
      country,
      " and ",
      indicator,
      "."
    )
  }


  out
}


ch4_mobility_value <- function(
    indicator,
    country,
    year
) {

  out <- ch4_mobility_series(
    indicator,
    country
  ) %>%
    filter(
      .data$Year ==
        .env$year
    ) %>%
    pull(
      Value
    )


  if (
    length(out) != 1 ||
    is.na(out[[1]])
  ) {

    stop(
      "Expected one mobility value for ",
      country,
      ", ",
      indicator,
      ", ",
      year,
      "."
    )
  }


  out[[1]]
}


ch4_mobility_common_years <- function(indicator) {

  us_years <- ch4_mobility_series(
    indicator,
    "United States"
  ) %>%
    pull(
      Year
    )


  china_years <- ch4_mobility_series(
    indicator,
    "China"
  ) %>%
    pull(
      Year
    )


  common_years <- intersect(
    us_years,
    china_years
  )


  if (length(common_years) == 0) {

    stop(
      "No common U.S.–China years were found for ",
      indicator,
      "."
    )
  }


  sort(
    common_years
  )
}


