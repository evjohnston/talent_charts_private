ch2_value_at <- function(
    df,
    year,
    column
) {

  out <- df %>%
    filter(
      .data$Year == .env$year
    ) %>%
    pull(
      all_of(column)
    )

  out <- suppressWarnings(
    as.numeric(out)
  )

  if (
    length(out) != 1 ||
    is.na(out[[1]])
  ) {
    stop(
      "Expected one nonmissing value for `",
      column,
      "` in ",
      year,
      "."
    )
  }

  out[[1]]
}


ch2_sum_at <- function(
    df,
    year,
    columns
) {

  row <- df %>%
    filter(
      .data$Year == .env$year
    ) %>%
    select(
      all_of(columns)
    )

  if (nrow(row) != 1) {
    stop(
      "Expected one row for ",
      year,
      "."
    )
  }

  values <- suppressWarnings(
    as.numeric(
      unlist(
        row[1, ],
        use.names = FALSE
      )
    )
  )

  if (all(is.na(values))) {
    stop(
      "No usable values found for ",
      year,
      "."
    )
  }

  sum(
    values,
    na.rm = TRUE
  )
}


