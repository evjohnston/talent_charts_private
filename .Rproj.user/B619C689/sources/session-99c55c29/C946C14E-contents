  mutate(
    Section = factor(
      Section,
      levels =
        ch5_section_order
    )
  ) %>%
  arrange(
    Section,
    RowOrder
  )


if (any(is.na(ch5_table_data$Section))) {

  missing_sections <- ch5_table_data %>%
    filter(
      is.na(Section)
    ) %>%
    distinct(
      SectionID
    ) %>%
    pull(
      SectionID
    )


  stop(
    "The following Chapter 5 sections were not included in ",
    "ch5_section_order: ",
    paste(
      missing_sections,
      collapse = ", "
    ),
    "."
  )
}


