    value_type,

    share = scales::percent(
      value,
      accuracy = 0.1
    ),

    count = scales::comma(
      value,
      accuracy = 1
    ),

    signed_count = paste0(
      ch6_sign_prefix(value),
      scales::comma(
        value,
        accuracy = 1
      )
    ),

    currency_bn = paste0(
      "$",
      scales::number(
        value /
          1e9,
        accuracy = 0.1,
        big.mark = ","
      ),
      "B"
    ),

    stop(
      "Unknown Chapter 6 value type: ",
      value_type
    )
  )
}


ch6_format_cell <- function(
    value,
    label,
    value_type
) {

  paste0(
    ch6_format_value(
      value,
      value_type
    ),
    " (",
    label,
    ")"
  )
}


ch6_format_change <- function(
    first,
    last,
    change_type
) {

  difference <- last - first


  switch(
    change_type,

    pp = paste0(
      ch6_sign_prefix(
        difference
      ),
      scales::number(
        difference *
          100,
        accuracy = 0.1
      ),
      " pp"
    ),

    count_delta = paste0(
      ch6_sign_prefix(
        difference
      ),
      scales::comma(
        difference,
        accuracy = 1
      )
    ),

    percent = paste0(
      ch6_sign_prefix(
        (
          last /
            first
        ) - 1
      ),
      scales::percent(
        (
          last /
            first
        ) - 1,
        accuracy = 0.1
      )
    ),

    multiple = paste0(
      scales::number(
        last /
          first,
        accuracy = 0.1
      ),
      "×"
    ),

    currency_delta = paste0(
      ch6_sign_prefix(
        difference
      ),
      "$",
      scales::number(
        abs(
          difference
        ) /
          1e9,
        accuracy = 0.1
      ),
      "B"
    ),

    stop(
      "Unknown Chapter 6 change type: ",
      change_type
    )
  )
}


