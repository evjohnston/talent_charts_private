ch4_sign_prefix <- function(value) {

  if (value > 0) {
    "+"
  } else {
    ""
  }
}


ch4_format_value <- function(
    value,
    value_type
) {

  switch(
    value_type,

    count = scales::comma(
      value,
      accuracy = 1
    ),

    signed_count = paste0(
      ch4_sign_prefix(value),
      scales::comma(
        value,
        accuracy = 1
      )
    ),

    percent_value = paste0(
      scales::number(
        value,
        accuracy = 0.1
      ),
      "%"
    ),

    score = scales::number(
      value,
      accuracy = 1
    ),

    signed_score = paste0(
      ch4_sign_prefix(value),
      scales::number(
        value,
        accuracy = 0.1
      )
    ),

    currency = scales::dollar(
      value,
      accuracy = 1
    ),

    ratio = paste0(
      scales::number(
        value,
        accuracy = 0.01
      ),
      "×"
    ),

    stop(
      "Unknown value type: ",
      value_type
    )
  )
}


ch4_format_cell <- function(
    value,
    year_label,
    value_type
) {

  paste0(
    ch4_format_value(
      value,
      value_type
    ),
    " (",
    year_label,
    ")"
  )
}


ch4_format_change <- function(
    first,
    last,
    change_type
) {

  difference <- last - first


  switch(
    change_type,

    points = paste0(
      ch4_sign_prefix(difference),
      scales::number(
        difference,
        accuracy = 0.1
      ),
      " points"
    ),

    pp_percent = paste0(
      ch4_sign_prefix(difference),
      scales::number(
        difference,
        accuracy = 0.1
      ),
      " pp"
    ),

    percent = paste0(
      ch4_sign_prefix(
        (last / first) - 1
      ),
      scales::percent(
        (last / first) - 1,
        accuracy = 1
      )
    ),

    multiple = paste0(
      scales::number(
        last / first,
        accuracy = 0.1
      ),
      "×"
    ),

    count_delta = paste0(
      ch4_sign_prefix(difference),
      scales::comma(
        difference,
        accuracy = 1
      )
    ),

    ratio_gap = paste0(
      ch4_sign_prefix(difference),
      scales::number(
        difference,
        accuracy = 0.01
      ),
      "×"
    ),

    stop(
      "Unknown change type: ",
      change_type
    )
  )
}


