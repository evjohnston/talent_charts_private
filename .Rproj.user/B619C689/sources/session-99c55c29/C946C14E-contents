ch6_format_duration <- function(
    months,
    signed = FALSE
) {

  rounded_months <- round(
    abs(months)
  )


  years <- rounded_months %/% 12
  remaining_months <- rounded_months %% 12


  year_text <- if (years == 1) {

    "1 year"

  } else {

    paste0(
      years,
      " years"
    )
  }


  month_text <- if (remaining_months == 1) {

    "1 month"

  } else {

    paste0(
      remaining_months,
      " months"
    )
  }


  duration_text <- if (years == 0) {

    month_text

  } else if (remaining_months == 0) {

    year_text

  } else {

    paste(
      year_text,
      month_text
    )
  }


  prefix <- if (!signed) {

    ""

  } else if (months > 0) {

    "+"

  } else if (months < 0) {

    "-"

  } else {

    ""
  }


  paste0(
    prefix,
    duration_text
  )
}


