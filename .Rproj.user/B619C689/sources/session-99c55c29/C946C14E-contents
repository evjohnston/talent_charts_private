ch3_layout_for_rows <- function(n_rows) {

  if (n_rows <= 20) {

    list(
      data_font_px = 18,
      header_font_px = 17,
      chapter_font_px = 16,
      title_font_px = 29,
      subtitle_font_px = 17,
      group_font_px = 17,
      source_font_px = 14,
      initial_padding_px = 4
    )

  } else if (n_rows <= 28) {

    list(
      data_font_px = 16.5,
      header_font_px = 15.5,
      chapter_font_px = 15,
      title_font_px = 27,
      subtitle_font_px = 16,
      group_font_px = 15.5,
      source_font_px = 13,
      initial_padding_px = 2
    )

  } else if (n_rows <= 34) {

    list(
      data_font_px = 15,
      header_font_px = 14.5,
      chapter_font_px = 14,
      title_font_px = 25,
      subtitle_font_px = 15,
      group_font_px = 14.5,
      source_font_px = 12,
      initial_padding_px = 1
    )

  } else {

    list(
      data_font_px = 14,
      header_font_px = 13.5,
      chapter_font_px = 13,
      title_font_px = 23,
      subtitle_font_px = 14,
      group_font_px = 13.5,
      source_font_px = 11.5,
      initial_padding_px = 0.5
    )
  }
}


