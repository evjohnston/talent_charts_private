build_chapter3_table <- function(
    row_padding_px = CH3_INITIAL_ROW_PADDING_PX,
    font_scale = 1
) {

  data_font_px <- max(
    11.5,
    CH3_TABLE_LAYOUT$data_font_px *
      font_scale
  )

  header_font_px <- max(
    11.5,
    CH3_TABLE_LAYOUT$header_font_px *
      font_scale
  )

  chapter_font_px <- max(
    11.5,
    CH3_TABLE_LAYOUT$chapter_font_px *
      font_scale
  )

  title_font_px <- max(
    19,
    CH3_TABLE_LAYOUT$title_font_px *
      font_scale
  )

  subtitle_font_px <- max(
    11.5,
    CH3_TABLE_LAYOUT$subtitle_font_px *
      font_scale
  )

  group_font_px <- max(
    11.5,
    CH3_TABLE_LAYOUT$group_font_px *
      font_scale
  )

  source_font_px <- max(
    10,
    CH3_TABLE_LAYOUT$source_font_px *
      font_scale
  )


  ch3_table_data %>%
    gt(
      rowname_col = "Measure",
      groupname_col = "Section",
      id = "chapter3_numbers"
    ) %>%

    tab_stubhead(
      label = "Measure"
    ) %>%

    cols_label(
      Earlier = "Earlier",
      Latest = "Latest",
      Change = "Change"
    ) %>%

    cols_align(
      align = "center",
      columns = c(
        Earlier,
        Latest,
        Change
      )
    ) %>%

    cols_hide(
      columns = c(
        StatID,
        SectionID,
        Emphasis,
        RowOrder
      )
    ) %>%

    theme_gt_tpa() %>%

    tab_header(
      title = html(
        paste0(
          "<span class='ch3-kicker'>",
          "CHAPTER 3",
          "</span>",
          "<br>",
          "<span class='ch3-main-title'>",
          "FROM CAMPUS TO WORK",
          "</span>"
        )
      ),

      subtitle = html(
        paste0(
          "<span class='ch3-subtitle'>",
          "How international talent powers American research and industry",
          "</span>",
          "<br>",
          "<span class='ch3-panel-label'>",
          "CHANGE OVER TIME",
          "</span>"
        )
      )
    ) %>%

    tab_source_note(
      source_note = md(
        paste0(
          "**Note:** Open Doors academic-year values are labeled by the year ",
          "in which the academic year ended. OPT participants, temporary visa ",
          "holders, and foreign-born workers are distinct categories."
        )
      )
    ) %>%

    tab_source_note(
      source_note = md(
        paste0(
          "**Source:** See the Chapter 3 figures and tables ",
          "for full citations."
        )
      )
    ) %>%

    tab_style(
      style = cell_text(
        align = "left"
      ),
      locations = cells_stub(
        rows = TRUE
      )
    ) %>%

    tab_style(
      style = list(
        cell_fill(
          color = CH3_GRAY
        ),

        cell_text(
          color = "white",
          weight = "bold"
        )
      ),
      locations = cells_column_labels(
        everything()
      )
    ) %>%

    tab_style(
      style = cell_borders(
        sides = "top",
        color = CH3_RED,
        weight = px(3)
      ),
      locations = cells_column_labels(
        everything()
      )
    ) %>%

    tab_style(
      style = list(
        cell_fill(
          color = CH3_TINT
        ),

        cell_text(
          color = CH3_RED,
          weight = "bold",
          transform = "uppercase"
        )
      ),
      locations = cells_row_groups()
    ) %>%

    tab_style(
      style = list(
        cell_fill(
          color = CH3_PINK
        ),

        cell_text(
          color = CH3_RED,
          weight = "bold"
        )
      ),
      locations = cells_body(
        columns = Latest
      )
    ) %>%

    tab_style(
      style = cell_text(
        weight = "bold"
      ),
      locations = list(
        cells_stub(
          rows = Emphasis
        ),

        cells_body(
          rows = Emphasis
        )
      )
    ) %>%

    tab_style(
      style = cell_text(
        color = CH3_MUTED
      ),
      locations = cells_source_notes()
    ) %>%

    tab_options(
      table.font.size = px(
        data_font_px
      ),

      table.font.color = CH3_TEXT,

      column_labels.font.size = px(
        header_font_px
      ),

      column_labels.padding = px(4),

      data_row.padding = px(
        row_padding_px
      ),

      heading.title.font.size = px(
        title_font_px
      ),

      heading.subtitle.font.size = px(
        subtitle_font_px
      ),

      heading.padding = px(7),
      heading.align = "left",

      source_notes.font.size = px(
        source_font_px
      ),

      source_notes.padding = px(3),

      table.background.color = "white",
      row.striping.background_color = "white",

      table_body.hlines.color = CH3_RULE,
      table_body.hlines.width = px(1),

      row_group.border.top.color = CH3_RULE,
      row_group.border.bottom.color = CH3_RULE,

      table.width = px(
        CH3_CSS_WIDTH_PX
      ),

      container.width = px(
        CH3_CSS_WIDTH_PX
      )
    ) %>%

    fixed_table_width(
      profile = "ultrawide",
      width_px = CH3_CSS_WIDTH_PX,
      stub_width_px = CH3_COL_MEASURE_PX
    ) %>%

    cols_width(
      stub()  ~ px(CH3_COL_MEASURE_PX),
