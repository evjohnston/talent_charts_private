# ============================================================================
# 14. EXPORT THE TABLE
# ============================================================================

export_chapter3_infographic <- function(
    name = "infographic_ch3_by_the_numbers",
    initial_row_padding_px = CH3_INITIAL_ROW_PADDING_PX,
    max_iterations = 10
) {

  if (!requireNamespace("magick", quietly = TRUE)) {

    stop(
      "The magick package is required for exact infographic export."
    )
  }


  output_dir <- "final_infographics"

  html_dir <- file.path(
    output_dir,
    "html"
  )

  png_dir <- file.path(
    output_dir,
    "pngs"
  )


  dir.create(
    html_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )

  dir.create(
    png_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )


  html_path <- file.path(
    html_dir,
    paste0(
      name,
      ".html"
    )
  )

  png_path <- file.path(
    png_dir,
    paste0(
      name,
      ".png"
    )
  )

  raw_path <- file.path(
    png_dir,
    paste0(
      name,
      "_raw.png"
    )
  )


  row_padding_px <- initial_row_padding_px
  font_scale <- 1


  for (iteration in seq_len(max_iterations)) {

    trial_table <- build_chapter3_table(
      row_padding_px = row_padding_px,
      font_scale = font_scale
    )


    gt::gtsave(
      trial_table,
      raw_path,
      vwidth = CH3_CSS_WIDTH_PX,
      vheight = CH3_CSS_HEIGHT_PX,
      zoom = CH3_EXPORT_ZOOM,
      expand = 0
    )


    trial_image <- magick::image_read(
      raw_path
    )

    trial_info <- magick::image_info(
      trial_image
    )


    if (
      trial_info$width[[1]] !=
        CH3_OUTPUT_WIDTH_PX
    ) {

      trial_image <- magick::image_resize(
        trial_image,
        paste0(
          CH3_OUTPUT_WIDTH_PX,
          "x"
        )
      )
    }


    trial_info <- magick::image_info(
      trial_image
    )


    height_difference_px <-
      CH3_OUTPUT_HEIGHT_PX -
      trial_info$height[[1]]


    if (abs(height_difference_px) <= 10) {
      break
    }


    padding_correction_px <-
      (
        height_difference_px /
        CH3_EXPORT_ZOOM
      ) /
      (
        2 *
          ch3_n_body_rows
      )


    proposed_padding_px <-
      row_padding_px +
      padding_correction_px


    if (
      height_difference_px < 0 &&
      proposed_padding_px < 0.25
    ) {

      row_padding_px <- 0.25

      proportional_scale <-
        CH3_OUTPUT_HEIGHT_PX /
        trial_info$height[[1]]

      font_scale <- max(
        0.60,
        font_scale *
          min(
            0.98,
            proportional_scale
          )
      )

    } else {

      row_padding_px <- max(
        0.25,
        min(
          30,
          proposed_padding_px
        )
      )
    }
  }


  final_table <- build_chapter3_table(
    row_padding_px = row_padding_px,
    font_scale = font_scale
  )


  gt::gtsave(
    final_table,
    html_path
  )


  gt::gtsave(
    final_table,
    raw_path,
    vwidth = CH3_CSS_WIDTH_PX,
    vheight = CH3_CSS_HEIGHT_PX,
    zoom = CH3_EXPORT_ZOOM,
    expand = 0
  )


  final_image <- magick::image_read(
    raw_path
  )

  final_info <- magick::image_info(
    final_image
  )


  # Normalize the rendered width.

  if (
    final_info$width[[1]] !=
      CH3_OUTPUT_WIDTH_PX
  ) {

    final_image <- magick::image_resize(
      final_image,
      paste0(
        CH3_OUTPUT_WIDTH_PX,
        "x"
      )
    )
  }


  final_info <- magick::image_info(
    final_image
  )


  # This should rarely be necessary because the loop adjusts typography.
  # Preserve aspect ratio rather than stretching the table.

  if (
    final_info$height[[1]] >
      CH3_OUTPUT_HEIGHT_PX
  ) {

    final_image <- magick::image_resize(
      final_image,
      paste0(
        "x",
        CH3_OUTPUT_HEIGHT_PX
      )
    )
  }


  # Place the rendered table on the exact output canvas.

  final_image <- magick::image_extent(
    final_image,
    geometry = paste0(
      CH3_OUTPUT_WIDTH_PX,
      "x",
      CH3_OUTPUT_HEIGHT_PX
    ),
    gravity = "north",
    color = "white"
  )


  magick::image_write(
    final_image,
    path = png_path,
    format = "png",
    density = paste0(
      CH3_OUTPUT_DPI,
      "x",
      CH3_OUTPUT_DPI
    )
  )


  final_info <- magick::image_info(
    magick::image_read(
      png_path
    )
  )


  if (
    final_info$width[[1]] !=
      CH3_OUTPUT_WIDTH_PX ||
    final_info$height[[1]] !=
      CH3_OUTPUT_HEIGHT_PX
  ) {

    stop(
      "Final Chapter 3 PNG is ",
      final_info$width[[1]],
      " × ",
      final_info$height[[1]],
      " pixels; expected ",
      CH3_OUTPUT_WIDTH_PX,
      " × ",
      CH3_OUTPUT_HEIGHT_PX,
      "."
    )
  }


  if (file.exists(raw_path)) {
    unlink(
      raw_path
    )
  }


  message(
    "Saved ",
    png_path,
    " at ",
    final_info$width[[1]],
    " × ",
    final_info$height[[1]],
    " pixels. Included rows: ",
    ch3_n_body_rows,
    ". Final row padding: ",
    round(
      row_padding_px,
      2
    ),
    " CSS px. Font scale: ",
    round(
      font_scale,
      3
    ),
    "."
  )


  invisible(
    list(
      table = final_table,
      html_path = html_path,
      png_path = png_path,
      width_px = final_info$width[[1]],
      height_px = final_info$height[[1]],
      row_padding_px = row_padding_px,
      font_scale = font_scale,
      included_statistics = ch3_n_body_rows
    )
  )
}


