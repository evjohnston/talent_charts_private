export_chapter4_infographic <- function(
    name =
      "infographic_ch4_by_the_numbers",

    initial_row_padding_px =
      CH4_INITIAL_ROW_PADDING_PX,

    max_iterations = 12
) {

  if (!requireNamespace("magick", quietly = TRUE)) {

    stop(
      "The magick package is required for exact infographic export."
    )
  }


  output_dir <- "final_infographics"

  html_dir <- file.path(
    output_dir,
    "html"
  )

  png_dir <- file.path(
    output_dir,
    "pngs"
  )


  dir.create(
    html_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )

  dir.create(
    png_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )


  html_path <- file.path(
    html_dir,
    paste0(
      name,
      ".html"
    )
  )


  png_path <- file.path(
    png_dir,
    paste0(
      name,
      ".png"
    )
  )


  raw_path <- file.path(
    png_dir,
    paste0(
      name,
      "_raw.png"
    )
  )


  row_padding_px <- initial_row_padding_px
  font_scale <- 1


  # -------------------------------------------------------------------------
  # Fit the one continuous table to the output canvas.
  # -------------------------------------------------------------------------

  for (iteration in seq_len(max_iterations)) {

    trial_table <- build_chapter4_table(
      row_padding_px = row_padding_px,
      font_scale = font_scale
    )


    gt::gtsave(
      trial_table,
      raw_path,
      vwidth = CH4_CSS_WIDTH_PX,
      vheight = max(
        CH4_CSS_HEIGHT_PX,
        2400
      ),
      zoom = CH4_EXPORT_ZOOM,
      expand = 0
    )


    trial_image <- magick::image_read(
      raw_path
    )


    trial_info <- magick::image_info(
      trial_image
    )


    if (
      trial_info$width[[1]] !=
        CH4_OUTPUT_WIDTH_PX
    ) {

      trial_image <- magick::image_resize(
        trial_image,
        paste0(
          CH4_OUTPUT_WIDTH_PX,
          "x"
        )
      )
    }


    trial_info <- magick::image_info(
      trial_image
    )


    height_difference_px <-
      CH4_OUTPUT_HEIGHT_PX -
      trial_info$height[[1]]


    if (abs(height_difference_px) <= 10) {
      break
    }


    padding_correction_px <-
      (
        height_difference_px /
          CH4_EXPORT_ZOOM
      ) /
      (
        2 *
          ch4_n_body_rows
      )


    proposed_padding_px <-
      row_padding_px +
      padding_correction_px


    if (
      height_difference_px < 0 &&
      proposed_padding_px < 0.1
    ) {

      row_padding_px <- 0.1


      proportional_scale <-
        CH4_OUTPUT_HEIGHT_PX /
        trial_info$height[[1]]


      font_scale <- max(
        0.68,
        font_scale *
          min(
            0.985,
            proportional_scale
          )
      )

    } else {

      row_padding_px <- max(
        0.1,
        min(
          20,
          proposed_padding_px
        )
      )
    }
  }


  # -------------------------------------------------------------------------
  # Build and save the final table.
  # -------------------------------------------------------------------------

  final_table <- build_chapter4_table(
    row_padding_px = row_padding_px,
    font_scale = font_scale
  )


  gt::gtsave(
    final_table,
    html_path
  )


  gt::gtsave(
    final_table,
    raw_path,
    vwidth = CH4_CSS_WIDTH_PX,
    vheight = max(
      CH4_CSS_HEIGHT_PX,
      2400
    ),
    zoom = CH4_EXPORT_ZOOM,
    expand = 0
  )


  final_image <- magick::image_read(
    raw_path
  )


  final_info <- magick::image_info(
    final_image
  )


  # Normalize the width while preserving the aspect ratio.

  if (
    final_info$width[[1]] !=
      CH4_OUTPUT_WIDTH_PX
  ) {

    final_image <- magick::image_resize(
      final_image,
      paste0(
        CH4_OUTPUT_WIDTH_PX,
        "x"
      )
    )
  }


  final_info <- magick::image_info(
    final_image
  )


  # Last-resort proportional fit.
  # The table is never cropped or stretched.

  if (
    final_info$height[[1]] >
      CH4_OUTPUT_HEIGHT_PX
  ) {

    final_image <- magick::image_resize(
      final_image,
      paste0(
        "x",
        CH4_OUTPUT_HEIGHT_PX
      )
    )
  }


  # Place the single table on the exact output canvas.

  final_image <- magick::image_extent(
    final_image,
    geometry = paste0(
      CH4_OUTPUT_WIDTH_PX,
      "x",
      CH4_OUTPUT_HEIGHT_PX
    ),
    gravity = "north",
    color = "white"
  )


  magick::image_write(
    final_image,
    path = png_path,
    format = "png",
    density = paste0(
      CH4_OUTPUT_DPI,
      "x",
      CH4_OUTPUT_DPI
    )
  )


  final_info <- magick::image_info(
    magick::image_read(
      png_path
    )
  )


  if (
    final_info$width[[1]] !=
      CH4_OUTPUT_WIDTH_PX ||
    final_info$height[[1]] !=
      CH4_OUTPUT_HEIGHT_PX
  ) {

    stop(
      "Final Chapter 4 PNG is ",
      final_info$width[[1]],
      " × ",
      final_info$height[[1]],
      " pixels; expected ",
      CH4_OUTPUT_WIDTH_PX,
      " × ",
      CH4_OUTPUT_HEIGHT_PX,
      "."
    )
  }


  if (file.exists(raw_path)) {

    unlink(
      raw_path
    )
  }


  message(
    "Saved one Chapter 4 infographic to ",
    png_path,
    " at ",
    final_info$width[[1]],
    " × ",
    final_info$height[[1]],
    " pixels. Included rows: ",
    ch4_n_body_rows,
    ". Final row padding: ",
    round(
      row_padding_px,
      2
    ),
    " CSS px. Font scale: ",
    round(
      font_scale,
      3
    ),
    "."
  )


  invisible(
    list(
      table =
        final_table,

      html_path =
        html_path,

      png_path =
        png_path,

      width_px =
        final_info$width[[1]],

      height_px =
        final_info$height[[1]],

      row_padding_px =
        row_padding_px,

      font_scale =
        font_scale,

      included_statistics =
        ch4_n_body_rows
    )
  )
}


# ============================================================================
# 17. EXPORT AND DISPLAY
# ============================================================================

chapter4_infographic_export <-
  export_chapter4_infographic()


knitr::include_graphics(
  chapter4_infographic_export$png_path
)
