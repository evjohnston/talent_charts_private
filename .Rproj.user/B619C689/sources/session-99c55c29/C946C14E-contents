ch5_numeric <- function(x) {

  suppressWarnings(
    as.numeric(
      gsub(
        pattern = "[,$%]",
        replacement = "",
        x = as.character(x)
      )
    )
  )
}


ch5_normalize_label <- function(x) {

  tolower(
    trimws(
      gsub(
        pattern = "\\*",
        replacement = "",
        x = as.character(x)
      )
    )
  )
}


ch5_wide_value <- function(
    df,
    year,
    column,
    year_column = "Year"
) {

  if (!year_column %in% names(df)) {

    stop(
      "Year column `",
      year_column,
      "` was not found."
    )
  }


  if (!column %in% names(df)) {

    stop(
      "Column `",
      column,
      "` was not found."
    )
  }


  matching_values <- df %>%
    filter(
      as.character(
        .data[[year_column]]
      ) ==
        as.character(
          .env$year
        )
    ) %>%
    pull(
      all_of(column)
    ) %>%
    ch5_numeric()


  if (
    length(matching_values) != 1 ||
    is.na(matching_values[[1]])
  ) {

    stop(
      "Expected one nonmissing value for `",
      column,
      "` in ",
      year,
      "."
    )
  }


  matching_values[[1]]
}


ch5_long_value <- function(
    df,
    year,
    country,
    category_column,
    category,
    value_column
) {

  required_columns <- c(
    "Year",
    "Country",
    category_column,
    value_column
  )


  missing_columns <- setdiff(
    required_columns,
    names(df)
  )


  if (length(missing_columns) > 0) {

    stop(
      "Missing required columns: ",
      paste(
        missing_columns,
        collapse = ", "
      ),
      "."
    )
  }


  matching_values <- df %>%
    filter(
      as.character(
        .data$Year
      ) ==
        as.character(
          .env$year
        ),

      ch5_normalize_label(
        .data$Country
      ) ==
        ch5_normalize_label(
          .env$country
        ),

      ch5_normalize_label(
        .data[[category_column]]
      ) ==
        ch5_normalize_label(
          .env$category
        )
    ) %>%
    pull(
      all_of(value_column)
    ) %>%
    ch5_numeric()


  if (
    length(matching_values) != 1 ||
    is.na(matching_values[[1]])
  ) {

    stop(
      "Expected one value for ",
      country,
      ", ",
      category,
      ", ",
      year,
      "."
    )
  }


  matching_values[[1]]
}


ch5_company_value <- function(
    company,
    column
) {

  if (!column %in% names(ch5_tab506)) {

    stop(
      "Column `",
      column,
      "` was not found in TAB506."
    )
  }


  matching_values <- ch5_tab506 %>%
    filter(
      ch5_normalize_label(
        .data$Company
      ) ==
        ch5_normalize_label(
          .env$company
        )
    ) %>%
    pull(
      all_of(column)
    ) %>%
    ch5_numeric()


  if (
    length(matching_values) != 1 ||
    is.na(matching_values[[1]])
  ) {

    stop(
      "Expected one TAB506 value for ",
      company,
      " in `",
      column,
      "`."
    )
  }


  matching_values[[1]]
}


# ============================================================================
# 6. CONFERENCE-SUMMARY HELPERS
#
# Each conference has a different coverage window. The conference-summary
# rows compare each venue's first common U.S.–China observation with its
# latest common observation.
# ============================================================================

ch5_conference_common <- ch5_tab501 %>%
  filter(
    .data$country %in%
      c(
        "United States",
        "China"
      )
  ) %>%

  group_by(
    conf_norm,
    conference,
    year,
    country
  ) %>%

  summarise(
    share = sum(
      share,
      na.rm = TRUE
    ),
    .groups = "drop"
  ) %>%

  tidyr::pivot_wider(
    names_from = country,
    values_from = share
  ) %>%

  filter(
    !is.na(
      .data[[
        "United States"
      ]]
    ),

    !is.na(
      .data$China
    )
  ) %>%

  arrange(
    conf_norm,
    year
  )


ch5_conference_windows <- ch5_conference_common %>%
  group_by(
    conf_norm
  ) %>%

  arrange(
    year,
    .by_group = TRUE
  ) %>%

  summarise(
    FirstYear = first(
      year
    ),

    LatestYear = last(
      year
    ),

    USFirst = first(
      .data[[
        "United States"
      ]]
    ),

    USLatest = last(
      .data[[
        "United States"
      ]]
    ),

    ChinaFirst = first(
      China
    ),

    ChinaLatest = last(
      China
    ),

    .groups = "drop"
  )


CH5_N_CONFERENCES <- nrow(
  ch5_conference_windows
)


if (CH5_N_CONFERENCES != 20) {

  warning(
    "TAB501 produced ",
    CH5_N_CONFERENCES,
    " conference windows rather than the expected 20."
  )
}


ch5_conference_median_us_first <- median(
  ch5_conference_windows$USFirst,
  na.rm = TRUE
)

ch5_conference_median_us_latest <- median(
  ch5_conference_windows$USLatest,
  na.rm = TRUE
)

ch5_conference_median_china_first <- median(
  ch5_conference_windows$ChinaFirst,
  na.rm = TRUE
)

ch5_conference_median_china_latest <- median(
  ch5_conference_windows$ChinaLatest,
