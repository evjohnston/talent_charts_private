      Latest  ~ px(CH3_COL_LATEST_PX),
      Change  ~ px(CH3_COL_CHANGE_PX)
    ) %>%

    opt_css(
      css = paste0(
        "#chapter3_numbers .ch3-kicker {",
        "color:", CH3_RED, ";",
        "font-size:", chapter_font_px, "px;",
        "font-weight:700;",
        "letter-spacing:1.5px;",
        "line-height:1.0;",
        "}",

        "#chapter3_numbers .ch3-main-title {",
        "color:", CH3_TEXT, ";",
        "font-size:", title_font_px, "px;",
        "font-weight:700;",
        "line-height:1.02;",
        "}",

        "#chapter3_numbers .ch3-subtitle {",
        "color:", CH3_MUTED, ";",
        "font-size:", subtitle_font_px, "px;",
        "line-height:1.1;",
        "}",

        "#chapter3_numbers .ch3-panel-label {",
        "color:", CH3_RED, ";",
        "font-size:", group_font_px, "px;",
        "font-weight:700;",
        "letter-spacing:1px;",
        "line-height:1.5;",
        "}",

        "#chapter3_numbers .gt_heading {",
        "padding-left:8px !important;",
