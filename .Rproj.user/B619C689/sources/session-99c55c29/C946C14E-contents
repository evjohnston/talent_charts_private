ch2_format_value <- function(
    value,
    value_type
) {

  switch(
    value_type,

    count = scales::comma(
      value,
      accuracy = 1
    ),

    share = scales::percent(
      value,
      accuracy = 0.1
    ),

    percent_value = paste0(
      scales::number(
        value,
        accuracy = 0.1
      ),
      "%"
    ),

    currency_billions = paste0(
      "$",
      scales::number(
        value / 1e9,
        accuracy = 0.1
      ),
      "B"
    ),

    ratio = paste0(
      scales::number(
        value,
        accuracy = 0.1
      ),
      ":1"
    ),

    stop(
      "Unknown value type: ",
      value_type
    )
  )
}


ch2_format_cell <- function(
    value,
    year_label,
    value_type
) {

  paste0(
    ch2_format_value(
      value,
      value_type
    ),
    " (",
    as.character(year_label),
    ")"
  )
}


ch2_format_change <- function(
    first,
    last,
    change_type
) {

  positive_prefix <- ifelse(
    last >= first,
    "+",
    ""
  )

  switch(
    change_type,

    multiple = paste0(
      scales::number(
        last / first,
        accuracy = 0.1
      ),
      "×"
    ),

    percent = paste0(
      positive_prefix,
      scales::percent(
        (last / first) - 1,
        accuracy = 1
      )
    ),

    pp_share = paste0(
      positive_prefix,
      scales::number(
        (last - first) * 100,
        accuracy = 0.1
      ),
      " pp"
    ),

    pp_percent = paste0(
      positive_prefix,
      scales::number(
        last - first,
        accuracy = 0.1
      ),
      " pp"
    ),

    stop(
      "Unknown change type: ",
      change_type
    )
  )
}


ch2_format_snapshot_change <- function(value) {

  paste0(
    ifelse(
      value > 0,
      "+",
      ""
    ),
    scales::number(
      value,
      accuracy = 1
    ),
    "%"
  )
}


