ch4_mobility_specs <- tribble(
  ~Indicator,
  ~Measure,
  ~GapMeasure,
  ~ValueType,
  ~CountryChangeType,
  ~GapValueType,
  ~GapChangeType,

  "inbound_count",
  "Inbound internationally mobile students",
  "Inbound students",
  "count",
  "percent",
  "signed_count",
  "count_delta",

  "outbound_count",
  "Outbound internationally mobile students",
  "Outbound students",
  "count",
  "percent",
  "signed_count",
  "count_delta",

  "net_flow",
  "Net flow of internationally mobile students",
  "Net student flow",
  "signed_count",
  "count_delta",
  "signed_count",
  "count_delta"
) %>%
  mutate(
    IndicatorOrder = row_number()
  )


ch4_build_country_mobility_row <- function(
    indicator,
    country
) {

  specification <- ch4_mobility_specs %>%
    filter(
      .data$Indicator ==
        .env$indicator
    )


  if (nrow(specification) != 1) {

    stop(
      "Expected one mobility specification for ",
      indicator,
      "."
    )
  }


  series <- ch4_mobility_series(
    indicator,
    country
  )


  first_row <- series %>%
    slice_head(
      n = 1
    )


  last_row <- series %>%
    slice_tail(
      n = 1
    )


  country_prefix <- ifelse(
    country == "United States",
    "us_",
    "china_"
  )


  section_id <- ifelse(
    country == "United States",
    "mobility_us",
    "mobility_china"
  )


  section_label <- ifelse(
    country == "United States",
    "United States: international student mobility",
    "China: international student mobility"
  )


  ch4_make_metric(
    stat_id = paste0(
      country_prefix,
      indicator
    ),

    section_id = section_id,
    section_label = section_label,

    measure =
      specification$Measure[[1]],

    first =
      first_row$Value[[1]],

    first_year =
      first_row$Year[[1]],

    last =
      last_row$Value[[1]],

    last_year =
      last_row$Year[[1]],

    value_type =
      specification$ValueType[[1]],

    change_type =
      specification$CountryChangeType[[1]],

    emphasis =
      indicator %in%
        c(
          "inbound_count",
          "net_flow"
        )
  )
}


ch4_build_gap_mobility_row <- function(indicator) {

  specification <- ch4_mobility_specs %>%
    filter(
      .data$Indicator ==
        .env$indicator
    )


  if (nrow(specification) != 1) {

    stop(
      "Expected one mobility specification for ",
      indicator,
      "."
    )
  }


  common_years <- ch4_mobility_common_years(
    indicator
  )


  first_year <- min(
    common_years
  )


  last_year <- max(
    common_years
  )


  ch4_make_metric(
    stat_id = paste0(
      "gap_",
      indicator
    ),

    section_id = "mobility_gaps",

    section_label =
      "U.S.–China differences over time (U.S. minus China)",

    measure =
      specification$GapMeasure[[1]],

    first = ch4_mobility_gap(
      indicator,
      first_year
    ),

    first_year =
      first_year,

    last = ch4_mobility_gap(
      indicator,
      last_year
    ),

    last_year =
      last_year,

    value_type =
      specification$GapValueType[[1]],

    change_type =
      specification$GapChangeType[[1]],

    emphasis = TRUE
  )
}


