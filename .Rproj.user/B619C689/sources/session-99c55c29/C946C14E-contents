)


# ============================================================================
# 12. DYNAMIC TYPOGRAPHY
# ============================================================================

ch5_layout_for_rows <- function(n_rows) {

  if (n_rows <= 24) {

    list(
      data_font_px = 17,
      header_font_px = 16,
      chapter_font_px = 15,
      title_font_px = 28,
      subtitle_font_px = 16,
      panel_font_px = 15,
      group_font_px = 15.5,
      source_font_px = 12,
      initial_padding_px = 3
    )

  } else if (n_rows <= 32) {

    list(
      data_font_px = 15,
      header_font_px = 14.5,
      chapter_font_px = 14,
      title_font_px = 26,
      subtitle_font_px = 15,
      panel_font_px = 14,
      group_font_px = 14,
      source_font_px = 11,
      initial_padding_px = 1.5
    )

  } else if (n_rows <= 40) {

    list(
      data_font_px = 13,
      header_font_px = 12.75,
      chapter_font_px = 12.75,
      title_font_px = 24,
      subtitle_font_px = 13.5,
      panel_font_px = 12.75,
      group_font_px = 12.75,
      source_font_px = 10.25,
      initial_padding_px = 0.5
    )

  } else {

    list(
      data_font_px = 12,
      header_font_px = 11.75,
      chapter_font_px = 12,
      title_font_px = 23,
      subtitle_font_px = 12.75,
      panel_font_px = 12,
      group_font_px = 12,
      source_font_px = 9.75,
      initial_padding_px = 0.25
    )
  }
}


CH5_TABLE_LAYOUT <- ch5_layout_for_rows(
