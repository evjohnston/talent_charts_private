ch3_h1b_total <- function(year) {

  year_column <- as.character(
    year
  )

  if (!year_column %in% names(ch3_fig302)) {

    stop(
      "H-1B column `",
      year_column,
      "` was not found in FIG302."
    )
  }

  out <- ch3_fig302 %>%
    filter(
      trimws(
        as.character(
          .data$Company
        )
      ) ==
        "Grand Total"
    ) %>%
    pull(
      all_of(year_column)
    )

  out <- suppressWarnings(
    as.numeric(out)
  )

  if (
    length(out) != 1 ||
    is.na(out[[1]])
  ) {

    stop(
      "Could not determine the H-1B total for ",
      year,
      "."
    )
  }

  out[[1]]
}


ch3_h1b_company_share <- function(
    company,
    year
) {

  year_column <- as.character(
    year
  )

  count <- ch3_fig302 %>%
    filter(
      trimws(
        as.character(
          .data$Company
        )
      ) ==
        trimws(
          as.character(
            .env$company
          )
        )
    ) %>%
    pull(
      all_of(year_column)
    )

  count <- suppressWarnings(
    as.numeric(count)
  )

  if (length(count) == 0) {
    count <- 0
  }

  count <- sum(
    count,
    na.rm = TRUE
  )

  count /
    ch3_h1b_total(year)
}


ch3_h1b_top_n_share <- function(
    year,
    n = 10
) {

  year_column <- as.character(
    year
  )

  counts <- ch3_fig302 %>%
    filter(
      trimws(
        as.character(
          .data$Company
        )
      ) !=
        "Grand Total"
    ) %>%
    pull(
      all_of(year_column)
    )

  counts <- suppressWarnings(
    as.numeric(counts)
  )

  counts <- counts[
    is.finite(counts)
  ]

  counts <- sort(
    counts,
    decreasing = TRUE
  )

  sum(
    head(
      counts,
      n
    )
  ) /
    ch3_h1b_total(year)
}


