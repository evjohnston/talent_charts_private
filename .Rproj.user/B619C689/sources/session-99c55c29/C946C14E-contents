ch3_format_value <- function(
    value,
    value_type
) {

  switch(
    value_type,

    count = scales::comma(
      value,
      accuracy = 1
    ),

    share = scales::percent(
      value,
      accuracy = 0.1
    ),

    percent_value = paste0(
      scales::number(
        value,
        accuracy = 0.1
      ),
      "%"
    ),

    ratio = paste0(
      scales::number(
        value,
        accuracy = 0.1
      ),
      ":1"
    ),

    stop(
      "Unknown value type: ",
      value_type
    )
  )
}


ch3_format_cell <- function(
    value,
    year_label,
    value_type
) {

  paste0(
    ch3_format_value(
      value,
      value_type
    ),
    " (",
    as.character(year_label),
    ")"
  )
}


ch3_format_change <- function(
    first,
    last,
    change_type
) {

  positive_prefix <- ifelse(
    last >= first,
    "+",
    ""
  )

  switch(
    change_type,

    multiple = paste0(
      scales::number(
        last / first,
        accuracy = 0.1
      ),
      "×"
    ),

    percent = paste0(
      positive_prefix,
      scales::percent(
        (last / first) - 1,
        accuracy = 1
      )
    ),

    pp_share = paste0(
      positive_prefix,
      scales::number(
        (last - first) * 100,
        accuracy = 0.1
      ),
      " pp"
    ),

    pp_percent = paste0(
      positive_prefix,
      scales::number(
        last - first,
        accuracy = 0.1
      ),
      " pp"
    ),

    stop(
      "Unknown change type: ",
      change_type
    )
  )
}


# ============================================================================
# 8. ROW-BUILDING HELPER
# ============================================================================

ch3_make_metric <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    first,
    first_year,
    last,
    last_year,
    value_type,
    change_type,
    emphasis = FALSE
) {

  if (
    !ch3_stat_enabled(
      stat_id,
      section_id
    )
  ) {

    return(NULL)
  }

  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,

    Earlier = ch3_format_cell(
      value = first,
      year_label = first_year,
      value_type = value_type
    ),

    Latest = ch3_format_cell(
      value = last,
      year_label = last_year,
      value_type = value_type
    ),

    Change = ch3_format_change(
      first = first,
      last = last,
      change_type = change_type
    ),

    Emphasis = emphasis
  )
}


