      2
    ),
    " CSS px. Font scale: ",
    round(
      font_scale,
      3
    ),
    "."
  )


  invisible(
    list(
      table = final_table,
      html_path = html_path,
      png_path = png_path,
      width_px = final_info$width[[1]],
      height_px = final_info$height[[1]],
      row_padding_px = row_padding_px,
      font_scale = font_scale,
      included_statistics = ch2_n_body_rows
    )
  )
