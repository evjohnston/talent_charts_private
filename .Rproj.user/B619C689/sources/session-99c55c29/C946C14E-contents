stat_enabled <- function(
    stat_id,
    section_id
) {

  section_is_on <-
    section_id %in% names(INCLUDE_SECTIONS) &&
    isTRUE(
      INCLUDE_SECTIONS[[section_id]]
    )

  stat_is_on <-
    isTRUE(INCLUDE_ALL_STATS) ||
    (
      stat_id %in% names(INCLUDE_STATS) &&
      isTRUE(
        INCLUDE_STATS[[stat_id]]
      )
    )

  section_is_on &&
    stat_is_on
}


stat_emphasized <- function(stat_id) {

  stat_id %in% names(EMPHASIZE_STATS) &&
    isTRUE(
      EMPHASIZE_STATS[[stat_id]]
    )
}


