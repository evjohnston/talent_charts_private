ch3_value_at <- function(
    df,
    year,
    column
) {

  if (!"Year" %in% names(df)) {

    stop(
      "The supplied data frame does not contain a `Year` column."
    )
  }

  if (!column %in% names(df)) {

    stop(
      "Column `",
      column,
      "` was not found."
    )
  }

  out <- df %>%
    filter(
      .data$Year ==
        .env$year
    ) %>%
    pull(
      all_of(column)
    )

  out <- suppressWarnings(
    as.numeric(out)
  )

  if (
    length(out) != 1 ||
    is.na(out[[1]])
  ) {

    stop(
      "Expected one nonmissing value for `",
      column,
      "` in ",
      year,
      "."
    )
  }

  out[[1]]
}


ch3_ffrdc_share <- function(year) {

  temporary <- ch3_value_at(
    ch3_fig208,
    year,
    "Temporary visa holders"
