make_metric_from_endpoints <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    endpoints,
    value_type,
    change_type,
    year_labeler = calendar_year_label,
    projected = FALSE
) {

  if (
    !stat_enabled(
      stat_id,
      section_id
    )
  ) {

    return(NULL)
  }


  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,

    Earlier = format_cell(
      value = endpoints$first_value[[1]],

      year_label = year_labeler(
        endpoints$first_year[[1]]
      ),

      value_type = value_type,
      projected = FALSE
    ),

    Latest = format_cell(
      value = endpoints$last_value[[1]],

      year_label = year_labeler(
        endpoints$last_year[[1]]
      ),

      value_type = value_type,
      projected = projected
    ),

    Change = format_change(
      first = endpoints$first_value[[1]],
      last = endpoints$last_value[[1]],
      change_type = change_type
    ),

    Emphasis = stat_emphasized(
      stat_id
    )
  )
}


make_series_metric <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    df,
    column,
    value_type,
    change_type,
    year_column = "Year",
    year_labeler = calendar_year_label
) {

  make_metric_from_endpoints(
    stat_id = stat_id,
    section_id = section_id,
    section_label = section_label,
    measure = measure,

    endpoints = series_endpoints(
      df = df,
      column = column,
      year_column = year_column
    ),

    value_type = value_type,
    change_type = change_type,
    year_labeler = year_labeler,
    projected = FALSE
  )
}


make_projection_metric <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    df,
    observed_column,
    projected_column,
    value_type,
    change_type,
    year_column = "Year"
) {

  make_metric_from_endpoints(
    stat_id = stat_id,
    section_id = section_id,
    section_label = section_label,
    measure = measure,

    endpoints = projection_endpoints(
      df = df,
