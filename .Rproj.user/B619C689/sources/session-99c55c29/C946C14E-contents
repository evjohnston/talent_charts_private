# 9. ROW-BUILDING HELPERS
# ============================================================================

ch6_make_metric <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    first,
    first_label,
    last,
    last_label,
    value_type,
    change_type,
    emphasis = FALSE
) {

  if (
    !ch6_stat_enabled(
      stat_id,
      section_id
    )
  ) {

    return(NULL)
  }


  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,

    Earlier = ch6_format_cell(
      value = first,
      label = first_label,
      value_type = value_type
    ),

    Latest = ch6_format_cell(
      value = last,
      label = last_label,
      value_type = value_type
    ),

    Change = ch6_format_change(
      first = first,
      last = last,
      change_type = change_type
    ),

    Emphasis = emphasis
  )
}


ch6_make_display_row <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    earlier,
    latest,
    change,
    emphasis = FALSE
) {

  if (
    !ch6_stat_enabled(
      stat_id,
      section_id
    )
  ) {

    return(NULL)
  }


  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,
    Earlier = earlier,
    Latest = latest,
    Change = change,
    Emphasis = emphasis
  )
}


ch6_make_wait_row <- function(
    stat_id,
    measure,
    df,
    category,
    first_year = 2006,
    last_year = 2025,
    emphasis = FALSE
) {

  first_months <- ch6_wait_months(
    df,
    first_year,
    category
  )


  last_months <- ch6_wait_months(
    df,
    last_year,
    category
  )


  ch6_make_display_row(
    stat_id = stat_id,
    section_id = "permanence",
    section_label = "Permanent residence becomes the bottleneck",
    measure = measure,

    earlier = paste0(
      ch6_wait_text(
        df,
        first_year,
        category
      ),
      " (",
      first_year,
      ")"
    ),

    latest = paste0(
      ch6_wait_text(
        df,
        last_year,
        category
      ),
      " (",
      last_year,
      ")"
    ),

    change = ch6_format_duration(
      last_months -
        first_months,
      signed = TRUE
    ),

    emphasis = emphasis
  )
}


ch6_make_loss_row <- function(
    stat_id,
    field,
    label,
    emphasis = FALSE
) {

  trained <- ch6_field_value(
    field,
    "recipients"
  )


  retained <- ch6_field_value(
    field,
    "retained"
  )


  lost <- ch6_field_value(
    field,
    "lost"
  )


  ch6_make_display_row(
    stat_id = stat_id,
    section_id = "losses",
    section_label = "International STEM PhD cohort outcomes",
    measure = label,

    earlier = paste0(
      scales::comma(
        trained,
        accuracy = 1
      ),
      " trained"
    ),

    latest = paste0(
      scales::comma(
        retained,
        accuracy = 1
      ),
      " retained"
    ),

    change = paste0(
      "-",
      scales::comma(
        lost,
        accuracy = 1
      ),
      " lost"
    ),

    emphasis = emphasis
  )
}


