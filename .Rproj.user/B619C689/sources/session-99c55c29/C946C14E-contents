ch4_numeric <- function(x) {

  suppressWarnings(
    as.numeric(
      gsub(
        pattern = "[,$%]",
        replacement = "",
        x = as.character(x)
      )
    )
  )
}


ch4_normalize_label <- function(x) {

  tolower(
    trimws(
      gsub(
        pattern = "\\*",
        replacement = "",
        x = as.character(x)
      )
    )
  )
}


ch4_value_at <- function(
    df,
    year,
    column,
    year_column = "Year"
) {

  if (!year_column %in% names(df)) {

    stop(
      "Year column `",
      year_column,
      "` was not found."
    )
  }


  if (!column %in% names(df)) {

    stop(
      "Column `",
      column,
      "` was not found."
    )
  }


  matching_values <- df[
    as.character(
      df[[year_column]]
    ) ==
      as.character(year),
    column,
    drop = TRUE
  ]


  matching_values <- ch4_numeric(
    matching_values
  )


  if (
    length(matching_values) != 1 ||
    is.na(matching_values[[1]])
  ) {

    stop(
      "Expected one nonmissing value for `",
      column,
      "` in ",
      year,
      "."
    )
  }


  matching_values[[1]]
}


ch4_category_value <- function(
    df,
    category_column,
    category,
    value_column
) {

  if (!category_column %in% names(df)) {

    stop(
      "Category column `",
      category_column,
      "` was not found."
    )
  }


  if (!value_column %in% names(df)) {

    stop(
      "Value column `",
      value_column,
      "` was not found."
    )
  }


  matching_values <- df[
    ch4_normalize_label(
      df[[category_column]]
    ) ==
      ch4_normalize_label(category),
    value_column,
    drop = TRUE
  ]


  matching_values <- ch4_numeric(
    matching_values
  )


  if (
    length(matching_values) != 1 ||
    is.na(matching_values[[1]])
  ) {

    stop(
      "Expected one nonmissing value for `",
      category,
      "` in column `",
      value_column,
      "`."
    )
  }


  matching_values[[1]]
}


