# ============================================================================
# 5. AUTOMATIC ENDPOINT HELPERS
# ============================================================================

numeric_clean <- function(x) {

  suppressWarnings(
    as.numeric(
      gsub(
        pattern = "[,$%]",
        replacement = "",
        x = as.character(x)
      )
    )
  )
}


series_values <- function(
    df,
    column,
    year_column = "Year"
) {

  missing_columns <- setdiff(
    c(
      year_column,
      column
    ),
    names(df)
  )


  if (length(missing_columns) > 0) {

    stop(
      "Missing required columns: ",
      paste(
        missing_columns,
        collapse = ", "
      ),
      "."
    )
  }


  tibble(
    Year = numeric_clean(
      df[[year_column]]
    ),

    Value = numeric_clean(
      df[[column]]
    )
  ) %>%
    filter(
      is.finite(Year),
      is.finite(Value)
    ) %>%
    arrange(
      Year
    )
}


series_endpoints <- function(
    df,
    column,
    year_column = "Year"
) {

  endpoint_data <- series_values(
    df = df,
    column = column,
    year_column = year_column
  )


  if (nrow(endpoint_data) == 0) {

    stop(
      "No nonmissing year-value observations were found for `",
      column,
      "`."
    )
  }


  tibble(
    first_year = dplyr::first(
      endpoint_data$Year
    ),

    first_value = dplyr::first(
      endpoint_data$Value
    ),

    last_year = dplyr::last(
      endpoint_data$Year
    ),

    last_value = dplyr::last(
      endpoint_data$Value
    )
  )
}


projection_endpoints <- function(
    df,
    observed_column,
    projected_column,
    year_column = "Year"
) {

  observed_data <- series_values(
    df = df,
    column = observed_column,
    year_column = year_column
  )

  projected_data <- series_values(
    df = df,
    column = projected_column,
    year_column = year_column
  )


  if (nrow(observed_data) == 0) {

    stop(
      "No observed values were found for `",
      observed_column,
      "`."
    )
  }


  if (nrow(projected_data) == 0) {

    stop(
      "No projected values were found for `",
      projected_column,
      "`."
    )
  }


  # Projection rows compare the latest observed value with the latest
  # projected value.

  tibble(
    first_year = dplyr::last(
      observed_data$Year
    ),

    first_value = dplyr::last(
      observed_data$Value
    ),

    last_year = dplyr::last(
      projected_data$Year
    ),

    last_value = dplyr::last(
      projected_data$Value
    )
  )
}


data_year_range <- function(
    df,
    year_column = "Year"
) {

  if (!year_column %in% names(df)) {

    stop(
      "Year column `",
      year_column,
      "` was not found."
    )
  }


  years <- numeric_clean(
    df[[year_column]]
  )

  years <- years[
    is.finite(years)
  ]


  if (length(years) == 0) {

    stop(
      "No valid years were found in `",
      year_column,
      "`."
    )
  }


  c(
    first = min(years),
    last = max(years)
  )
}


calendar_year_label <- function(year) {

  as.character(
    round(year)
  )
}


academic_year_label <- function(year) {

  start_year <- round(
    year
  )

  paste0(
    start_year,
    "/",
    sprintf(
      "%02d",
      (
        start_year + 1
      ) %% 100
    )
  )
}


# ============================================================================
# 6. TAB101 ENDPOINT HELPER
#
# TAB101 stores FirstYear and LastYear values, but the current file does not
# contain numeric endpoint-year columns.
#
# The helper first checks for endpoint-year columns in TAB101. When they are
# absent, it inherits the automatically detected FIG103 year range rather
# than hard-coding 1995 and 2025.
# ============================================================================

TAB101_REFERENCE_YEARS <- data_year_range(
  fig103
)


field_endpoints <- function(
    field,
    degree_prefix
) {

  row <- tab101 %>%
    filter(
      .data$Field ==
        .env$field
    )


  if (nrow(row) != 1) {

    stop(
      "Expected one TAB101 row for `",
      field,
      "`."
    )
  }


  first_value_column <- paste0(
    degree_prefix,
    "_FirstYear"
  )

  last_value_column <- paste0(
    degree_prefix,
    "_LastYear"
  )


  missing_value_columns <- setdiff(
    c(
      first_value_column,
      last_value_column
    ),
    names(row)
  )


  if (length(missing_value_columns) > 0) {

    stop(
      "TAB101 is missing: ",
      paste(
        missing_value_columns,
        collapse = ", "
      ),
      "."
    )
  }


  first_year_candidates <- c(
    paste0(
      degree_prefix,
      "_FirstYear_Year"
    ),

    paste0(
      degree_prefix,
      "_FirstYearYear"
    ),

    "FirstYear"
  )

  last_year_candidates <- c(
    paste0(
      degree_prefix,
      "_LastYear_Year"
    ),

    paste0(
      degree_prefix,
      "_LastYearYear"
    ),

    "LastYear"
  )


  first_year_columns <- intersect(
    first_year_candidates,
    names(row)
  )

  last_year_columns <- intersect(
    last_year_candidates,
    names(row)
  )


  first_year_column <- if (
    length(first_year_columns) > 0
  ) {

    first_year_columns[[1]]

  } else {

    NA_character_
  }


  last_year_column <- if (
    length(last_year_columns) > 0
  ) {

    last_year_columns[[1]]

  } else {

    NA_character_
  }


  first_year <- if (
    !is.na(first_year_column)
  ) {

    numeric_clean(
      row[[first_year_column]][[1]]
    )

  } else {

    unname(
      TAB101_REFERENCE_YEARS[["first"]]
    )
  }


  last_year <- if (
    !is.na(last_year_column)
  ) {

    numeric_clean(
      row[[last_year_column]][[1]]
    )

  } else {

    unname(
      TAB101_REFERENCE_YEARS[["last"]]
    )
  }


  tibble(
    first_year = first_year,

    first_value = numeric_clean(
      row[[first_value_column]][[1]]
    ),

    last_year = last_year,

    last_value = numeric_clean(
      row[[last_value_column]][[1]]
    )
  )
}


