export_chapter1_infographic <- function(
    name = "infographic_ch1_by_the_numbers",
    initial_row_padding_px = INITIAL_ROW_PADDING_PX,
    max_iterations = 6
) {

  if (!requireNamespace(
    "magick",
    quietly = TRUE
  )) {

    stop(
      "The magick package is required for exact infographic export."
    )
  }


  output_dir <- "final_infographics"

  html_dir <- file.path(
    output_dir,
    "html"
  )

  png_dir <- file.path(
    output_dir,
    "pngs"
  )


  dir.create(
    html_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )

  dir.create(
    png_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )


  html_path <- file.path(
    html_dir,
    paste0(
      name,
      ".html"
    )
  )

  png_path <- file.path(
    png_dir,
    paste0(
      name,
      ".png"
    )
  )

  raw_path <- file.path(
    png_dir,
    paste0(
      name,
      "_raw.png"
    )
  )


  row_padding_px <- initial_row_padding_px
  font_scale <- 1
  final_table <- NULL


  for (iteration in seq_len(
    max_iterations
  )) {

    trial_table <- build_chapter1_table(
      row_padding_px = row_padding_px,
      font_scale = font_scale
    )


    gt::gtsave(
      trial_table,
      raw_path,
      vwidth = INFOGRAPHIC_CSS_WIDTH_PX,
      vheight = INFOGRAPHIC_CSS_HEIGHT_PX,
      zoom = INFOGRAPHIC_ZOOM,
      expand = 0
    )


    rendered_image <- magick::image_read(
      raw_path
    )

    rendered_info <- magick::image_info(
      rendered_image
    )


    rendered_height_px <-
      rendered_info$height[[1]]

    height_difference_px <-
      INFOGRAPHIC_OUTPUT_HEIGHT_PX -
      rendered_height_px


    if (abs(
      height_difference_px
    ) <= 10) {

      final_table <- trial_table
      break
    }


    padding_correction_px <-
      (
        height_difference_px /
        INFOGRAPHIC_ZOOM
      ) /
      (
        2 *
          n_body_rows
      )


    proposed_padding_px <-
      row_padding_px +
      padding_correction_px


    if (
      height_difference_px < 0 &&
      proposed_padding_px < 0.25
    ) {

      row_padding_px <- 0.25

      proportional_scale <-
        INFOGRAPHIC_OUTPUT_HEIGHT_PX /
        rendered_height_px

      font_scale <- max(
        0.78,
        font_scale *
          min(
            0.98,
            proportional_scale
          )
      )

    } else {

      row_padding_px <- max(
        0.25,
        min(
          30,
          proposed_padding_px
        )
      )
    }


    final_table <- build_chapter1_table(
      row_padding_px = row_padding_px,
      font_scale = font_scale
    )
  }


  final_table <- build_chapter1_table(
    row_padding_px = row_padding_px,
    font_scale = font_scale
  )


  gt::gtsave(
    final_table,
    html_path
  )


  gt::gtsave(
    final_table,
    raw_path,
    vwidth = INFOGRAPHIC_CSS_WIDTH_PX,
    vheight = INFOGRAPHIC_CSS_HEIGHT_PX,
    zoom = INFOGRAPHIC_ZOOM,
    expand = 0
  )


  img <- magick::image_read(
    raw_path
  )

  info <- magick::image_info(
    img
  )


  if (
    info$width[[1]] !=
      INFOGRAPHIC_OUTPUT_WIDTH_PX
  ) {

    img <- magick::image_resize(
      img,
      paste0(
        INFOGRAPHIC_OUTPUT_WIDTH_PX,
        "x"
      )
    )
  }


  info <- magick::image_info(
    img
  )


  if (
    info$height[[1]] >
      INFOGRAPHIC_OUTPUT_HEIGHT_PX
  ) {

    img <- magick::image_resize(
      img,
      paste0(
        INFOGRAPHIC_OUTPUT_WIDTH_PX,
        "x",
        INFOGRAPHIC_OUTPUT_HEIGHT_PX,
        ">"
      )
    )
  }


  img <- magick::image_extent(
    img,
    geometry = paste0(
      INFOGRAPHIC_OUTPUT_WIDTH_PX,
      "x",
      INFOGRAPHIC_OUTPUT_HEIGHT_PX
    ),
    gravity = "north",
    color = "white"
  )


  magick::image_write(
    img,
    path = png_path,
    format = "png",
    density = paste0(
      INFOGRAPHIC_DPI,
      "x",
      INFOGRAPHIC_DPI
    )
  )


  final_info <- magick::image_info(
    magick::image_read(
      png_path
    )
  )


  if (
    final_info$width[[1]] !=
      INFOGRAPHIC_OUTPUT_WIDTH_PX ||
    final_info$height[[1]] !=
      INFOGRAPHIC_OUTPUT_HEIGHT_PX
  ) {

    stop(
      "Final PNG is ",
      final_info$width[[1]],
      " × ",
      final_info$height[[1]],
      " pixels; expected ",
      INFOGRAPHIC_OUTPUT_WIDTH_PX,
      " × ",
      INFOGRAPHIC_OUTPUT_HEIGHT_PX,
      "."
    )
  }


  if (file.exists(
    raw_path
  )) {

    unlink(
      raw_path
    )
  }


  message(
    "Saved ",
    png_path,
    " at ",
    final_info$width[[1]],
    " × ",
    final_info$height[[1]],
    " pixels. Included statistics: ",
    n_body_rows,
    ". Final row padding: ",
    round(
      row_padding_px,
