format_value <- function(
    value,
    value_type
) {

  switch(
    value_type,

    count = scales::comma(
      value,
      accuracy = 1
    ),

    share = scales::percent(
      value,
      accuracy = 0.1
    ),

    percent_value = paste0(
      scales::number(
        value,
        accuracy = 0.1
      ),
      "%"
    ),

    rate = scales::number(
      value,
      accuracy = 0.1
    ),

    ratio = paste0(
      scales::number(
        value,
        accuracy = 0.1
      ),
      ":1"
    ),

    stop(
      "Unknown value type: ",
      value_type
    )
  )
}


format_cell <- function(
    value,
    year_label,
    value_type,
    projected = FALSE
) {

  year_text <- as.character(
    year_label
  )


  if (projected) {

    year_text <- paste0(
      year_text,
      ", projected"
    )
  }


  paste0(
    format_value(
      value,
      value_type
    ),
    " (",
    year_text,
    ")"
  )
}


format_change <- function(
    first,
    last,
    change_type
) {

  positive_prefix <- ifelse(
    last >= first,
    "+",
    ""
  )


  switch(
    change_type,

    multiple = paste0(
      scales::number(
        last / first,
        accuracy = 0.1
      ),
      "×"
    ),

    percent = paste0(
      positive_prefix,
      scales::percent(
        (
          last / first
        ) - 1,
        accuracy = 1
      )
    ),

    pp_share = paste0(
      positive_prefix,
      scales::number(
        (
          last - first
        ) * 100,
        accuracy = 0.1
      ),
      " pp"
    ),

    pp_percent = paste0(
      positive_prefix,
      scales::number(
        last - first,
        accuracy = 0.1
      ),
      " pp"
    ),

    ratio_points = paste0(
      positive_prefix,
      scales::number(
        last - first,
        accuracy = 0.1
      ),
      " ratio points"
    ),

    stop(
      "Unknown change type: ",
      change_type
    )
  )
}


