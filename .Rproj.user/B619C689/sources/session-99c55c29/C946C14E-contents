# 9. ROW-BUILDING HELPERS
# ============================================================================

ch4_make_metric <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    first,
    first_year,
    last,
    last_year,
    value_type,
    change_type,
    emphasis = FALSE
) {

  if (
    !ch4_stat_enabled(
      stat_id,
      section_id
    )
  ) {

    return(NULL)
  }


  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,

    Earlier = ch4_format_cell(
      first,
      first_year,
      value_type
    ),

    Latest = ch4_format_cell(
      last,
      last_year,
      value_type
    ),

    Change = ch4_format_change(
      first,
      last,
      change_type
    ),

    Emphasis = emphasis
  )
}


ch4_make_comparison <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    earlier,
    latest,
    change,
    emphasis = FALSE
) {

  if (
    !ch4_stat_enabled(
      stat_id,
      section_id
    )
  ) {

    return(NULL)
  }


  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,
    Earlier = earlier,
    Latest = latest,
    Change = change,
    Emphasis = emphasis
  )
}


