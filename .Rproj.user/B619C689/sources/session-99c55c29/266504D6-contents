### Archived Figure 50 - Merge between 052 and 053
```{r figure 052_053 merge}
library(patchwork)

# Combined metadata row — add fig_052_053 to titles_and_sources.csv with a
# country-neutral title (US/China live on the panels). See note below.
meta <- get_meta("AF50")

num <- function(x) parse_number(as.character(x))

# One vocabulary for both panels so a single collected legend covers them.
# Order and names match mobility_colors_base exactly.
category_order <- c(
  "Purely Domestic",
  "Started Domestic, Trained Abroad, Returned",
  "Inbound, Stayed",
  "Started Domestic, Trained Abroad, Stayed Abroad",
  "Inbound, Left",
  "Purely Abroad"
)

# Collapse the destination-specific labels back to the base names.
# recode() leaves the four already-base categories untouched, so one map
# works on both the US and China files.
recode_map <- c(
  "Started Abroad, Came to the US, Stayed" = "Inbound, Stayed",
  "Started Abroad, Came to China, Stayed"  = "Inbound, Stayed",
  "Started Abroad, Came to the US, Left"   = "Inbound, Left",
  "Started Abroad, Came to China, Left"    = "Inbound, Left"
)

prep <- function(fig_id) {
  read_fig(fig_id) %>%
    rename(Category = 1, Count = 2) %>%
    mutate(Category = recode(Category, !!!recode_map),
           Count    = num(Count)) %>%
    group_by(Category) %>%
    summarise(Count = sum(Count), .groups = "drop") %>%
    complete(Category = category_order, fill = list(Count = 0)) %>%
    mutate(Share = Count / sum(Count) * 100)
}

panel_title <- theme(
  plot.title = element_textbox_simple(
    family = FONT_FAMILY, face = "bold",
    size   = AXIS_SIZE + 1, color = "grey20",
