ch3_ffrdc_endpoint <- function(which = c("first", "last"), share = FALSE) {
  which <- match.arg(which)
  columns <- c("Temporary visa holders", "U.S. citizens and permanent residents")
  year <- common_endpoint_year(ch3_fig208, columns, which)

  temporary <- ch3_fig208 %>%
    filter(numeric_clean(.data$Year) == .env$year) %>%
    pull("Temporary visa holders") %>%
    numeric_clean()

  domestic <- ch3_fig208 %>%
    filter(numeric_clean(.data$Year) == .env$year) %>%
    pull("U.S. citizens and permanent residents") %>%
    numeric_clean()

  if (length(temporary) != 1 || length(domestic) != 1 ||
      !is.finite(temporary[[1]]) || !is.finite(domestic[[1]])) {
    stop("Could not determine the FFRDC endpoint for ", year, ".")
  }

  value <- if (share) temporary[[1]] / (temporary[[1]] + domestic[[1]]) else temporary[[1]]
  list(year = year, label = year, value = value)
}

ch3_birthplace_endpoint <- function(df, column, which = c("first", "last")) {
  which <- match.arg(which)
  common_years <- Reduce(
    intersect,
    list(
      series_data(ch3_fig301a, column)$Year,
      series_data(ch3_fig301b, column)$Year
    )
  )

  if (length(common_years) == 0) {
    stop("No common birthplace years were found for `", column, "`.")
  }

  year <- if (which == "first") min(common_years) else max(common_years)
  value <- df %>%
    filter(numeric_clean(.data$Year) == .env$year) %>%
    pull(all_of(column)) %>%
    numeric_clean()

  if (length(value) != 1 || !is.finite(value[[1]])) {
    stop("Could not determine the birthplace value for `", column, "` in ", year, ".")
  }

  list(year = year, label = year, value = value[[1]])
}

ch3_h1b_periods <- temporal_columns(ch3_fig302, exclude = "Company")
CH3_H1B_FIRST_YEAR <- ch3_h1b_periods$year[[1]]
CH3_H1B_LAST_YEAR <- ch3_h1b_periods$year[[nrow(ch3_h1b_periods)]]

ch3_h1b_total <- function(year) {
  year_column <- ch3_h1b_periods %>%
    filter(.data$year == .env$year) %>%
    slice_tail(n = 1) %>%
    pull(.data$column)

  if (length(year_column) != 1) stop("No H-1B column was found for ", year, ".")

  value <- ch3_fig302 %>%
    filter(normalize_label(.data$Company) == normalize_label("Grand Total")) %>%
    pull(all_of(year_column)) %>%
    numeric_clean()

  if (length(value) != 1 || !is.finite(value[[1]])) {
    stop("Could not determine the H-1B total for ", year, ".")
  }
  value[[1]]
}

ch3_h1b_company_share <- function(company, year) {
  year_column <- ch3_h1b_periods %>%
    filter(.data$year == .env$year) %>%
    slice_tail(n = 1) %>%
    pull(.data$column)

  count <- ch3_fig302 %>%
    filter(normalize_label(.data$Company) == normalize_label(.env$company)) %>%
    pull(all_of(year_column)) %>%
    numeric_clean()

  count <- sum(count[is.finite(count)], na.rm = TRUE)
  count / ch3_h1b_total(year)
}

ch3_h1b_top_n_share <- function(year, n = 10) {
  year_column <- ch3_h1b_periods %>%
    filter(.data$year == .env$year) %>%
    slice_tail(n = 1) %>%
    pull(.data$column)

  counts <- ch3_fig302 %>%
    filter(normalize_label(.data$Company) != normalize_label("Grand Total")) %>%
    pull(all_of(year_column)) %>%
    numeric_clean()

  counts <- sort(counts[is.finite(counts)], decreasing = TRUE)
  sum(head(counts, n)) / ch3_h1b_total(year)
}

ch3_h1b_endpoint <- function(which = c("first", "last"), company = NULL, top_n = NULL) {
  which <- match.arg(which)
  year <- if (which == "first") CH3_H1B_FIRST_YEAR else CH3_H1B_LAST_YEAR
  value <- if (!is.null(top_n)) {
    ch3_h1b_top_n_share(year, top_n)
  } else {
    ch3_h1b_company_share(company, year)
  }
  list(year = year, label = year, value = value)
}


