series_endpoints <- function(df, column, year_column = "Year", academic = FALSE) {
  first <- data_endpoint(
    df = df,
    column = column,
    which = "first",
    year_column = year_column,
    academic = academic
  )
  last <- data_endpoint(
    df = df,
    column = column,
    which = "last",
    year_column = year_column,
    academic = academic
  )

  list(first = first, last = last)
}

field_endpoints <- function(field, degree_prefix) {
  row <- tab101 %>%
    filter(normalize_label(.data$Field) == normalize_label(.env$field))

  if (nrow(row) != 1) {
    stop("Expected one TAB101 row for `", field, "`.")
  }

  first_value_column <- paste0(degree_prefix, "_FirstYear")
  last_value_column <- paste0(degree_prefix, "_LastYear")
  missing <- setdiff(c(first_value_column, last_value_column), names(row))
  if (length(missing) > 0) {
    stop("TAB101 is missing: ", paste(missing, collapse = ", "), ".")
  }

  source_range <- metadata_year_range(infographic_meta_id(tab101))

  first_year_candidates <- c(
    paste0(degree_prefix, "_FirstYear_Year"),
    paste0(degree_prefix, "_FirstYearYear"),
    "FirstYear"
  )
  last_year_candidates <- c(
    paste0(degree_prefix, "_LastYear_Year"),
    paste0(degree_prefix, "_LastYearYear"),
    "LastYear"
  )

  first_year_column <- intersect(first_year_candidates, names(row))
  last_year_column <- intersect(last_year_candidates, names(row))

  first_year <- if (length(first_year_column) > 0) {
    year_number(row[[first_year_column[[1]]]])[[1]]
  } else {
    unname(source_range[["first"]])
  }

  last_year <- if (length(last_year_column) > 0) {
    year_number(row[[last_year_column[[1]]]])[[1]]
  } else {
    unname(source_range[["last"]])
  }

  list(
    first = list(
      value = numeric_clean(row[[first_value_column]])[[1]],
      year = first_year,
      label = calendar_year_label(first_year)
    ),
    last = list(
      value = numeric_clean(row[[last_value_column]])[[1]],
      year = last_year,
      label = calendar_year_label(last_year)
    )
  )
}


# ============================================================================
# 6. ROW-BUILDING HELPERS
# ============================================================================

make_metric_from_endpoints <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    endpoints,
    value_type,
    change_type,
    projected = FALSE
) {
  if (!stat_enabled(stat_id, section_id)) return(NULL)

  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,
    Earlier = format_cell(
      endpoints$first$value,
      endpoints$first$label,
      value_type
    ),
    Latest = format_cell(
      endpoints$last$value,
      endpoints$last$label,
      value_type,
      projected = projected
    ),
    Change = format_change(
      endpoints$first$value,
      endpoints$last$value,
      change_type
    ),
    Emphasis = stat_emphasized(stat_id)
  )
}

make_series_metric <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    df,
    column,
    value_type,
    change_type,
    year_column = "Year",
    year_labeler = calendar_year_label
) {
  academic <- identical(year_labeler, academic_year_label)

  make_metric_from_endpoints(
    stat_id = stat_id,
    section_id = section_id,
    section_label = section_label,
    measure = measure,
    endpoints = series_endpoints(
      df = df,
      column = column,
      year_column = year_column,
      academic = academic
    ),
    value_type = value_type,
    change_type = change_type
  )
}

make_projection_metric <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    df,
    observed_column,
    projected_column,
    value_type,
    change_type,
    year_column = "Year"
) {
  endpoints <- projection_endpoints(
    df = df,
    observed_column = observed_column,
    projected_column = projected_column,
    year_column = year_column
  )

  make_metric_from_endpoints(
    stat_id = stat_id,
    section_id = section_id,
    section_label = section_label,
    measure = measure,
    endpoints = endpoints,
    value_type = value_type,
    change_type = change_type,
    projected = TRUE
  )
}

make_field_metric <- function(stat_id, measure, field, degree_prefix) {
  make_metric_from_endpoints(
    stat_id = stat_id,
    section_id = "selected_fields",
    section_label = "International share in selected STEM fields",
    measure = measure,
    endpoints = field_endpoints(field, degree_prefix),
    value_type = "percent_value",
    change_type = "pp_percent"
  )
}


