ch2_reason_endpoint <- function(reason, which = c("first", "last")) {
  which <- match.arg(which)

  row <- ch2_fig212 %>%
    filter(normalize_label(.data$Reason) == normalize_label(.env$reason))

  if (nrow(row) != 1) {
    stop("Expected one FIG212 row for reason `", reason, "`.")
  }

  periods <- temporal_columns(
    row,
    exclude = c("Reason", "Change")
  )

  values <- numeric_clean(unlist(row[periods$column], use.names = FALSE))
  usable <- is.finite(values)
  periods <- periods[usable, , drop = FALSE]
  values <- values[usable]

  if (length(values) == 0) {
    stop("No usable dated values were found for reason `", reason, "`.")
  }

  index <- if (which == "first") 1 else length(values)
  list(
    value = values[[index]],
    year = periods$year[[index]],
    label = periods$column[[index]]
  )
}

ch2_region_endpoint <- function(region_column, which = c("first", "last")) {
  which <- match.arg(which)
  region_columns <- setdiff(names(ch2_tab201), c("Year", "Percent Asia"))
  year <- common_endpoint_year(
    ch2_tab201,
    columns = c(region_column, region_columns),
    which = which
  )

  total <- row_sum_data(ch2_tab201, region_columns) %>%
    filter(.data$Year == .env$year) %>%
    pull(.data$Value)

  value <- ch2_tab201 %>%
    filter(year_number(.data$Year) == .env$year) %>%
    pull(all_of(region_column)) %>%
    numeric_clean()

  if (length(total) != 1 || length(value) != 1 ||
      !is.finite(total[[1]]) || !is.finite(value[[1]])) {
    stop("Could not calculate the regional share for `", region_column, "`.")
  }

  list(
    value = value[[1]] / total[[1]],
    year = year,
    label = academic_period_label(ch2_tab201, year)
  )
}

ch2_recruitment_leader <- function(level = c("Undergraduate", "Graduate")) {
  level <- match.arg(level)
  country_column <- paste(level, "Country")
  percent_column <- paste(level, "Percent")

  missing <- setdiff(c(country_column, percent_column), names(ch2_fig211))
  if (length(missing) > 0) {
    stop("FIG211 is missing: ", paste(missing, collapse = ", "), ".")
  }

  out <- ch2_fig211 %>%
    transmute(
      Country = as.character(.data[[country_column]]),
      Percent = numeric_clean(.data[[percent_column]])
    ) %>%
    filter(nzchar(trimws(.data$Country)), is.finite(.data$Percent)) %>%
    mutate(
      Percent = if_else(abs(.data$Percent) <= 1, .data$Percent * 100, .data$Percent)
    ) %>%
    slice_max(order_by = .data$Percent, n = 1, with_ties = FALSE)

  if (nrow(out) != 1) stop("Could not determine the top ", tolower(level), " recruitment target.")

  out %>%
    mutate(
      Level = level,
      Year = source_latest_year(ch2_fig211)
    )
}

