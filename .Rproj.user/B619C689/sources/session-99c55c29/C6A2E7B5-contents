ch2_format_snapshot_change <- function(value) {
  paste0(ifelse(value > 0, "+", ""), scales::number(value, accuracy = 1), "%")
}

ch2_make_metric <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    first,
    last,
    value_type,
    change_type,
    emphasis = FALSE
) {
  if (!ch2_stat_enabled(stat_id, section_id)) return(NULL)

  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,
    Earlier = format_cell(first$value, first$label, value_type),
    Latest = format_cell(last$value, last$label, value_type),
    Change = format_change(first$value, last$value, change_type),
    Emphasis = emphasis
  )
}

ch2_project_value <- function(value, change_percent) {
  value * (1 + change_percent / 100)
}

ch2_make_snapshot <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    prior_value,
    change,
    emphasis = FALSE,
    value_type = "count"
) {
  if (!ch2_stat_enabled(stat_id, section_id)) return(NULL)

  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,
    Earlier = format_cell(prior_value, CH2_PROJECTION_BASE_YEAR, value_type),
    Latest = format_cell(
      ch2_project_value(prior_value, change),
      CH2_PROJECTION_YEAR,
      value_type,
      projected = TRUE
    ),
    Change = ch2_format_snapshot_change(change),
    Emphasis = emphasis
  )
}

ch2_make_comparison <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    earlier,
    latest,
    change,
    emphasis = FALSE
