ch4_mobility_series <- function(indicator, country) {
  out <- ch4_mobility_long %>%
    filter(
      normalize_label(.data$Indicator) == normalize_label(.env$indicator),
      normalize_label(.data$Country) == normalize_label(.env$country)
    ) %>%
    arrange(.data$Year) %>%
    distinct(.data$Year, .keep_all = TRUE)

  if (nrow(out) == 0) {
    stop("No mobility series was found for ", country, ", ", indicator, ".")
  }
  out
}

ch4_mobility_endpoint <- function(indicator, country, which = c("first", "last")) {
  which <- match.arg(which)
  series <- ch4_mobility_series(indicator, country)
  row <- if (which == "first") slice_head(series, n = 1) else slice_tail(series, n = 1)

  list(
    value = row$Value[[1]],
    year = row$Year[[1]],
    label = calendar_year_label(row$Year[[1]])
  )
}

ch4_mobility_gap_endpoint <- function(indicator, which = c("first", "last")) {
  which <- match.arg(which)
  us <- ch4_mobility_series(indicator, "United States")
  china <- ch4_mobility_series(indicator, "China")
  years <- intersect(us$Year, china$Year)

  if (length(years) == 0) {
    stop("No common US–CN mobility years were found for ", indicator, ".")
  }

  year <- if (which == "first") min(years) else max(years)
  list(
    value = us$Value[match(year, us$Year)] - china$Value[match(year, china$Year)],
    year = year,
    label = calendar_year_label(year)
  )
}

ch4_country_mobility_rows <- purrr::map2(
  rep(ch4_mobility_specs$Indicator, each = 2),
  rep(c("United States", "China"), times = nrow(ch4_mobility_specs)),
  function(indicator, country) {
    spec <- ch4_mobility_specs %>% filter(.data$Indicator == .env$indicator)
    prefix <- if (country == "United States") "us_" else "china_"
    section_id <- if (country == "United States") "mobility_us" else "mobility_china"

    ch4_make_metric(
      paste0(prefix, indicator),
      section_id,
      paste0(country, ": international student mobility"),
      spec$Measure[[1]],
      ch4_mobility_endpoint(indicator, country, "first"),
      ch4_mobility_endpoint(indicator, country, "last"),
      spec$ValueType[[1]],
      spec$CountryChangeType[[1]],
      indicator == "net_flow"
    )
  }
