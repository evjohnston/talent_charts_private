ch3_make_metric <- function(
    stat_id,
    section_id,
    section_label,
    measure,
    first,
    last,
    value_type,
    change_type,
    emphasis = FALSE
) {
  if (!ch3_stat_enabled(stat_id, section_id)) return(NULL)

  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,
    Earlier = format_cell(first$value, first$label, value_type),
    Latest = format_cell(last$value, last$label, value_type),
    Change = format_change(first$value, last$value, change_type),
    Emphasis = emphasis
  )
}

ch3_series_metric <- function(
