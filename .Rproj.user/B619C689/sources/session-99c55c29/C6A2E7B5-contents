ch6_series_endpoint <- function(series, which = c("first", "last")) {
  which <- match.arg(which)
  row <- if (which == "first") slice_head(series, n = 1) else slice_tail(series, n = 1)
  list(year = row$Year[[1]], label = row$Year[[1]], value = row$Value[[1]])
}

ch6_peak_endpoint <- function(series) {
  row <- series %>% slice_max(.data$Value, n = 1, with_ties = FALSE)
  list(year = row$Year[[1]], label = row$Year[[1]], value = row$Value[[1]])
}

ch6_largest_decline <- function(df, column) {
  series <- series_data(df, column)
  if (nrow(series) < 2) stop("At least two observations are required for a decline calculation.")

  candidates <- purrr::map_dfr(2:nrow(series), function(i) {
    prior <- series[1:(i - 1), , drop = FALSE]
    peak <- prior %>% slice_max(.data$Value, n = 1, with_ties = FALSE)
    tibble(
      peak_year = peak$Year[[1]], peak_value = peak$Value[[1]],
      trough_year = series$Year[[i]], trough_value = series$Value[[i]],
      decline = peak$Value[[1]] - series$Value[[i]]
    )
  })

  best <- candidates %>% slice_max(.data$decline, n = 1, with_ties = FALSE)
  list(
    peak = list(year = best$peak_year[[1]], label = best$peak_year[[1]], value = best$peak_value[[1]]),
    trough = list(year = best$trough_year[[1]], label = best$trough_year[[1]], value = best$trough_value[[1]])
  )
}

ch6_perm_series <- function(country) {
  ch6_tab604 %>%
    filter(normalize_label(.data$Country) == normalize_label(.env$country)) %>%
    mutate(Year = numeric_clean(.data$Year), Count = numeric_clean(.data$Count)) %>%
    filter(is.finite(.data$Year), is.finite(.data$Count)) %>%
    group_by(.data$Year) %>%
    summarise(
      expired = sum(.data$Count[normalize_label(.data$Status) == normalize_label("Certified-Expired")], na.rm = TRUE),
      current = sum(.data$Count[normalize_label(.data$Status) == normalize_label("Certified")], na.rm = TRUE),
      .groups = "drop"
    ) %>%
    mutate(Value = .data$expired / (.data$expired + .data$current)) %>%
    filter(is.finite(.data$Value)) %>%
    arrange(.data$Year)
}

