ch5_ep <- function(df, column, which = c("first", "last"), transform = identity) {
  which <- match.arg(which)
  endpoint <- data_endpoint(df, column, which)
  endpoint$value <- transform(endpoint$value)
  endpoint
}

ch5_gap_ep <- function(
    df,
    first_column,
    second_column,
    which = c("first", "last"),
    transform = identity
) {
  which <- match.arg(which)
  year <- common_endpoint_year(df, c(first_column, second_column), which)

  row <- df %>% filter(numeric_clean(.data$Year) == .env$year)
  first_value <- numeric_clean(row[[first_column]])
  second_value <- numeric_clean(row[[second_column]])

  if (length(first_value) != 1 || length(second_value) != 1 ||
      !is.finite(first_value[[1]]) || !is.finite(second_value[[1]])) {
    stop("Could not calculate the gap for `", first_column, "` and `", second_column, "` in ", year, ".")
  }

  list(
    year = year,
    label = year,
    value = transform(first_value[[1]]) - transform(second_value[[1]])
  )
}

ch5_long_series <- function(df, country, category_column, category, value_column) {
  required <- c("Year", "Country", category_column, value_column)
  missing <- setdiff(required, names(df))
  if (length(missing) > 0) stop("Missing required columns: ", paste(missing, collapse = ", "), ".")

  out <- df %>%
    filter(
      normalize_label(.data$Country) == normalize_label(.env$country),
      normalize_label(.data[[category_column]]) == normalize_label(.env$category)
    ) %>%
    transmute(
      Year = numeric_clean(.data$Year),
      Value = numeric_clean(.data[[value_column]])
    ) %>%
    filter(is.finite(.data$Year), is.finite(.data$Value)) %>%
    arrange(.data$Year)

  if (nrow(out) == 0) {
    stop("No usable long-form series was found for ", country, ", ", category, ".")
  }

  if (anyDuplicated(out$Year)) {
    stop("Duplicate years were found for ", country, ", ", category, ".")
  }

  out
}

ch5_long_ep <- function(
    df,
    country,
    category_column,
    category,
    value_column,
    which = c("first", "last")
) {
  which <- match.arg(which)
  series <- ch5_long_series(df, country, category_column, category, value_column)
  row <- if (which == "first") slice_head(series, n = 1) else slice_tail(series, n = 1)
  list(year = row$Year[[1]], label = row$Year[[1]], value = row$Value[[1]])
}

ch5_long_gap_ep <- function(
    df,
    category_column,
    category,
    value_column,
    which = c("first", "last")
) {
  which <- match.arg(which)
  us <- ch5_long_series(df, "United States", category_column, category, value_column)
  china <- ch5_long_series(df, "China", category_column, category, value_column)
  years <- intersect(us$Year, china$Year)

  if (length(years) == 0) stop("No common US–CN years were found for `", category, "`.")
  year <- if (which == "first") min(years) else max(years)

  list(
    year = year,
    label = year,
    value = us$Value[match(year, us$Year)] - china$Value[match(year, china$Year)]
  )
}

