ch6_wait_endpoint <- function(df, category, which = c("first", "last")) {
  which <- match.arg(which)
  text_column <- paste0(category, ".1")
  if (!all(c("Year", category, text_column) %in% names(df))) {
    stop("Wait-time file is missing columns for `", category, "`.")
  }

  series <- df %>%
    transmute(
      Year = numeric_clean(.data$Year),
      Value = numeric_clean(.data[[category]]),
      Text = as.character(.data[[text_column]])
    ) %>%
    filter(is.finite(.data$Year), is.finite(.data$Value), !is.na(.data$Text)) %>%
    arrange(.data$Year)

  row <- if (which == "first") slice_head(series, n = 1) else slice_tail(series, n = 1)
  list(year = row$Year[[1]], label = row$Year[[1]], value = row$Value[[1]], text = row$Text[[1]])
}

ch6_format_duration <- function(months, signed = FALSE) {
  rounded <- round(abs(months))
  years <- rounded %/% 12
  remaining <- rounded %% 12
  prefix <- if (!signed) "" else if (months > 0) "+" else if (months < 0) "-" else ""
  paste0(prefix, years, "Y ", remaining, "M")
}

