ch5_make_metric <- function(
    stat_id, section_id, section_label, measure,
    first, last, value_type, change_type, emphasis = FALSE,
    country_gap = FALSE
) {
  if (!ch5_stat_enabled(stat_id, section_id)) return(NULL)

  earlier_text <- if (country_gap) {
    format_country_gap_cell(first$value, first$label, value_type)
  } else {
    format_cell(first$value, first$label, value_type)
  }

  latest_text <- if (country_gap) {
    format_country_gap_cell(last$value, last$label, value_type)
  } else {
    format_cell(last$value, last$label, value_type)
  }

  tibble(
    StatID = stat_id,
    SectionID = section_id,
    Section = section_label,
    Measure = measure,
    Earlier = earlier_text,
    Latest = latest_text,
    Change = format_change(first$value, last$value, change_type),
    Emphasis = emphasis
  )
}

ch5_series_metric <- function(
    stat_id, section_id, section_label, measure,
    df, column, value_type, change_type,
    emphasis = FALSE, transform = identity
) {
  ch5_make_metric(
    stat_id, section_id, section_label, measure,
    ch5_ep(df, column, "first", transform),
    ch5_ep(df, column, "last", transform),
    value_type, change_type, emphasis
  )
}

ch5_gap_metric <- function(
    stat_id, section_id, section_label, measure,
    df, first_column, second_column, value_type, change_type,
    emphasis = FALSE, transform = identity
) {
  ch5_make_metric(
    stat_id, section_id, section_label, measure,
    ch5_gap_ep(df, first_column, second_column, "first", transform),
    ch5_gap_ep(df, first_column, second_column, "last", transform),
    value_type, change_type, emphasis, country_gap = TRUE
  )
}

ch5_make_display_row <- function(
    stat_id, section_id, section_label, measure,
    earlier, latest, change, emphasis = FALSE
) {
  if (!ch5_stat_enabled(stat_id, section_id)) return(NULL)
  tibble(
    StatID = stat_id, SectionID = section_id, Section = section_label,
    Measure = measure, Earlier = earlier, Latest = latest,
    Change = change, Emphasis = emphasis
  )
}


