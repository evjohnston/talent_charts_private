stat_enabled <- function(stat_id, section_id) {
  stat_is_enabled(
    stat_id,
    section_id,
    include_all = INCLUDE_ALL_STATS,
    include_sections = INCLUDE_SECTIONS,
    include_stats = INCLUDE_STATS
  )
