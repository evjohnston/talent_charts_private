ch4_mobility_specs <- tribble(
  ~Indicator,       ~Measure,                                          ~GapMeasure,                    ~ValueType,      ~CountryChangeType, ~GapValueType,    ~GapChangeType,
  "outbound_ratio", "Share of tertiary students studying abroad",     "outbound mobility ratio",     "percent_value", "pp_percent",       "signed_score",  "points",
  "net_flow",       "Net flow of internationally mobile students",    "net student flow",            "signed_count",  "count_delta",      "signed_count",  "count_delta"
