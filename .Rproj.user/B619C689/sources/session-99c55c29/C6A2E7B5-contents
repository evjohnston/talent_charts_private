      c(
        paste0(
          "**Note:** ROW* denotes Rest of World—the separately reported ",
          "all-other-countries series excluding India and CN. Stay-rate ",
          "years identify the published observation, not necessarily the ",
          "graduation year of the measured cohort. PERM comparisons use the ",
