ch4_category_value <- function(df, category_column, category, value_column) {
  missing <- setdiff(c(category_column, value_column), names(df))
  if (length(missing) > 0) {
    stop("Missing required columns: ", paste(missing, collapse = ", "), ".")
  }

  values <- df[
    normalize_label(df[[category_column]]) == normalize_label(category),
    value_column,
    drop = TRUE
  ] %>% numeric_clean()

  values <- values[is.finite(values)]
  if (length(values) != 1) {
    stop("Expected one value for `", category, "` in `", value_column, "`.")
  }
  values[[1]]
}

ch4_ep <- function(df, column, which = c("first", "last")) {
  data_endpoint(df, column, match.arg(which))
}

ch4_period_endpoint_value <- function(
    df,
    period_column,
    value_column,
    which = c("first", "last")
) {
  which <- match.arg(which)
  period <- period_endpoint(df[[period_column]], which)
  value <- ch4_category_value(df, period_column, period$label[[1]], value_column)

  list(
    value = value,
    year = period$year[[1]],
    label = period$label[[1]]
  )
}

ch4_multi_filter_value <- function(df, filters, value_column) {
  keep <- rep(TRUE, nrow(df))
  for (name in names(filters)) {
    if (!name %in% names(df)) stop("Column `", name, "` was not found.")
    keep <- keep & normalize_label(df[[name]]) == normalize_label(filters[[name]])
  }

  values <- numeric_clean(df[[value_column]][keep])
  values <- values[is.finite(values)]
  if (length(values) != 1) stop("Expected one value after applying the requested filters.")
  values[[1]]
}

ch4_degree_endpoint <- function(entry_field, degree_field, which = c("first", "last")) {
  which <- match.arg(which)
  period <- period_endpoint(ch4_fig406$cohort, which)
  value <- ch4_multi_filter_value(
    ch4_fig406,
    list(
      cohort = period$label[[1]],
      entry_field = entry_field,
      degree_field = degree_field
    ),
    "pct"
  )

  list(value = value, year = period$year[[1]], label = period$label[[1]])
}

ch4_field_endpoint <- function(field, which = c("first", "last")) {
  which <- match.arg(which)
  field_column <- "field"
  period <- temporal_column_endpoint(ch4_fig407, which, exclude = field_column)
  value <- ch4_category_value(ch4_fig407, field_column, field, period$column[[1]])

  list(
    value = value,
    year = period$year[[1]],
    label = academic_year_label(period$year[[1]])
  )
}

ch4_noncompletion_endpoint <- function(which = c("first", "last")) {
  which <- match.arg(which)
  period <- period_endpoint(ch4_fig408$Year, which)
  departure_columns <- grep(
    "^No degree, left without return year ",
    names(ch4_fig408),
    value = TRUE
  )

  if (length(departure_columns) == 0) {
    stop("No noncompletion columns were found in FIG408.")
  }

  keep <- as.character(ch4_fig408$Year) == period$label[[1]]
  values <- numeric_clean(unlist(
    ch4_fig408[keep, departure_columns, drop = FALSE],
    use.names = FALSE
  ))
  values <- values[is.finite(values)]

  if (length(values) == 0) {
    stop("No usable noncompletion values were found for `", period$label[[1]], "`.")
  }

  list(
    value = sum(values),
    year = period$year[[1]],
    label = period$label[[1]]
  )
}

ch4_study_share_endpoint <- function(which = c("first", "last")) {
  which <- match.arg(which)
  columns <- c("U.S. Study Abroad", "Total US Enrollment")
  year <- common_endpoint_year(ch4_fig409, columns, which)
  row <- ch4_fig409 %>% filter(year_number(.data$Year) == .env$year)

  participants <- numeric_clean(row[[columns[[1]]]])
  enrollment <- numeric_clean(row[[columns[[2]]]])

  if (length(participants) != 1 || length(enrollment) != 1 ||
      !is.finite(participants[[1]]) || !is.finite(enrollment[[1]]) ||
      enrollment[[1]] == 0) {
    stop("Could not calculate the study-abroad share for ", year, ".")
  }

  list(
    value = participants[[1]] / enrollment[[1]] * 100,
    year = year,
    label = calendar_year_label(year)
  )
}

ch4_snapshot_year <- function(...) {
  frames <- list(...)
  candidates <- purrr::map_dbl(frames, function(df) {
    tryCatch(source_latest_year(df), error = function(e) NA_real_)
  })
  candidates <- candidates[is.finite(candidates)]

  if (length(candidates) == 0) {
    stop("No snapshot year could be read from the Chapter 4 files or metadata.")
  }
  max(candidates)
}

