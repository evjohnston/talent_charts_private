if (change_type == "relative") "relative change" else "percentage-point change",
"from 2005 to 2024.",
if (change_type == "relative")
"Relative change is volatile for small-share regions (e.g., the Middle East & North Africa moved 1.0% to 1.6%)."
else
""
)
)
