)
) %>%
gt::tab_style(
style =
gt::cell_text(
color =
INFOGRAPHIC_PALETTE$muted
),
locations =
gt::cells_source_notes()
) %>%
gt::opt_css(
css =
paste0(
# --------------------------------------------------------------
# Snapshot body rows = exactly one standard infographic row
# --------------------------------------------------------------
"#infographic_ch6_departing_snapshot tbody tr {",
"height:",
CH6_STANDARD_ROW_HEIGHT_CSS_PX,
"px !important;",
"}",
"#infographic_ch6_departing_snapshot tbody td {",
"height:",
CH6_STANDARD_ROW_HEIGHT_CSS_PX,
"px !important;",
"box-sizing:border-box !important;",
"padding-top:0 !important;",
"padding-bottom:0 !important;",
"vertical-align:middle !important;",
"line-height:",
PUB$type_metrics$infographic_row_lineheight,
" !important;",
"white-space:nowrap !important;",
"}",
# --------------------------------------------------------------
# Snapshot title = exactly one standard infographic row
# --------------------------------------------------------------
"#infographic_ch6_departing_snapshot .gt_heading {",
"height:",
CH6_STANDARD_ROW_HEIGHT_CSS_PX,
"px !important;",
"box-sizing:border-box !important;",
"padding-top:0 !important;",
"padding-bottom:0 !important;",
"}",
"#infographic_ch6_departing_snapshot .gt_title {",
"height:",
CH6_STANDARD_ROW_HEIGHT_CSS_PX,
"px !important;",
"box-sizing:border-box !important;",
"padding-top:0 !important;",
"padding-bottom:0 !important;",
"line-height:",
CH6_STANDARD_ROW_HEIGHT_CSS_PX,
"px !important;",
"vertical-align:middle !important;",
"}",
# --------------------------------------------------------------
# Snapshot column-header band = exactly one standard row
# No red top border
# --------------------------------------------------------------
"#infographic_ch6_departing_snapshot .gt_col_heading {",
"height:",
CH6_STANDARD_ROW_HEIGHT_CSS_PX,
"px !important;",
"min-height:",
CH6_STANDARD_ROW_HEIGHT_CSS_PX,
"px !important;",
"max-height:",
CH6_STANDARD_ROW_HEIGHT_CSS_PX,
"px !important;",
"box-sizing:border-box !important;",
"border-top:none !important;",
"padding-top:0 !important;",
"padding-bottom:0 !important;",
"vertical-align:middle !important;",
"white-space:nowrap !important;",
"line-height:",
PUB$type_metrics$infographic_column_lineheight,
" !important;",
"}",
# --------------------------------------------------------------
# Source notes = exactly the same typography as Chapters 1–5
# --------------------------------------------------------------
"#infographic_ch6_departing_snapshot .gt_source_notes {",
"font-size:",
INFOGRAPHIC_FIXED_LAYOUT$source_font_px,
"px !important;",
"font-family:'Gotham' !important;",
"font-weight:400 !important;",
"line-height:",
PUB$type_metrics$infographic_source_lineheight,
" !important;",
"padding-left:",
infographic_pt_to_px(
PUB$spacing$infographic_side_pad_pt
),
"px !important;",
"padding-right:",
infographic_pt_to_px(
PUB$spacing$infographic_side_pad_pt
),
"px !important;",
"padding-bottom:0 !important;",
"}"
)
)
}
# ============================================================================
# 16. TABLE-TO-IMAGE RENDERER
# ============================================================================
ch6_render_table_image <- function(
table,
png_path
) {
gt::gtsave(
table,
png_path,
vwidth =
INFOGRAPHIC_SPEC$css_width_px,
vheight =
max(
INFOGRAPHIC_SPEC$css_height_px,
2400
),
zoom =
INFOGRAPHIC_SPEC$zoom,
expand =
0
)
image <- magick::image_read(
png_path
)
image_info <- magick::image_info(
image
)
if (
image_info$width[[1]] !=
INFOGRAPHIC_SPEC$output_width_px
) {
image <- magick::image_resize(
image,
paste0(
INFOGRAPHIC_SPEC$output_width_px,
"x"
)
)
}
image
}
# ============================================================================
# 17. COMPOSITE EXPORT
# ============================================================================
export_chapter6_composite <- function(
name =
"infographic_ch6_by_the_numbers"
) {
if (
!requireNamespace(
"magick",
quietly = TRUE
)
) {
stop(
"The magick package is required for the Chapter 6 composite infographic.",
call. = FALSE
)
}
output_dir <-
PATHS$final_infographics
html_dir <- file.path(
output_dir,
"html"
)
png_dir <- file.path(
output_dir,
"pngs"
)
dir.create(
html_dir,
recursive = TRUE,
showWarnings = FALSE
)
dir.create(
png_dir,
recursive = TRUE,
showWarnings = FALSE
)
main_html_path <- file.path(
html_dir,
paste0(
name,
"_longitudinal.html"
)
)
snapshot_html_path <- file.path(
html_dir,
paste0(
name,
"_snapshot.html"
)
)
main_raw_path <- file.path(
png_dir,
paste0(
name,
"_longitudinal_raw.png"
)
)
snapshot_raw_path <- file.path(
png_dir,
paste0(
name,
"_snapshot_raw.png"
)
)
png_path <- file.path(
png_dir,
paste0(
name,
".png"
)
)
# --------------------------------------------------------------------------
# Main longitudinal table
# --------------------------------------------------------------------------
main_table <-
build_ch6_main_table()
gt::gtsave(
main_table,
main_html_path
)
main_image <-
ch6_render_table_image(
table =
main_table,
png_path =
main_raw_path
)
# --------------------------------------------------------------------------
# Exactly one standard infographic row between the two tables
# --------------------------------------------------------------------------
CH6_DETACHED_GAP_PX <-
CH6_STANDARD_ROW_HEIGHT_OUTPUT_PX
spacer <- magick::image_blank(
width =
INFOGRAPHIC_SPEC$output_width_px,
height =
CH6_DETACHED_GAP_PX,
color =
"white"
)
# --------------------------------------------------------------------------
# Snapshot
#
# The snapshot now uses the same fixed typography and row height as the
# rest of the infographic. No adaptive font scaling is used.
# --------------------------------------------------------------------------
final_snapshot_table <-
build_ch6_snapshot_table()
final_snapshot_image <-
ch6_render_table_image(
table =
final_snapshot_table,
png_path =
snapshot_raw_path
)
final_image <- magick::image_append(
c(
main_image,
spacer,
final_snapshot_image
),
stack =
TRUE
)
candidate_info <- magick::image_info(
final_image
)
if (
candidate_info$height[[1]] >
INFOGRAPHIC_SPEC$output_height_px
) {
stop(
paste0(
"Chapter 6 main table plus detached Figure 6.09 snapshot is ",
candidate_info$height[[1]],
" px tall; the standard infographic canvas is ",
INFOGRAPHIC_SPEC$output_height_px,
" px tall. ",
"The snapshot is using the fixed publication typography and was not shrunk."
),
call. = FALSE
)
}
gt::gtsave(
final_snapshot_table,
snapshot_html_path
)
# --------------------------------------------------------------------------
# Extend to exact publication canvas
# --------------------------------------------------------------------------
final_image <- magick::image_extent(
final_image,
geometry =
paste0(
INFOGRAPHIC_SPEC$output_width_px,
"x",
INFOGRAPHIC_SPEC$output_height_px
),
gravity =
"north",
color =
"white"
)
magick::image_write(
final_image,
path =
png_path,
format =
"png",
density =
paste0(
INFOGRAPHIC_SPEC$dpi,
"x",
INFOGRAPHIC_SPEC$dpi
)
)
# --------------------------------------------------------------------------
# Final dimensions
# --------------------------------------------------------------------------
final_info <- magick::image_info(
magick::image_read(
png_path
)
)
if (
final_info$width[[1]] !=
INFOGRAPHIC_SPEC$output_width_px ||
final_info$height[[1]] !=
INFOGRAPHIC_SPEC$output_height_px
) {
stop(
paste0(
"Final Chapter 6 PNG is ",
final_info$width[[1]],
" x ",
final_info$height[[1]],
" px; expected ",
INFOGRAPHIC_SPEC$output_width_px,
" x ",
INFOGRAPHIC_SPEC$output_height_px,
"."
),
call. = FALSE
)
}
# --------------------------------------------------------------------------
# Audit registry
# --------------------------------------------------------------------------
INFOGRAPHIC_EXPORT_REGISTRY[[name]] <-
tibble::tibble(
Name =
name,
Page =
1L,
TotalPages =
1L,
BodyRows =
nrow(
ch6_display_data
),
SectionHeaders =
ch6_section_header_count,
RenderedRows =
nrow(
ch6_display_data
) +
ch6_section_header_count,
IsFinalPage =
TRUE,
WidthIn =
INFOGRAPHIC_SPEC$width_in,
HeightIn =
INFOGRAPHIC_SPEC$height_in,
ExpectedWidthPx =
INFOGRAPHIC_SPEC$output_width_px,
ExpectedHeightPx =
INFOGRAPHIC_SPEC$output_height_px,
ActualWidthPx =
final_info$width[[1]],
ActualHeightPx =
final_info$height[[1]],
DimensionVerification =
"PASS",
PNG =
png_path
)
# --------------------------------------------------------------------------
# Remove temporary raw PNGs
# --------------------------------------------------------------------------
if (
file.exists(
main_raw_path
)
) {
unlink(
main_raw_path
)
}
if (
file.exists(
snapshot_raw_path
)
) {
unlink(
snapshot_raw_path
)
}
message(
"Saved Chapter 6 composite infographic. Main table: ",
nrow(ch6_display_data),
" body rows + ",
ch6_section_header_count,
" section headers. Snapshot uses fixed publication typography."
)
list(
main_table =
main_table,
snapshot_table =
final_snapshot_table,
main_html_path =
main_html_path,
snapshot_html_path =
snapshot_html_path,
png_path =
png_path,
width_px =
final_info$width[[1]],
height_px =
final_info$height[[1]]
)
}
# ============================================================================
# 18. EXPORT
# ============================================================================
ch6_export <-
export_chapter6_composite()
ch6_exports <- list(
ch6_export
)
knitr::include_graphics(
ch6_export$png_path
)
# FIG609 (EVJ213) — chapter closer, by field.
# One cohort (2012-14 doctorate recipients), one horizon (~10-year U.S. stay
# rate), split into four STEM fields. Each field's departures valued at that
# field's own time to degree x the NSF GRFP support rate. Benchmark, not a
# per-person accounting (see note).
cohort <- read_fig("FIG607") %>%
mutate(across(c(recipients, stay_rate_10yr, ttd_years), as.numeric))
COST_PER_YEAR <- 53000
fld <- cohort %>%
mutate(
stayed     = recipients * stay_rate_10yr,
left       = recipients - stayed,
left_share = left / recipients,
cost_phd   = COST_PER_YEAR * ttd_years,
value_left = left * cost_phd
) %>%
arrange(left_share) %>%                       # lowest leak -> bottom, highest -> top
mutate(field = factor(field, levels = field))
value_total <- sum(fld$value_left)              # ~3.94e9
# long form for stacking; Left leftmost so its right edge = departure count
seg <- fld %>%
select(field, Stayed = stayed, Left = left) %>%
pivot_longer(c(Stayed, Left), names_to = "outcome", values_to = "count") %>%
mutate(outcome = factor(outcome, levels = c("Stayed", "Left")))
# leak label anchored just past the red segment's right edge (x = left)
leak_lab <- fld %>%
transmute(field, left,
llab = paste0(label_comma(accuracy = 100)(left),
"  (", round(left_share * 100), "%)"))
outcome_fill <- c("Stayed" = tpa_colors[9],   # muted
"Left"   = tpa_colors[1])   # emphasis red
meta <- get_meta("FIG607")
meta$caption <- paste0(meta$caption)
x_max <- max(fld$recipients)
FIG607 <- ggplot(seg, aes(x = count, y = field, fill = outcome)) +
geom_col(width = 0.68, alpha = ALPHA_COL) +
geom_text(
data = leak_lab, inherit.aes = FALSE,
aes(x = left, y = field, label = llab),
hjust = -0.08, family = FONT_FAMILY, fontface = "bold",
size = DATA_LABEL_SIZE / .pt, color = tpa_colors[1]
) +
annotate(
"text", x = 0, y = 0.32, hjust = 0,
label = sprintf("\u2248 $%.1f billion in STEM training investment left with them",
value_total / 1e9),
family = FONT_FAMILY, fontface = "bold",
size = TITLE_SIZE / .pt, color = tpa_colors[1]
) +
scale_x_continuous(labels = label_comma(), limits = c(0, x_max),
expand = expansion(mult = c(0, 0.05))) +
scale_y_discrete(expand = expansion(add = c(0, 0.6))) +
scale_fill_manual(values = outcome_fill, breaks = c("Stayed", "Left")) +
labs_meta(meta, x = NULL, y = NULL) +
theme_horizontal_bar()
save_chart_aligned(FIG607, "fig_6_07", size = "standard", left_pt = 125)
FIG607
