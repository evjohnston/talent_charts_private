) {
!(
chapter == "Chapter 3" &
stringr::str_starts(
stat_id,
"ai_staffing_"
)
) &
!(
chapter == "Chapter 4" &
stat_id %in%
c(
"pisa_us_vs_japan",
"pisa_top_math_us_vs_oecd"
)
) &
!(
chapter == "Chapter 4" &
stringr::str_starts(
stat_id,
"spending_"
)
) &
!(
chapter == "Chapter 6" &
(
stat_id ==
"trained_total" |
stringr::str_starts(
stat_id,
"loss_"
)
)
)
}
audit_page_assignments <- function(
data
) {
pages <- paginate_infographic_data(
data
)
total_pages <- length(
pages
)
purrr::imap_dfr(
pages,
function(page, page_number) {
contract <- infographic_page_contract(
page,
page_number = page_number,
total_pages = total_pages
)
tibble::tibble(
StatID = as.character(
page$StatID
),
Page = as.integer(
page_number
),
PageRow = seq_len(
nrow(page)
),
PageBodyRows =
contract$body_rows,
PageSectionHeaders =
contract$section_headers,
PageRenderedRows =
contract$rendered_rows,
PageIsFinal =
contract$is_final
)
}
)
}
audit_chapter <- function(
data,
chapter,
source_map
) {
page_map <- audit_page_assignments(
data
)
data %>%
dplyr::mutate(
AuditOrder =
dplyr::row_number(),
Source = unname(
source_map[
as.character(
.data$StatID
)
]
),
EarlierYear =
audit_extract_year(
.data$Earlier
),
LatestYear =
audit_extract_year(
.data$Latest
),
EndpointRule =
audit_endpoint_rule(
chapter,
as.character(
.data$StatID
)
),
YearsExpected =
audit_years_expected(
chapter,
as.character(
.data$StatID
)
)
) %>%
dplyr::left_join(
page_map,
by = "StatID"
) %>%
dplyr::mutate(
AuditFlag = dplyr::case_when(
is.na(
.data$Source
) ~
"CHECK: source map missing",
.data$YearsExpected &
.data$Earlier !=
"—" &
is.na(
.data$EarlierYear
) ~
"CHECK: earlier cell has no year",
.data$YearsExpected &
.data$Latest !=
"—" &
is.na(
.data$LatestYear
) ~
"CHECK: latest cell has no year",
!is.na(
.data$EarlierYear
) &
!is.na(
.data$LatestYear
) &
as.integer(
.data$EarlierYear
) >
as.integer(
.data$LatestYear
) ~
"CHECK: earlier year is later than latest year",
.data$PageBodyRows >
INFOGRAPHIC_ROWS_PER_PAGE ~
"CHECK: page exceeds body-row cap",
.data$PageSectionHeaders >
INFOGRAPHIC_SECTION_HEADERS_PER_PAGE ~
"CHECK: page exceeds section-header cap",
.data$PageRenderedRows >
INFOGRAPHIC_RENDERED_ROWS_PER_PAGE ~
"CHECK: page exceeds rendered-row budget",
!.data$PageIsFinal &
.data$PageBodyRows !=
INFOGRAPHIC_ROWS_PER_PAGE ~
"CHECK: nonfinal page is not 30 body rows",
!.data$PageIsFinal &
.data$PageSectionHeaders !=
INFOGRAPHIC_SECTION_HEADERS_PER_PAGE ~
"CHECK: nonfinal page is not 5 section headers",
TRUE ~
""
)
) %>%
dplyr::transmute(
Chapter = chapter,
Page = .data$Page,
PageRow = .data$PageRow,
PageBodyRows =
.data$PageBodyRows,
PageSectionHeaders =
.data$PageSectionHeaders,
PageRenderedRows =
.data$PageRenderedRows,
StatID = as.character(
.data$StatID
),
Section = as.character(
.data$Section
),
Measure = as.character(
.data$Measure
),
Source = .data$Source,
EarlierYear =
.data$EarlierYear,
LatestYear =
.data$LatestYear,
Earlier = as.character(
.data$Earlier
),
Latest = as.character(
.data$Latest
),
Change = as.character(
.data$Change
),
EndpointRule =
.data$EndpointRule,
AuditFlag =
.data$AuditFlag,
AuditOrder =
.data$AuditOrder
)
}
# Chapter 1 is exported through export_current_chapter(), which first performs
# these same two preparation steps. Audit that exact prepared data rather than
# the unformatted ch1_data object.
ch1_audit_data <- finalize_infographic_data(
ch1_data,
ch1_section_order
) %>%
editorialize_infographic_data(
1
)
infographic_source_year_audit <- dplyr::bind_rows(
audit_chapter(
ch1_audit_data,
"Chapter 1",
CH1_AUDIT_SOURCE
),
audit_chapter(
ch2_selected,
"Chapter 2",
CH2_AUDIT_SOURCE
),
audit_chapter(
ch3_selected,
"Chapter 3",
CH3_AUDIT_SOURCE
),
audit_chapter(
ch4_selected,
"Chapter 4",
CH4_AUDIT_SOURCE
),
audit_chapter(
ch5_selected,
"Chapter 5",
CH5_AUDIT_SOURCE
),
audit_chapter(
ch6_selected,
"Chapter 6",
CH6_AUDIT_SOURCE
)
) %>%
dplyr::arrange(
factor(
.data$Chapter,
levels = paste0(
"Chapter ",
1:6
)
),
.data$AuditOrder
) %>%
dplyr::select(
-.data$AuditOrder
)
# ----------------------------------------------------------------------------
# PAGE-LAYOUT / OUTPUT-SIZE AUDIT
# ----------------------------------------------------------------------------
CHAPTER_EXPORT_NAMES <- c(
"Chapter 1" =
"infographic_ch1_by_the_numbers",
"Chapter 2" =
"infographic_ch2_by_the_numbers",
"Chapter 3" =
"infographic_ch3_by_the_numbers",
"Chapter 4" =
"infographic_ch4_by_the_numbers",
"Chapter 5" =
"infographic_ch5_by_the_numbers",
"Chapter 6" =
"infographic_ch6_by_the_numbers"
)
infographic_page_layout_audit <- purrr::imap_dfr(
CHAPTER_EXPORT_NAMES,
function(export_name, chapter) {
if (
!exists(
export_name,
envir = INFOGRAPHIC_EXPORT_REGISTRY,
inherits = FALSE
)
) {
return(
tibble::tibble(
Chapter = chapter,
Name = export_name,
Page = NA_integer_,
TotalPages = NA_integer_,
BodyRows = NA_integer_,
SectionHeaders = NA_integer_,
RenderedRows = NA_integer_,
IsFinalPage = NA,
WidthIn = INFOGRAPHIC_SPEC$width_in,
HeightIn = INFOGRAPHIC_SPEC$height_in,
ExpectedWidthPx =
INFOGRAPHIC_SPEC$output_width_px,
ExpectedHeightPx =
INFOGRAPHIC_SPEC$output_height_px,
ActualWidthPx = NA_integer_,
ActualHeightPx = NA_integer_,
DimensionVerification =
"CHECK: export not registered",
PNG = NA_character_
)
)
}
get(
export_name,
envir = INFOGRAPHIC_EXPORT_REGISTRY,
inherits = FALSE
) %>%
dplyr::mutate(
Chapter = chapter,
.before = 1
)
}
) %>%
dplyr::mutate(
LayoutFlag = dplyr::case_when(
is.na(
.data$Page
) ~
"CHECK: chapter export not registered",
.data$BodyRows >
INFOGRAPHIC_ROWS_PER_PAGE ~
"CHECK: body-row cap exceeded",
.data$SectionHeaders >
INFOGRAPHIC_SECTION_HEADERS_PER_PAGE ~
"CHECK: section-header cap exceeded",
.data$RenderedRows >
INFOGRAPHIC_RENDERED_ROWS_PER_PAGE ~
"CHECK: rendered-row budget exceeded",
!.data$IsFinalPage &
.data$BodyRows !=
INFOGRAPHIC_ROWS_PER_PAGE ~
"CHECK: nonfinal page is not 30 body rows",
!.data$IsFinalPage &
.data$SectionHeaders !=
INFOGRAPHIC_SECTION_HEADERS_PER_PAGE ~
"CHECK: nonfinal page is not 5 section headers",
is.finite(
.data$ActualWidthPx
) &
.data$ActualWidthPx !=
.data$ExpectedWidthPx ~
"CHECK: PNG width differs from publication spec",
is.finite(
.data$ActualHeightPx
) &
.data$ActualHeightPx !=
.data$ExpectedHeightPx ~
"CHECK: PNG height differs from publication spec",
TRUE ~
""
)
) %>%
dplyr::arrange(
factor(
.data$Chapter,
levels = paste0(
"Chapter ",
1:6
)
),
.data$Page
)
# ----------------------------------------------------------------------------
# WRITE AUDITS
# ----------------------------------------------------------------------------
dir.create(
PATHS$final_infographics,
recursive = TRUE,
showWarnings = FALSE
)
INFOGRAPHIC_AUDIT_PATH <- file.path(
PATHS$final_infographics,
"infographic_source_year_audit_ch1_ch6.csv"
)
INFOGRAPHIC_LAYOUT_AUDIT_PATH <- file.path(
PATHS$final_infographics,
"infographic_page_layout_audit_ch1_ch6.csv"
)
readr::write_csv(
infographic_source_year_audit,
INFOGRAPHIC_AUDIT_PATH
)
readr::write_csv(
infographic_page_layout_audit,
INFOGRAPHIC_LAYOUT_AUDIT_PATH
)
source_year_problem_count <- sum(
nzchar(
infographic_source_year_audit$AuditFlag
),
na.rm = TRUE
)
layout_problem_count <- sum(
nzchar(
infographic_page_layout_audit$LayoutFlag
),
na.rm = TRUE
)
message(
"Infographic source/year audit saved to: ",
INFOGRAPHIC_AUDIT_PATH,
". Flags requiring review: ",
source_year_problem_count,
"."
)
message(
"Infographic page-layout audit saved to: ",
INFOGRAPHIC_LAYOUT_AUDIT_PATH,
". Flags requiring review: ",
layout_problem_count,
"."
)
if (
source_year_problem_count > 0L ||
layout_problem_count > 0L
) {
warning(
"Infographic QA completed with ",
source_year_problem_count,
" source/year flag(s) and ",
layout_problem_count,
" layout flag(s). Review the audit CSVs before publication.",
call. = FALSE
)
}
if (
isTRUE(
INFOGRAPHIC_AUDIT_SHOW
)
) {
cat(
"\n\n## Infographic source/year audit\n\n"
)
print(
knitr::kable(
infographic_source_year_audit %>%
dplyr::select(
Chapter,
Page,
PageRow,
StatID,
Measure,
Source,
EarlierYear,
LatestYear,
AuditFlag
),
align = c(
"l",
"c",
"c",
"l",
"l",
"l",
"c",
"c",
"l"
)
)
)
cat(
"\n\n## Infographic page-layout audit\n\n"
)
print(
knitr::kable(
infographic_page_layout_audit %>%
dplyr::select(
Chapter,
Page,
BodyRows,
SectionHeaders,
RenderedRows,
WidthIn,
HeightIn,
ActualWidthPx,
ActualHeightPx,
LayoutFlag
),
align = c(
"l",
"c",
"c",
"c",
"c",
"c",
"c",
"c",
"c",
"l"
)
)
)
}
