knitr::opts_chunk$set(
echo    = FALSE,
warning = FALSE,
message = FALSE
)
# Resolve this Rmd's directory, then locate setup_publication.R from there.
rmd_dir <- tryCatch(
dirname(normalizePath(knitr::current_input(dir = TRUE), winslash = "/", mustWork = TRUE)),
error = function(e) normalizePath(getwd(), winslash = "/", mustWork = TRUE)
)
setup_candidates <- c(
file.path(rmd_dir, "inputs", "scripts", "setup_publication.R"),
file.path(rmd_dir, "..", "inputs", "scripts", "setup_publication.R"),
file.path(getwd(), "inputs", "scripts", "setup_publication.R")
)
setup_path <- setup_candidates[file.exists(setup_candidates)][1]
if (is.na(setup_path)) {
stop(
"Could not locate inputs/scripts/setup_publication.R from the Rmd location or working directory.",
call. = FALSE
)
}
# -------------------------------------------------------------------------
# DISPLAY FORMATTERS — 3 SIGNIFICANT FIGURES
# -------------------------------------------------------------------------
fmt_sig3 <- function(x) {
vapply(x, function(z) {
if (is.na(z)) return(NA_character_)
if (!is.finite(z)) return(as.character(z))
format(
signif(z, 3),
scientific = FALSE,
trim       = TRUE,
big.mark   = ","
)
}, character(1))
}
# Values already stored as percentage points:
# 12.345 -> "12.3%"
fmt_sig3_pct <- function(x) {
paste0(fmt_sig3(x), "%")
}
fmt_sig3_signed_pct <- function(x) {
paste0(
ifelse(x > 0, "+", ""),
fmt_sig3_pct(x)
)
}
# Values stored as proportions:
# 0.12345 -> "12.3%"
fmt_sig3_prop <- function(x) {
paste0(fmt_sig3(x * 100), "%")
}
fmt_sig3_k <- function(x) {
paste0(fmt_sig3(x / 1e3), "K")
}
fmt_sig3_m <- function(x) {
paste0(fmt_sig3(x / 1e6), "M")
}
fmt_sig3_b <- function(x) {
paste0(fmt_sig3(x / 1e9), "B")
}
fmt_sig3_kbm <- function(x) {
vapply(x, function(z) {
if (is.na(z)) return(NA_character_)
if (abs(z) >= 1e9) {
paste0(fmt_sig3(z / 1e9), "B")
} else if (abs(z) >= 1e6) {
paste0(fmt_sig3(z / 1e6), "M")
} else if (abs(z) >= 1e3) {
paste0(fmt_sig3(z / 1e3), "K")
} else {
fmt_sig3(z)
}
}, character(1))
}
fmt_sig3_dollar <- function(x) {
paste0("$", fmt_sig3(x))
}
fmt_sig3_dollar_b <- function(x) {
paste0("$", fmt_sig3(x), "B")
}
fmt_sig3_dollar_k <- function(x) {
paste0("$", fmt_sig3(x / 1e3), "K")
}
# Signed ordinary values:
# 12.345  -> "+12.3"
# -12.345 -> "-12.3"
# 0       -> "0"
fmt_sig3_signed <- function(x) {
paste0(
ifelse(x > 0, "+", ""),
fmt_sig3(x)
)
}
source(setup_path)
# FIG609 (EVJ213) — chapter closer, by field.
# One cohort (2012-14 doctorate recipients), one horizon (~10-year U.S. stay
# rate), split into four STEM fields. Each field's departures valued at that
# field's own time to degree x the NSF GRFP support rate. Benchmark, not a
# per-person accounting (see note).
cohort <- read_fig("FIG607") %>%
mutate(
across(
c(recipients, stay_rate_10yr, ttd_years),
as.numeric
)
)
COST_PER_YEAR <- 53000
fld <- cohort %>%
mutate(
stayed     = recipients * stay_rate_10yr,
left       = recipients - stayed,
left_share = left / recipients,
cost_phd   = COST_PER_YEAR * ttd_years,
value_left = left * cost_phd
) %>%
arrange(left_share) %>%
mutate(
field = factor(field, levels = field)
)
value_total <- sum(fld$value_left, na.rm = TRUE)
# Long form for stacking.
seg <- fld %>%
select(
field,
Stayed = stayed,
Left   = left
) %>%
pivot_longer(
c(Stayed, Left),
names_to  = "outcome",
values_to = "count"
) %>%
mutate(
outcome = factor(
outcome,
levels = c("Stayed", "Left")
)
)
# Departure labels:
# count = 3 significant figures
# share = 3 significant figures
leak_lab <- fld %>%
transmute(
field,
left,
llab = paste0(
fmt_sig3(left),
"  (",
fmt_sig3_pct(left_share * 100),
")"
)
)
outcome_fill <- c(
"Stayed" = tpa_colors[9],
"Left"   = tpa_colors[1]
)
meta <- get_meta("FIG607")
x_max <- max(fld$recipients, na.rm = TRUE)
# Total investment annotation, in billions, 3 significant figures.
investment_label <- paste0(
"\u2248 $",
fmt_sig3(value_total / 1e9),
" billion in STEM training investment left with them"
)
FIG607 <- ggplot(
seg,
aes(
x = count,
y = field,
fill = outcome
)
) +
geom_col(
width = 0.68,
alpha = ALPHA_COL
) +
geom_text(
data = leak_lab,
inherit.aes = FALSE,
aes(
x = left,
y = field,
label = llab
),
hjust = -0.08,
family = FONT_FAMILY,
fontface = "bold",
size = DATA_LABEL_SIZE / .pt,
color = tpa_colors[1]
) +
annotate(
"text",
x = 0,
y = 0.39,
hjust = 0,
label = investment_label,
family = FONT_FAMILY,
fontface = "bold",
size = SUBTITLE_SIZE / .pt,
color = tpa_colors[1]
) +
scale_x_continuous(
labels = fmt_sig3,
limits = c(0, x_max),
expand = expansion(mult = c(0, 0.05))
) +
scale_y_discrete(
expand = expansion(add = c(0.9, 0.3))
) +
scale_fill_manual(
values = outcome_fill,
breaks = c("Stayed", "Left")
) +
labs_meta(
meta,
x = NULL,
y = NULL
) +
theme_horizontal_bar()
save_chart_aligned(
FIG607,
"fig_6_07",
size = "standard",
left_pt = 125
)
FIG607
