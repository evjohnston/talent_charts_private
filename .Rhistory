# -------------------------------------------------------------------------
# DISPLAY FORMATTERS — 3 SIGNIFICANT FIGURES
# -------------------------------------------------------------------------
fmt_sig3 <- function(x) {
vapply(x, function(z) {
if (is.na(z)) return(NA_character_)
if (!is.finite(z)) return(as.character(z))
format(
signif(z, 3),
scientific = FALSE,
trim       = TRUE,
big.mark   = ","
)
}, character(1))
}
# Values already stored as percentage points:
# 12.345 -> "12.3%"
fmt_sig3_pct <- function(x) {
paste0(fmt_sig3(x), "%")
}
fmt_sig3_signed_pct <- function(x) {
paste0(
ifelse(x > 0, "+", ""),
fmt_sig3_pct(x)
)
}
# Values stored as proportions:
# 0.12345 -> "12.3%"
fmt_sig3_prop <- function(x) {
paste0(fmt_sig3(x * 100), "%")
}
fmt_sig3_k <- function(x) {
paste0(fmt_sig3(x / 1e3), "K")
}
fmt_sig3_m <- function(x) {
paste0(fmt_sig3(x / 1e6), "M")
}
fmt_sig3_b <- function(x) {
paste0(fmt_sig3(x / 1e9), "B")
}
fmt_sig3_kbm <- function(x) {
vapply(x, function(z) {
if (is.na(z)) return(NA_character_)
if (abs(z) >= 1e9) {
paste0(fmt_sig3(z / 1e9), "B")
} else if (abs(z) >= 1e6) {
paste0(fmt_sig3(z / 1e6), "M")
} else if (abs(z) >= 1e3) {
paste0(fmt_sig3(z / 1e3), "K")
} else {
fmt_sig3(z)
}
}, character(1))
}
fmt_sig3_dollar <- function(x) {
paste0("$", fmt_sig3(x))
}
fmt_sig3_dollar_b <- function(x) {
paste0("$", fmt_sig3(x), "B")
}
fmt_sig3_dollar_k <- function(x) {
paste0("$", fmt_sig3(x / 1e3), "K")
}
# Signed ordinary values:
# 12.345  -> "+12.3"
# -12.345 -> "-12.3"
# 0       -> "0"
fmt_sig3_signed <- function(x) {
paste0(
ifelse(x > 0, "+", ""),
fmt_sig3(x)
)
}
source(setup_path)
meta <- get_meta("FIG606")
df_078 <- read_fig("FIG606") %>%
filter(!is.na(Year)) %>%
mutate(across(everything(), as.numeric)) %>%
pivot_longer(-Year, names_to = "Country", values_to = "Share") %>%
filter(!is.na(Share)) %>%
mutate(Share    = Share * 100,
is_china = Country == "China")
china_078 <- filter(df_078, is_china)
other_078 <- filter(df_078, !is_china)
china_last <- china_078 %>%
filter(Year == max(Year)) %>%
mutate(.label = paste0("China: ", fmt_sig3_pct(Share))) %>%
prepare_right_labels(df_078$Year)
FIG606 <- ggplot() +
geom_line(data = other_078,
aes(Year, Share, group = Country),
color = "grey75", linewidth = LINE_WIDTH) +
geom_line(data = china_078,
aes(Year, Share),
color = tpa_colors[1], linewidth = LINE_WIDTH_DENSE) +
geom_point(data = china_last,
aes(Year, Share), color = tpa_colors[1], size = 2.5) +
geom_label_repel_tpa(
data    = china_last,
mapping = aes(x = .label_x, y = Share, label = .label),
color        = tpa_colors[1],
hjust        = 0,
direction    = "y",
with_segment = TRUE
) +
scale_x_years(df_078$Year, right_labels = china_last) +
scale_y_continuous(labels = fmt_sig3_pct,
limits = c(0, 12), breaks = seq(0, 12, 2),
expand = EXPAND_BAR_TIGHT) +
labs_meta(meta, y = "Share of J-1 participants") +
coord_cartesian(clip = "off") +
theme_tpa() +
theme_right_labels(china_last)
save_chart_aligned(FIG606, "fig_6_06")
FIG606
