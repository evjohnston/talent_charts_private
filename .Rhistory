),
locations = cells_column_labels(
everything()
)
) %>%
tab_style(
style = cell_borders(
sides = "top",
color = CH6_RED,
weight = px(3)
),
locations = cells_column_labels(
everything()
)
) %>%
tab_style(
style = list(
cell_fill(
color = CH6_TINT
),
cell_text(
color = CH6_RED,
weight = "bold",
transform = "uppercase"
)
),
locations = cells_row_groups()
) %>%
tab_style(
style = list(
cell_fill(
color = CH6_PINK
),
cell_text(
color = CH6_RED,
weight = "bold"
)
),
locations = cells_body(
columns = Latest
)
) %>%
tab_style(
style = cell_text(
weight = "bold"
),
locations = list(
cells_stub(
rows = Emphasis
),
cells_body(
rows = Emphasis
)
)
) %>%
tab_style(
style = cell_text(
color = CH6_MUTED
),
locations = cells_source_notes()
) %>%
tab_options(
table.font.size = px(
data_font_px
),
table.font.color = CH6_TEXT,
column_labels.font.size = px(
header_font_px
),
column_labels.padding = px(3),
data_row.padding = px(
row_padding_px
),
heading.title.font.size = px(
snapshot_title_font_px
),
heading.padding = px(4),
heading.align = "left",
source_notes.font.size = px(
source_font_px
),
source_notes.padding = px(2),
table.background.color = "white",
row.striping.background_color = "white",
table_body.hlines.color = CH6_RULE,
table_body.hlines.width = px(1),
row_group.border.top.color = CH6_RULE,
row_group.border.bottom.color = CH6_RULE,
table.width = px(
CH6_CSS_WIDTH_PX
),
container.width = px(
CH6_CSS_WIDTH_PX
)
) %>%
fixed_table_width(
profile = "ultrawide",
width_px = CH6_CSS_WIDTH_PX,
stub_width_px = CH6_COL_MEASURE_PX
) %>%
cols_width(
stub()  ~ px(CH6_COL_MEASURE_PX),
Earlier ~ px(CH6_COL_EARLIER_PX),
Latest  ~ px(CH6_COL_LATEST_PX),
Change  ~ px(CH6_COL_CHANGE_PX)
) %>%
opt_css(
css = paste0(
"#chapter6_snapshot .gt_table {",
"border-top:4px solid ", CH6_RED, " !important;",
"}",
"#chapter6_snapshot .ch6-snapshot-title {",
"color:", CH6_TEXT, ";",
"font-size:", snapshot_title_font_px, "px;",
"font-weight:700;",
"letter-spacing:0.4px;",
"line-height:1.0;",
"}",
"#chapter6_snapshot .gt_heading {",
"padding-left:8px !important;",
"padding-right:8px !important;",
"}",
"#chapter6_snapshot .gt_group_heading {",
"font-size:", group_font_px, "px !important;",
"line-height:1.02 !important;",
"padding-top:3px !important;",
"padding-bottom:3px !important;",
"white-space:normal !important;",
"}",
"#chapter6_snapshot .gt_row {",
"line-height:1.01 !important;",
"}",
"#chapter6_snapshot .gt_stub, ",
"#chapter6_snapshot .gt_rowname {",
"padding-left:8px !important;",
"padding-right:8px !important;",
"}",
"#chapter6_snapshot .gt_col_heading {",
"line-height:1.02 !important;",
"}",
"#chapter6_snapshot .gt_source_notes {",
"line-height:1.03 !important;",
"padding-left:8px !important;",
"padding-right:8px !important;",
"}",
"#chapter6_snapshot tbody td:not(.gt_stub):not(.gt_rowname) {",
"white-space:nowrap !important;",
"}"
)
)
}
# ============================================================================
# 15. RENDERING HELPER
# ============================================================================
ch6_render_table_image <- function(
table,
path
) {
gt::gtsave(
table,
path,
vwidth = CH6_CSS_WIDTH_PX,
vheight = max(
CH6_CSS_HEIGHT_PX,
2400
),
zoom = CH6_EXPORT_ZOOM,
expand = 0
)
image <- magick::image_read(
path
)
image_info <- magick::image_info(
image
)
if (
image_info$width[[1]] !=
CH6_OUTPUT_WIDTH_PX
) {
image <- magick::image_resize(
image,
paste0(
CH6_OUTPUT_WIDTH_PX,
"x"
)
)
}
image
}
# ============================================================================
# 16. EXPORT BOTH TABLES AS ONE INFOGRAPHIC
#
# Both tables are rendered with one shared row-padding value and one shared
# font scale. They are then stacked into one exact-size PNG.
# ============================================================================
export_chapter6_infographic <- function(
name =
"infographic_ch6_by_the_numbers",
initial_row_padding_px =
CH6_INITIAL_ROW_PADDING_PX,
max_iterations = 14
) {
if (!requireNamespace("magick", quietly = TRUE)) {
stop(
"The magick package is required for exact infographic export."
)
}
output_dir <- "final_infographics"
html_dir <- file.path(
output_dir,
"html"
)
png_dir <- file.path(
output_dir,
"pngs"
)
dir.create(
html_dir,
recursive = TRUE,
showWarnings = FALSE
)
dir.create(
png_dir,
recursive = TRUE,
showWarnings = FALSE
)
longitudinal_html_path <- file.path(
html_dir,
paste0(
name,
"_longitudinal.html"
)
)
snapshot_html_path <- file.path(
html_dir,
paste0(
name,
"_snapshot.html"
)
)
png_path <- file.path(
png_dir,
paste0(
name,
".png"
)
)
longitudinal_raw_path <- file.path(
png_dir,
paste0(
name,
"_longitudinal_raw.png"
)
)
snapshot_raw_path <- file.path(
png_dir,
paste0(
name,
"_snapshot_raw.png"
)
)
row_padding_px <- initial_row_padding_px
font_scale <- 1
# -------------------------------------------------------------------------
# Fit the combined table height using one shared scale.
# -------------------------------------------------------------------------
for (iteration in seq_len(max_iterations)) {
longitudinal_table <-
build_chapter6_longitudinal_table(
row_padding_px = row_padding_px,
font_scale = font_scale
)
snapshot_table <-
build_chapter6_snapshot_table(
row_padding_px = row_padding_px,
font_scale = font_scale
)
longitudinal_image <-
ch6_render_table_image(
table = longitudinal_table,
path = longitudinal_raw_path
)
snapshot_image <-
ch6_render_table_image(
table = snapshot_table,
path = snapshot_raw_path
)
combined_image <- magick::image_append(
c(
longitudinal_image,
snapshot_image
),
stack = TRUE
)
combined_info <- magick::image_info(
combined_image
)
height_difference_px <-
CH6_OUTPUT_HEIGHT_PX -
combined_info$height[[1]]
if (abs(height_difference_px) <= 10) {
break
}
padding_correction_px <- (
height_difference_px /
CH6_EXPORT_ZOOM
) /
(
2 *
ch6_n_body_rows
)
proposed_padding_px <-
row_padding_px +
padding_correction_px
if (
height_difference_px < 0 &&
proposed_padding_px < 0.1
) {
row_padding_px <- 0.1
proportional_scale <-
CH6_OUTPUT_HEIGHT_PX /
combined_info$height[[1]]
font_scale <- max(
0.66,
font_scale *
min(
0.985,
proportional_scale
)
)
} else {
row_padding_px <- max(
0.1,
min(
20,
proposed_padding_px
)
)
}
}
# -------------------------------------------------------------------------
# Build and save final tables.
# -------------------------------------------------------------------------
final_longitudinal_table <-
build_chapter6_longitudinal_table(
row_padding_px = row_padding_px,
font_scale = font_scale
)
final_snapshot_table <-
build_chapter6_snapshot_table(
row_padding_px = row_padding_px,
font_scale = font_scale
)
gt::gtsave(
final_longitudinal_table,
longitudinal_html_path
)
gt::gtsave(
final_snapshot_table,
snapshot_html_path
)
# -------------------------------------------------------------------------
# Render the final tables with identical typography.
# -------------------------------------------------------------------------
final_longitudinal_image <-
ch6_render_table_image(
table = final_longitudinal_table,
path = longitudinal_raw_path
)
final_snapshot_image <-
ch6_render_table_image(
table = final_snapshot_table,
path = snapshot_raw_path
)
final_image <- magick::image_append(
c(
final_longitudinal_image,
final_snapshot_image
),
stack = TRUE
)
final_info <- magick::image_info(
final_image
)
# Last-resort proportional fit applies to both tables together.
if (
final_info$height[[1]] >
CH6_OUTPUT_HEIGHT_PX
) {
final_image <- magick::image_resize(
final_image,
paste0(
CH6_OUTPUT_WIDTH_PX,
"x",
CH6_OUTPUT_HEIGHT_PX,
">"
)
)
}
# Place the combined infographic on the exact-size canvas.
final_image <- magick::image_extent(
final_image,
geometry = paste0(
CH6_OUTPUT_WIDTH_PX,
"x",
CH6_OUTPUT_HEIGHT_PX
),
gravity = "north",
color = "white"
)
magick::image_write(
final_image,
path = png_path,
format = "png",
density = paste0(
CH6_OUTPUT_DPI,
"x",
CH6_OUTPUT_DPI
)
)
final_info <- magick::image_info(
magick::image_read(
png_path
)
)
if (
final_info$width[[1]] !=
CH6_OUTPUT_WIDTH_PX ||
final_info$height[[1]] !=
CH6_OUTPUT_HEIGHT_PX
) {
stop(
"Final Chapter 6 PNG is ",
final_info$width[[1]],
" × ",
final_info$height[[1]],
" pixels; expected ",
CH6_OUTPUT_WIDTH_PX,
" × ",
CH6_OUTPUT_HEIGHT_PX,
"."
)
}
temporary_paths <- c(
longitudinal_raw_path,
snapshot_raw_path
)
for (path in temporary_paths) {
if (file.exists(path)) {
unlink(
path
)
}
}
message(
"Saved one Chapter 6 infographic to ",
png_path,
" at ",
final_info$width[[1]],
" × ",
final_info$height[[1]],
" pixels. Longitudinal rows: ",
ch6_n_longitudinal_rows,
". Snapshot rows: ",
ch6_n_snapshot_rows,
". Shared row padding: ",
round(
row_padding_px,
2
),
" CSS px. Shared font scale: ",
round(
font_scale,
3
),
"."
)
invisible(
list(
longitudinal_table =
final_longitudinal_table,
snapshot_table =
final_snapshot_table,
longitudinal_html_path =
longitudinal_html_path,
snapshot_html_path =
snapshot_html_path,
png_path =
png_path,
width_px =
final_info$width[[1]],
height_px =
final_info$height[[1]],
row_padding_px =
row_padding_px,
font_scale =
font_scale,
longitudinal_statistics =
ch6_n_longitudinal_rows,
snapshot_statistics =
ch6_n_snapshot_rows
)
)
}
# ============================================================================
# 17. EXPORT AND DISPLAY
# ============================================================================
chapter6_infographic_export <-
export_chapter6_infographic()
knitr::include_graphics(
chapter6_infographic_export$png_path
)
