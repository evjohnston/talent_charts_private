meta <- get_meta("FIG602")
knitr::opts_chunk$set(
echo    = FALSE,
warning = FALSE,
message = FALSE
)
# Resolve this Rmd's directory, then locate setup_publication.R from there.
rmd_dir <- tryCatch(
dirname(normalizePath(knitr::current_input(dir = TRUE), winslash = "/", mustWork = TRUE)),
error = function(e) normalizePath(getwd(), winslash = "/", mustWork = TRUE)
)
setup_candidates <- c(
file.path(rmd_dir, "inputs", "scripts", "setup_publication.R"),
file.path(rmd_dir, "..", "inputs", "scripts", "setup_publication.R"),
file.path(getwd(), "inputs", "scripts", "setup_publication.R")
)
setup_path <- setup_candidates[file.exists(setup_candidates)][1]
if (is.na(setup_path)) {
stop(
"Could not locate inputs/scripts/setup_publication.R from the Rmd location or working directory.",
call. = FALSE
)
}
# -------------------------------------------------------------------------
# DISPLAY FORMATTERS — 3 SIGNIFICANT FIGURES
# -------------------------------------------------------------------------
fmt_sig3 <- function(x) {
vapply(x, function(z) {
if (is.na(z)) return(NA_character_)
if (!is.finite(z)) return(as.character(z))
format(
signif(z, 3),
scientific = FALSE,
trim       = TRUE,
big.mark   = ","
)
}, character(1))
}
# Values already stored as percentage points:
# 12.345 -> "12.3%"
fmt_sig3_pct <- function(x) {
paste0(fmt_sig3(x), "%")
}
fmt_sig3_signed_pct <- function(x) {
paste0(
ifelse(x > 0, "+", ""),
fmt_sig3_pct(x)
)
}
# Values stored as proportions:
# 0.12345 -> "12.3%"
fmt_sig3_prop <- function(x) {
paste0(fmt_sig3(x * 100), "%")
}
fmt_sig3_k <- function(x) {
paste0(fmt_sig3(x / 1e3), "K")
}
fmt_sig3_m <- function(x) {
paste0(fmt_sig3(x / 1e6), "M")
}
fmt_sig3_b <- function(x) {
paste0(fmt_sig3(x / 1e9), "B")
}
fmt_sig3_kbm <- function(x) {
vapply(x, function(z) {
if (is.na(z)) return(NA_character_)
if (abs(z) >= 1e9) {
paste0(fmt_sig3(z / 1e9), "B")
} else if (abs(z) >= 1e6) {
paste0(fmt_sig3(z / 1e6), "M")
} else if (abs(z) >= 1e3) {
paste0(fmt_sig3(z / 1e3), "K")
} else {
fmt_sig3(z)
}
}, character(1))
}
fmt_sig3_dollar <- function(x) {
paste0("$", fmt_sig3(x))
}
fmt_sig3_dollar_b <- function(x) {
paste0("$", fmt_sig3(x), "B")
}
fmt_sig3_dollar_k <- function(x) {
paste0("$", fmt_sig3(x / 1e3), "K")
}
# Signed ordinary values:
# 12.345  -> "+12.3"
# -12.345 -> "-12.3"
# 0       -> "0"
fmt_sig3_signed <- function(x) {
paste0(
ifelse(x > 0, "+", ""),
fmt_sig3(x)
)
}
source(setup_path)
meta <- get_meta("FIG602")
df_067 <- read_fig("FIG602") %>%
filter(!is.na(Year)) %>%
mutate(across(everything(), as.numeric)) %>%
pivot_longer(-Year, names_to = "Rate", values_to = "Share") %>%
filter(!is.na(Share)) %>%
mutate(
Share = Share * 100,
Rate  = factor(Rate, levels = c("5-year stay rate", "10-year stay rate"))
)
# first point, last point, and peak of each line; first-point labels
# left-align so they extend right off the marker instead of over the axis
labels_067 <- flp_by_group(df_067, Year, Share, Rate) %>%
mutate(hjust = if_else(Year == min(Year), 1, 0.5))
palette_067 <- c(
"5-year stay rate"  = tpa_colors[2],   # navy
"10-year stay rate" = tpa_colors[1]    # red
)
# approximate shared cohort: 5-yr at 2017 and 10-yr at 2023 both exist on the grid.
# (an exact 5-year offset is impossible here since all data years are odd.)
cohort_pts <- bind_rows(
df_067 %>% filter(Rate == "5-year stay rate",  Year == 2017),
df_067 %>% filter(Rate == "10-year stay rate", Year == 2023)
)
FIG602 <- ggplot(df_067, aes(Year, Share, color = Rate, group = Rate)) +
geom_line(
data        = cohort_pts,
aes(Year, Share),
inherit.aes = FALSE,
linetype    = "dashed",
linewidth   = 0.5,
color       = "grey45"
) +
geom_line(linewidth = LINE_WIDTH) +
geom_point(size = 2) +
geom_point(
data        = cohort_pts,
aes(Year, Share),
inherit.aes = FALSE,
shape       = 21,
size        = 4,
stroke      = 0.8,
color       = "grey30",
fill        = NA
) +
geom_text_tpa(
data        = labels_067,
mapping     = aes(label = fmt_sig3_pct(Share), hjust = hjust),
show.legend = FALSE
) +
scale_x_years(df_067$Year, pad_right = .09, pad_left = 0.09) +
scale_y_continuous(labels = fmt_sig3_pct,
limits = c(50, 75),
breaks = seq(50, 75, 5),
expand = expansion(mult = c(0, 0.05))) +
scale_color_manual(values = palette_067) +
coord_cartesian(clip = "off") +
labs_meta(meta, y = "Stay rate") +
theme_tpa()
save_chart_aligned(FIG602, "fig_6_02")
FIG602
meta <- get_meta("FIG602")
df_067 <- read_fig("FIG602") %>%
filter(!is.na(Year)) %>%
mutate(across(everything(), as.numeric)) %>%
pivot_longer(-Year, names_to = "Rate", values_to = "Share") %>%
filter(!is.na(Share)) %>%
mutate(
Share = Share * 100,
Rate  = factor(Rate, levels = c("5-year stay rate", "10-year stay rate"))
)
# first point, last point, and peak of each line; first-point labels
# left-align so they extend right off the marker instead of over the axis
labels_067 <- flp_by_group(df_067, Year, Share, Rate) %>%
mutate(hjust = if_else(Year == min(Year), 1, 0.5))
palette_067 <- c(
"5-year stay rate"  = tpa_colors[2],   # navy
"10-year stay rate" = tpa_colors[1]    # red
)
# Connect each 5-year point to the 10-year point six years later: both describe
# roughly the same graduating cohort observed at the two horizons. An exact
# 5-year offset can't be drawn because every data year is odd, so 6 years is the
# nearest the grid allows (graduates about a year apart, not identical).
wide_067 <- df_067 %>%
select(Year, Rate, Share) %>%
tidyr::pivot_wider(names_from = Rate, values_from = Share)
cohort_links <- purrr::map_dfr(
wide_067$Year[!is.na(wide_067$`5-year stay rate`)],
function(t) {
y5  <- wide_067$`5-year stay rate`[wide_067$Year == t]
y10 <- wide_067$`10-year stay rate`[wide_067$Year == t + 6]
if (length(y10) == 0 || is.na(y10) || is.na(y5)) return(NULL)
tibble(
cohort = t,
Year   = c(t, t + 6),
Share  = c(y5, y10)
)
}
)
FIG602 <- ggplot(df_067, aes(Year, Share, color = Rate, group = Rate)) +
geom_line(
data        = cohort_links,
aes(Year, Share, group = cohort),
inherit.aes = FALSE,
linetype    = "dotted",
linewidth   = 0.4,
color       = "grey55"
) +
geom_line(linewidth = LINE_WIDTH) +
geom_point(size = 2) +
geom_text_tpa(
data        = labels_067,
mapping     = aes(label = fmt_sig3_pct(Share), hjust = hjust),
show.legend = FALSE
) +
scale_x_years(df_067$Year, pad_right = .09, pad_left = 0.09) +
scale_y_continuous(labels = fmt_sig3_pct,
limits = c(50, 75),
breaks = seq(50, 75, 5),
expand = expansion(mult = c(0, 0.05))) +
scale_color_manual(values = palette_067) +
coord_cartesian(clip = "off") +
labs_meta(meta, y = "Stay rate") +
labs(caption = paste0(
"*Dotted lines connect each five-year stay rate to the ten-year rate six years later, ",
"approximating the same graduating cohort observed at both horizons. The offset is six ",
"years rather than five because the series is reported only in odd years.",
"<br><br>",
meta$caption
)) +
theme_tpa()
save_chart_aligned(FIG602, "fig_6_02")
FIG602
