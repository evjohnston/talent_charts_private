# Resolve this Rmd's directory, then locate setup_publication.R from there.
rmd_dir <- tryCatch(
dirname(normalizePath(knitr::current_input(dir = TRUE), winslash = "/", mustWork = TRUE)),
error = function(e) normalizePath(getwd(), winslash = "/", mustWork = TRUE)
)
setup_candidates <- c(
file.path(rmd_dir, "inputs", "scripts", "setup_publication.R"),
file.path(rmd_dir, "..", "inputs", "scripts", "setup_publication.R"),
file.path(getwd(), "inputs", "scripts", "setup_publication.R")
)
setup_path <- setup_candidates[file.exists(setup_candidates)][1]
if (is.na(setup_path)) {
stop(
"Could not locate inputs/scripts/setup_publication.R from the Rmd location or working directory.",
call. = FALSE
)
}
# -------------------------------------------------------------------------
# DISPLAY FORMATTERS — 3 SIGNIFICANT FIGURES
# -------------------------------------------------------------------------
fmt_sig3 <- function(x) {
vapply(x, function(z) {
if (is.na(z)) return(NA_character_)
if (!is.finite(z)) return(as.character(z))
format(
signif(z, 3),
scientific = FALSE,
trim       = TRUE,
big.mark   = ","
)
}, character(1))
}
# Values already stored as percentage points:
# 12.345 -> "12.3%"
fmt_sig3_pct <- function(x) {
paste0(fmt_sig3(x), "%")
}
fmt_sig3_signed_pct <- function(x) {
paste0(
ifelse(x > 0, "+", ""),
fmt_sig3_pct(x)
)
}
# Values stored as proportions:
# 0.12345 -> "12.3%"
fmt_sig3_prop <- function(x) {
paste0(fmt_sig3(x * 100), "%")
}
fmt_sig3_k <- function(x) {
paste0(fmt_sig3(x / 1e3), "K")
}
fmt_sig3_m <- function(x) {
paste0(fmt_sig3(x / 1e6), "M")
}
fmt_sig3_b <- function(x) {
paste0(fmt_sig3(x / 1e9), "B")
}
fmt_sig3_kbm <- function(x) {
vapply(x, function(z) {
if (is.na(z)) return(NA_character_)
if (abs(z) >= 1e9) {
paste0(fmt_sig3(z / 1e9), "B")
} else if (abs(z) >= 1e6) {
paste0(fmt_sig3(z / 1e6), "M")
} else if (abs(z) >= 1e3) {
paste0(fmt_sig3(z / 1e3), "K")
} else {
fmt_sig3(z)
}
}, character(1))
}
fmt_sig3_dollar <- function(x) {
paste0("$", fmt_sig3(x))
}
fmt_sig3_dollar_b <- function(x) {
paste0("$", fmt_sig3(x), "B")
}
fmt_sig3_dollar_k <- function(x) {
paste0("$", fmt_sig3(x / 1e3), "K")
}
# Signed ordinary values:
# 12.345  -> "+12.3"
# -12.345 -> "-12.3"
# 0       -> "0"
fmt_sig3_signed <- function(x) {
paste0(
ifelse(x > 0, "+", ""),
fmt_sig3(x)
)
}
source(setup_path)
meta <- get_meta("FIG000")
df_000 <- read_fig("FIG000") %>%
rename(Country = 1, value = 2) %>%
mutate(value = as.numeric(value)) %>%
arrange(desc(value)) %>%
mutate(Country = fct_reorder(Country, value))
labels_000 <- first_last_peak(df_000, value, value)
FIG000 <- ggplot(df_000, aes(value, Country, fill = Country)) +
geom_col(width = 0.75, alpha = ALPHA_COL) +
geom_text(aes(label = fmt_sig3(value), hjust = -0.2),
family = FONT_FAMILY,
fontface = "bold",
size = SMALL_LABEL_SIZE / .pt,
color = "grey25") +
scale_x_continuous(labels = fmt_sig3,
expand = EXPAND_LABEL_RIGHT) +
scale_fill_manual(values = highlight_colors(
all_values  = levels(df_000$Country),
highlighted = "United States of America",
palette     = tpa_colors[1],
default     = tpa_colors[2]
)) +
guides(fill = "none") +
labs_meta(meta, x = "Inbound internationally mobile students (2023)") +
coord_cartesian(clip = "off") +
theme_horizontal_bar() +
theme(
axis.text.y = element_text(size = SMALL_LABEL_SIZE),
plot.margin = publication_margin(right = PUB$spacing$edge_wide_pt)
)
save_chart_aligned(FIG000, "fig_0_00", size = "medium", left_pt = 135)
