showWarnings = FALSE
)
}
main_html_path <- file.path(
html_dir,
paste0(name, "_longitudinal.html")
)
snapshot_html_path <- file.path(
html_dir,
paste0(name, "_snapshot.html")
)
main_raw_path <- file.path(
png_dir,
paste0(name, "_longitudinal_raw.png")
)
snapshot_raw_path <- file.path(
png_dir,
paste0(name, "_snapshot_raw.png")
)
png_path <- file.path(
png_dir,
paste0(name, ".png")
)
pdf_path <- file.path(
pdf_dir,
paste0(name, ".pdf")
)
# --------------------------------------------------------------------------
# Main longitudinal table
# --------------------------------------------------------------------------
main_table <- build_ch6_main_table()
gt::gtsave(
main_table,
main_html_path
)
main_image <- ch6_render_table_image(
table = main_table,
png_path = main_raw_path
)
# --------------------------------------------------------------------------
# Exactly one standard infographic row between the two tables
# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# Snapshot
# --------------------------------------------------------------------------
final_snapshot_table <- build_ch6_snapshot_table()
final_snapshot_image <- ch6_render_table_image(
table = final_snapshot_table,
png_path = snapshot_raw_path
)
# --------------------------------------------------------------------------
# Fit the largest possible gap between the two tables.
# Never shrink either table.
# --------------------------------------------------------------------------
main_info <- magick::image_info(main_image)
snapshot_info <- magick::image_info(final_snapshot_image)
available_gap_px <-
INFOGRAPHIC_SPEC$output_height_px -
main_info$height[[1]] -
snapshot_info$height[[1]]
if (available_gap_px < 0) {
stop(
paste0(
"Chapter 6 tables alone are ",
abs(available_gap_px),
" px taller than the ",
INFOGRAPHIC_SPEC$output_height_px,
" px canvas. Row padding or content must be reduced."
),
call. = FALSE
)
}
CH6_DETACHED_GAP_PX <- as.integer(
min(
CH6_STANDARD_ROW_HEIGHT_OUTPUT_PX,
available_gap_px
)
)
if (CH6_DETACHED_GAP_PX > 0L) {
spacer <- magick::image_blank(
width  = INFOGRAPHIC_SPEC$output_width_px,
height = CH6_DETACHED_GAP_PX,
color  = "white"
)
final_image <- magick::image_append(
c(
main_image,
spacer,
final_snapshot_image
),
stack = TRUE
)
} else {
final_image <- magick::image_append(
c(
main_image,
final_snapshot_image
),
stack = TRUE
)
}
candidate_info <- magick::image_info(
final_image
)
if (
candidate_info$height[[1]] >
INFOGRAPHIC_SPEC$output_height_px
) {
stop(
paste0(
"Chapter 6 main table plus detached Figure 6.09 snapshot is ",
candidate_info$height[[1]],
" px tall; the standard infographic canvas is ",
INFOGRAPHIC_SPEC$output_height_px,
" px tall. ",
"The snapshot is using the fixed publication typography and was not shrunk."
),
call. = FALSE
)
}
gt::gtsave(
final_snapshot_table,
snapshot_html_path
)
composite_html_path <- file.path(
html_dir,
paste0(name, ".html")
)
main_html <- gt::as_raw_html(
main_table,
inline_css = TRUE
)
snapshot_html <- gt::as_raw_html(
final_snapshot_table,
inline_css = TRUE
)
gap_css_px <-
CH6_DETACHED_GAP_PX / INFOGRAPHIC_SPEC$zoom
composite_html <- paste0(
"<!DOCTYPE html>",
"<html>",
"<head>",
"<meta charset='utf-8'>",
"<style>",
"html, body {",
"  width: 100%;",
"  margin: 0;",
"  padding: 0;",
"  background: ", INFOGRAPHIC_PALETTE$background, ";",
"  print-color-adjust: exact;",
"  -webkit-print-color-adjust: exact;",
"}",
".infographic-page {",
"  width: ", INFOGRAPHIC_SPEC$css_width_px, "px;",
"  margin: 0 auto;",
"  padding: 0;",
"}",
".infographic-gap {",
"  height: ", gap_css_px, "px;",
"}",
"</style>",
"</head>",
"<body>",
"<div class='infographic-page'>",
main_html,
"<div class='infographic-gap'></div>",
snapshot_html,
"</div>",
"</body>",
"</html>"
)
writeLines(
composite_html,
con = composite_html_path,
useBytes = TRUE
)
# --------------------------------------------------------------------------
# Extend to exact publication canvas
# --------------------------------------------------------------------------
final_image <- magick::image_extent(
final_image,
geometry = paste0(
INFOGRAPHIC_SPEC$output_width_px,
"x",
INFOGRAPHIC_SPEC$output_height_px
),
gravity = "north",
color = INFOGRAPHIC_PALETTE$background
)
magick::image_write(
final_image,
path = png_path,
format = "png",
density = paste0(
INFOGRAPHIC_SPEC$dpi,
"x",
INFOGRAPHIC_SPEC$dpi
)
)
# --------------------------------------------------------------------------
# Final dimensions
# --------------------------------------------------------------------------
final_info <- magick::image_info(
magick::image_read(
png_path
)
)
if (
final_info$width[[1]] !=
INFOGRAPHIC_SPEC$output_width_px ||
final_info$height[[1]] !=
INFOGRAPHIC_SPEC$output_height_px
) {
stop(
paste0(
"Final Chapter 6 PNG is ",
final_info$width[[1]],
" x ",
final_info$height[[1]],
" px; expected ",
INFOGRAPHIC_SPEC$output_width_px,
" x ",
INFOGRAPHIC_SPEC$output_height_px,
"."
),
call. = FALSE
)
}
# --------------------------------------------------------------------------
# Exact-size PDF
#
# IMPORTANT: build this only AFTER the final composite PNG has been extended
# and verified at the publication canvas. This keeps the PDF visually
# identical to the PNG and uses the same physical dimensions as Chapters 1–5.
# --------------------------------------------------------------------------
if (!requireNamespace("pagedown", quietly = TRUE)) {
stop(
"Package 'pagedown' is required for the Chapter 6 vector PDF.",
call. = FALSE
)
}
browser_css_dpi <- 96
CH6_PDF_FIT_SCALE <- .9475
pdf_scale <-
(
(INFOGRAPHIC_SPEC$width_in * browser_css_dpi) /
INFOGRAPHIC_SPEC$css_width_px
) * CH6_PDF_FIT_SCALE
pdf_scale <- max(0.1, min(2, pdf_scale))
if (file.exists(pdf_path)) {
unlink(pdf_path)
}
pagedown::chrome_print(
input  = composite_html_path,
output = pdf_path,
wait   = 2,
options = list(
paperWidth        = INFOGRAPHIC_SPEC$width_in,
paperHeight       = INFOGRAPHIC_SPEC$height_in,
marginTop         = 0,
marginBottom      = 0,
marginLeft        = 0,
marginRight       = 0,
printBackground   = TRUE,
preferCSSPageSize = FALSE,
scale              = pdf_scale
)
)
if (!file.exists(pdf_path)) {
stop(
"Chapter 6 text/vector PDF was not created.",
call. = FALSE
)
}
# --------------------------------------------------------------------------
# Audit registry
# --------------------------------------------------------------------------
INFOGRAPHIC_EXPORT_REGISTRY[[name]] <-
tibble::tibble(
Name = name,
Page = 1L,
TotalPages = 1L,
BodyRows = nrow(ch6_display_data),
SectionHeaders = ch6_section_header_count,
RenderedRows =
nrow(ch6_display_data) +
ch6_section_header_count,
IsFinalPage = TRUE,
WidthIn = INFOGRAPHIC_SPEC$width_in,
HeightIn = INFOGRAPHIC_SPEC$height_in,
ExpectedWidthPx = INFOGRAPHIC_SPEC$output_width_px,
ExpectedHeightPx = INFOGRAPHIC_SPEC$output_height_px,
ActualWidthPx = final_info$width[[1]],
ActualHeightPx = final_info$height[[1]],
DimensionVerification = "PASS",
PNG = png_path,
PDF = pdf_path
)
# --------------------------------------------------------------------------
# Remove temporary raw PNGs
# --------------------------------------------------------------------------
if (file.exists(main_raw_path)) {
unlink(main_raw_path)
}
if (file.exists(snapshot_raw_path)) {
unlink(snapshot_raw_path)
}
message(
"Saved Chapter 6 composite infographic as PNG and PDF. Main table: ",
nrow(ch6_display_data),
" body rows + ",
ch6_section_header_count,
" section headers. Snapshot uses fixed publication typography."
)
list(
main_table = main_table,
snapshot_table = final_snapshot_table,
main_html_path = main_html_path,
snapshot_html_path = snapshot_html_path,
png_path = png_path,
pdf_path = pdf_path,
width_px = final_info$width[[1]],
height_px = final_info$height[[1]]
)
}
# ============================================================================
# 18. EXPORT
# ============================================================================
ch6_export <-
export_chapter6_composite()
ch6_exports <- list(
ch6_export
)
knitr::include_graphics(
ch6_export$png_path
)
knitr::opts_chunk$set(
echo    = FALSE,
warning = FALSE,
message = FALSE
)
