)
) +
geom_col(
width = 0.68,
alpha = ALPHA_COL
) +
geom_text(
data = leak_lab,
inherit.aes = FALSE,
aes(
x = left,
y = field,
label = llab
),
hjust = -0.08,
family = FONT_FAMILY,
fontface = "bold",
size = DATA_LABEL_SIZE / .pt,
color = tpa_colors[1]
) +
annotate(
"text",
x = 0,
y = 0.39,
hjust = 0,
label = investment_label,
family = FONT_FAMILY,
fontface = "bold",
size = SUBTITLE_SIZE / .pt,
color = tpa_colors[1]
) +
scale_x_continuous(
labels = fmt_sig3,
limits = c(0, x_max),
expand = expansion(mult = c(0, 0.05))
) +
scale_y_discrete(
expand = expansion(add = c(0.9, 0.3))
) +
scale_fill_manual(
values = outcome_fill,
breaks = c("Stayed", "Left")
) +
labs_meta(
meta,
x = NULL,
y = NULL
) +
theme_horizontal_bar()
