# ----------------------------------------------------------------------------
# 7. VALIDATE INCLUDE / EXCLUDE CONTROLS
# ----------------------------------------------------------------------------
ch1_stat_ids <- unique(
ch1_data_all$StatID
)
missing_controls <- setdiff(
ch1_stat_ids,
names(
CH1_INCLUDE
)
)
unknown_controls <- setdiff(
names(
CH1_INCLUDE
),
ch1_stat_ids
)
if (
length(
missing_controls
) ||
length(
unknown_controls
)
) {
stop(
paste0(
"CH1_INCLUDE is out of sync with ch1_data. ",
if (
length(
missing_controls
)
) {
paste0(
"Missing controls: ",
paste(
missing_controls,
collapse = ", "
),
". "
)
} else {
""
},
if (
length(
unknown_controls
)
) {
paste0(
"Unknown controls: ",
paste(
unknown_controls,
collapse = ", "
),
"."
)
} else {
""
}
),
call. = FALSE
)
}
# ----------------------------------------------------------------------------
# 8. APPLY INCLUDE / EXCLUDE CONTROLS
# ----------------------------------------------------------------------------
ch1_enabled_ids <- names(
CH1_INCLUDE
)[
CH1_INCLUDE
]
ch1_data <- ch1_data_all %>%
filter(
.data$StatID %in%
ch1_enabled_ids
)
if (
nrow(
ch1_data
) == 0L
) {
stop(
"CH1_INCLUDE excludes every Chapter 1 statistic.",
call. = FALSE
)
}
# ----------------------------------------------------------------------------
# 9. EXPORT
# ----------------------------------------------------------------------------
ch1_section_order <- c(
"Expansion of US higher education",
"Growth and composition of STEM training",
"International enrollment and degree dependence",
"International share in selected STEM fields",
"Global STEM PhD projections"
)
ch1_has_projections <- any(
ch1_data$SectionID ==
"projection"
)
# A single * in the 1995 column means that the source series extends further
# back than the selected 1995 comparison year.
ch1_has_prebaseline_history <- any(
stringr::str_detect(
ch1_data$Earlier,
"(?<!\\*)\\*$"
)
)
# A double ** in the 2025 column means that the latest available observation
# is 2024 rather than 2025.
ch1_has_2024_fallback <- any(
stringr::str_detect(
ch1_data$Latest,
"\\*\\*$"
)
)
# Default historical/current view:
#
#       MEASURE | 1995 | 2025 | CHANGE
#
# If projection rows are manually enabled, use broader labels because those
# rows compare their latest observed and projected endpoints rather than
# 1995 and 2025.
ch1_column_labels <- c(
Earlier = if (
ch1_has_projections
) {
"1995 / Observed"
} else {
as.character(
CH1_BASELINE_YEAR
)
},
Latest = if (
ch1_has_projections
) {
"2025 / Projected"
} else {
as.character(
CH1_TARGET_YEAR
)
},
Change =
"Change"
)
ch1_note_text <- c(
if (
ch1_has_prebaseline_history
) {
paste0(
"\\* Data are available further back than ",
CH1_BASELINE_YEAR,
" for marked series."
)
} else {
NULL
},
if (
ch1_has_2024_fallback
) {
paste0(
"\\*\\* Latest data are available through ",
CH1_FALLBACK_YEAR,
" for marked series."
)
} else {
NULL
},
paste0(
"**Note:** Historical comparisons use ",
CH1_BASELINE_YEAR,
" and ",
CH1_TARGET_YEAR,
" observations. ",
if (
ch1_has_projections
) {
paste0(
"Projection rows compare the latest observed year with the latest ",
"projected year; a “P” marks projections. "
)
} else {
""
},
"Arrow colors indicate direction of change only."
)
)
export_current_chapter(
data =
ch1_data,
chapter_number =
1,
title =
"AMERICA’S STEM TALENT SYSTEM: BY THE NUMBERS",
subtitle = if (
ch1_has_projections
) {
"Historical, current, and projected measures"
} else {
"Historical and current measures"
},
name =
"infographic_ch1_by_the_numbers",
source_figures = c(
"Figures 1.01–1.08",
"Table 1.01"
),
section_order =
ch1_section_order,
note_text =
ch1_note_text,
column_labels =
ch1_column_labels,
trend_right_padding_px =
5,
show_header = FALSE,
)
