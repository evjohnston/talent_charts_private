audit_endpoint_rule <- function(
chapter,
stat_id
) {
dplyr::case_when(
# ------------------------------------------------------------------------
# Chapter 1
# ------------------------------------------------------------------------
chapter == "Chapter 1" &
stringr::str_starts(
stat_id,
"tab101_"
) ~
"Explicit TAB101 2015 → 2025 columns",
chapter == "Chapter 1" &
stringr::str_starts(
stat_id,
"proj_"
) ~
"Latest observed year → latest projected year",
# ------------------------------------------------------------------------
# Chapter 2
# ------------------------------------------------------------------------
chapter == "Chapter 2" &
stringr::str_starts(
stat_id,
"enrollment_"
) ~
"2025 actual count + FIG206 year-over-year change → 2026P",
chapter == "Chapter 2" &
stringr::str_starts(
stat_id,
"top_recruitment_"
) ~
"2015 historical recruitment baseline → 2025 FIG207 priority",
chapter == "Chapter 2" &
stat_id %in%
c(
"visa_application_process",
"travel_restrictions",
"feeling_unwelcome",
"social_political_environment"
) ~
"Earliest available survey observation → Fall 2025",
# ------------------------------------------------------------------------
# Chapter 3
# ------------------------------------------------------------------------
chapter == "Chapter 3" &
stringr::str_starts(
stat_id,
"h1b_"
) ~
"2017 → 2025",
chapter == "Chapter 3" &
stringr::str_starts(
stat_id,
"founder_origin_"
) ~
"2025 founder-origin snapshot",
chapter == "Chapter 3" &
stringr::str_starts(
stat_id,
"ai_staffing_"
) ~
"Snapshot composition: US / China / rest of world; not a time comparison",
# ------------------------------------------------------------------------
# Chapter 4
# ------------------------------------------------------------------------
chapter == "Chapter 4" &
stat_id %in%
c(
"pisa_us_vs_japan",
"pisa_top_math_us_vs_oecd"
) ~
"2022 PISA benchmark comparison; not a time comparison",
chapter == "Chapter 4" &
stringr::str_starts(
stat_id,
"spending_"
) ~
"OECD spending benchmark comparison; not a time comparison",
chapter == "Chapter 4" &
stringr::str_starts(
stat_id,
"study_field_"
) ~
"Explicit Table 4.03 comparison: 2005 → 2024",
chapter == "Chapter 4" &
stringr::str_starts(
stat_id,
"study_region_"
) ~
"Explicit Table 4.04 comparison: 2005 → 2024",
chapter == "Chapter 4" &
stringr::str_starts(
stat_id,
"outbound_"
) ~
"Latest available outbound-mobility snapshot",
# ------------------------------------------------------------------------
# Chapter 5
# ------------------------------------------------------------------------
chapter == "Chapter 5" &
stringr::str_starts(
stat_id,
"conference_"
) ~
"First and latest years with both US and China observed at the venue",
chapter == "Chapter 5" &
stat_id %in%
c(
"rd_total_us",
"rd_total_china",
"rd_basic_us",
"rd_basic_china",
"rd_experimental_us",
"rd_experimental_china",
"rd_business_us",
"rd_business_china"
) ~
"Explicit R&D comparison: 1994 → 2024",
chapter == "Chapter 5" &
stringr::str_starts(
stat_id,
"patent_biotech_"
) ~
"Explicit biotechnology-patent comparison: 2014 → 2024",
chapter == "Chapter 5" &
stringr::str_starts(
stat_id,
"patent_semiconductor_"
) ~
"Explicit semiconductor-patent comparison: 2014 → 2024",
chapter == "Chapter 5" &
stringr::str_starts(
stat_id,
"patent_computer_"
) ~
"Explicit computer-technology-patent comparison: 2014 → 2024",
chapter == "Chapter 5" &
stringr::str_starts(
stat_id,
"company_"
) ~
"Explicit corporate US-patent comparison: 2005 → 2025",
# ------------------------------------------------------------------------
# Chapter 6
# ------------------------------------------------------------------------
chapter == "Chapter 6" &
stringr::str_starts(
stat_id,
"career_"
) ~
"Explicit Table 6.03 comparison: 1994 → 2024",
chapter == "Chapter 6" &
stringr::str_starts(
stat_id,
"perm_expired_"
) ~
"Explicit Table 6.04 comparison: 2008 → 2024",
chapter == "Chapter 6" &
stringr::str_starts(
stat_id,
"wait_"
) ~
"Explicit Table 6.05 green-card-wait comparison: 2005 → 2025",
chapter == "Chapter 6" &
stat_id %in%
c(
"h1b_denial_spike",
"h1b_denial_recovery"
) ~
"Observed H-1B denial-rate peak / recovery window",
chapter == "Chapter 6" &
stat_id ==
"workforce_gap_us_vs_oecd" ~
"2025 US vs OECD benchmark; not a time comparison",
chapter == "Chapter 6" &
(
stat_id ==
"trained_total" ||
stringr::str_starts(
stat_id,
"loss_"
)
) ~
"2012–14 doctorate cohort evaluated at the published ten-year stay rate",
TRUE ~
"First nonmissing observation → latest nonmissing observation"
)
}
audit_years_expected <- function(
chapter,
stat_id
) {
!(
chapter == "Chapter 3" &
stringr::str_starts(
stat_id,
"ai_staffing_"
)
) &
!(
chapter == "Chapter 4" &
stat_id %in%
c(
"pisa_us_vs_japan",
"pisa_top_math_us_vs_oecd"
)
) &
!(
chapter == "Chapter 4" &
stringr::str_starts(
stat_id,
"spending_"
)
) &
!(
chapter == "Chapter 6" &
(
stat_id ==
"trained_total" ||
stringr::str_starts(
stat_id,
"loss_"
)
)
)
}
audit_page_assignments <- function(
data
) {
pages <- paginate_infographic_data(
data
)
total_pages <- length(
pages
)
purrr::imap_dfr(
pages,
function(page, page_number) {
contract <- infographic_page_contract(
page,
page_number = page_number,
total_pages = total_pages
)
tibble::tibble(
StatID = as.character(
page$StatID
),
Page = as.integer(
page_number
),
PageRow = seq_len(
nrow(page)
),
PageBodyRows =
contract$body_rows,
PageSectionHeaders =
contract$section_headers,
PageRenderedRows =
contract$rendered_rows,
PageIsFinal =
contract$is_final
)
}
)
}
audit_chapter <- function(
data,
chapter,
source_map
) {
page_map <- audit_page_assignments(
data
)
data %>%
dplyr::mutate(
AuditOrder =
dplyr::row_number(),
Source = unname(
source_map[
as.character(
.data$StatID
)
]
),
EarlierYear =
audit_extract_year(
.data$Earlier
),
LatestYear =
audit_extract_year(
.data$Latest
),
EndpointRule =
audit_endpoint_rule(
chapter,
as.character(
.data$StatID
)
),
YearsExpected =
audit_years_expected(
chapter,
as.character(
.data$StatID
)
)
) %>%
dplyr::left_join(
page_map,
by = "StatID"
) %>%
dplyr::mutate(
AuditFlag = dplyr::case_when(
is.na(
.data$Source
) ~
"CHECK: source map missing",
.data$YearsExpected &
.data$Earlier !=
"—" &
is.na(
.data$EarlierYear
) ~
"CHECK: earlier cell has no year",
.data$YearsExpected &
.data$Latest !=
"—" &
is.na(
.data$LatestYear
) ~
"CHECK: latest cell has no year",
!is.na(
.data$EarlierYear
) &
!is.na(
.data$LatestYear
) &
as.integer(
.data$EarlierYear
) >
as.integer(
.data$LatestYear
) ~
"CHECK: earlier year is later than latest year",
.data$PageBodyRows >
INFOGRAPHIC_ROWS_PER_PAGE ~
"CHECK: page exceeds body-row cap",
.data$PageSectionHeaders >
INFOGRAPHIC_SECTION_HEADERS_PER_PAGE ~
"CHECK: page exceeds section-header cap",
.data$PageRenderedRows >
INFOGRAPHIC_RENDERED_ROWS_PER_PAGE ~
"CHECK: page exceeds rendered-row budget",
!.data$PageIsFinal &
.data$PageBodyRows !=
INFOGRAPHIC_ROWS_PER_PAGE ~
"CHECK: nonfinal page is not 30 body rows",
!.data$PageIsFinal &
.data$PageSectionHeaders !=
INFOGRAPHIC_SECTION_HEADERS_PER_PAGE ~
"CHECK: nonfinal page is not 5 section headers",
TRUE ~
""
)
) %>%
dplyr::transmute(
Chapter = chapter,
Page = .data$Page,
PageRow = .data$PageRow,
PageBodyRows =
.data$PageBodyRows,
PageSectionHeaders =
.data$PageSectionHeaders,
PageRenderedRows =
.data$PageRenderedRows,
StatID = as.character(
.data$StatID
),
Section = as.character(
.data$Section
),
Measure = as.character(
.data$Measure
),
Source = .data$Source,
EarlierYear =
.data$EarlierYear,
LatestYear =
.data$LatestYear,
Earlier = as.character(
.data$Earlier
),
Latest = as.character(
.data$Latest
),
Change = as.character(
.data$Change
),
EndpointRule =
.data$EndpointRule,
AuditFlag =
.data$AuditFlag,
AuditOrder =
.data$AuditOrder
)
}
# Chapter 1 is exported through export_current_chapter(), which first performs
# these same two preparation steps. Audit that exact prepared data rather than
# the unformatted ch1_data object.
ch1_audit_data <- finalize_infographic_data(
ch1_data,
ch1_section_order
) %>%
editorialize_infographic_data(
1
)
infographic_source_year_audit <- dplyr::bind_rows(
audit_chapter(
ch1_audit_data,
"Chapter 1",
CH1_AUDIT_SOURCE
),
audit_chapter(
ch2_selected,
"Chapter 2",
CH2_AUDIT_SOURCE
),
audit_chapter(
ch3_selected,
"Chapter 3",
CH3_AUDIT_SOURCE
),
audit_chapter(
ch4_selected,
"Chapter 4",
CH4_AUDIT_SOURCE
),
audit_chapter(
ch5_selected,
"Chapter 5",
CH5_AUDIT_SOURCE
),
audit_chapter(
ch6_selected,
"Chapter 6",
CH6_AUDIT_SOURCE
)
) %>%
dplyr::arrange(
factor(
.data$Chapter,
levels = paste0(
"Chapter ",
1:6
)
),
.data$AuditOrder
) %>%
dplyr::select(
-.data$AuditOrder
)
