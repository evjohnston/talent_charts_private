right_labels = labels_400
) +
scale_y_continuous(
labels = fmt401_sig3,
expand = EXPAND_LINE
) +
scale_color_tpa() +
guides(color = "none") +
labs_meta(
meta,
y = "Change in score since first assessment"
) +
coord_cartesian(
clip = "off"
) +
theme_tpa() +
theme_right_labels(labels_400)
# -------------------------------------------------------------------------
# Save
# -------------------------------------------------------------------------
save_chart_aligned(
FIG401,
"fig_4_01_alt"
)
FIG401
meta <- get_meta("FIG401")
# -------------------------------------------------------------------------
# Local display formatters
# Keeps this figure independent of formatter load order in helper scripts.
# -------------------------------------------------------------------------
fmt401_sig3 <- function(x) {
vapply(
x,
function(z) {
if (is.na(z)) return(NA_character_)
if (!is.finite(z)) return(as.character(z))
format(
signif(z, 3),
scientific = FALSE,
trim       = TRUE,
big.mark   = ","
)
},
character(1)
)
}
fmt401_signed <- function(x) {
paste0(
ifelse(x > 0, "+", ""),
fmt401_sig3(x)
)
}
# -------------------------------------------------------------------------
# Data
# -------------------------------------------------------------------------
df_400 <- read_fig("FIG401") %>%
mutate(across(everything(), as.numeric)) %>%
pivot_longer(
-Year,
names_to  = "Assessment",
values_to = "Score"
) %>%
filter(!is.na(Score)) %>%
arrange(Assessment, Year) %>%
group_by(Assessment) %>%
mutate(
Change   = Score - first(Score),
baseline = first(Score),
peak_val = max(Score)
) %>%
ungroup()
# -------------------------------------------------------------------------
# Series order
# -------------------------------------------------------------------------
level_order <- df_400 %>%
group_by(Assessment) %>%
slice_max(
Year,
n = 1,
with_ties = FALSE
) %>%
ungroup() %>%
arrange(desc(Change)) %>%
pull(Assessment)
df_400 <- df_400 %>%
mutate(
Assessment = factor(
Assessment,
levels = level_order
)
) %>%
arrange(Assessment, Year)
# -------------------------------------------------------------------------
# Peak markers
# Skip PISA Math and any series whose peak is its final observation.
# -------------------------------------------------------------------------
peaks_400 <- df_400 %>%
group_by(Assessment) %>%
slice_max(
Change,
n = 1,
with_ties = FALSE
) %>%
ungroup() %>%
filter(
Year != max(df_400$Year),
Assessment != "PISA Math"
)
# -------------------------------------------------------------------------
# Right-edge labels
# Show change from each assessment's first observation.
# -------------------------------------------------------------------------
labels_400 <- last_by_group(
df_400,
Year,
Assessment
) %>%
mutate(
d_base = Score - baseline,
d_peak = Score - peak_val,
.label = paste0(
as.character(Assessment),
" - ",
fmt401_signed(d_base)
)
) %>%
prepare_right_labels(
df_400$Year,
allow_multiline = TRUE
)
# -------------------------------------------------------------------------
# Chart
# -------------------------------------------------------------------------
FIG401 <- ggplot(
df_400,
aes(
Year,
Change,
color = Assessment,
group = Assessment
)
) +
geom_hline(
yintercept = 0,
color = "grey50",
linewidth = LINE_WIDTH_REF
) +
geom_line(
linewidth = LINE_WIDTH
) +
geom_point(
data = peaks_400,
size = POINT_SIZE
) +
# Standard peak labels
geom_text_tpa(
data = filter(
peaks_400,
!Assessment %in% c("NAEP 13", "PISA")
),
mapping = aes(
label = paste0(
"Peak: ",
fmt401_sig3(Score)
)
)
) +
# NAEP 13 peak label placed below its line
geom_text(
data = filter(
peaks_400,
Assessment %in% c("NAEP 13")
),
mapping = aes(
label = paste0(
"Peak: ",
fmt401_sig3(Score)
)
),
vjust = 2.2,
color = tpa_colors[3],
fontface = "bold",
family = FONT_FAMILY,
size = DATA_LABEL_SIZE / .pt,
show.legend = FALSE
) +
# PISA-specific placement, retained from existing design
geom_text(
data = filter(
peaks_400,
Assessment %in% c("PISA")
),
mapping = aes(
label = paste0(
"Peak: ",
fmt401_sig3(Score)
)
),
vjust = 2.2,
hjust = 1,
nudge_x = -0.4,
color = tpa_colors[5],
fontface = "bold",
family = FONT_FAMILY,
size = DATA_LABEL_SIZE / .pt,
show.legend = FALSE
) +
geom_label_repel_tpa(
data = labels_400,
mapping = aes(
x = .label_x,
label = .label
),
hjust = 0,
direction = "y",
with_segment = TRUE
) +
scale_x_years(
df_400$Year,
right_labels = labels_400
) +
scale_y_continuous(
labels = fmt401_sig3,
expand = EXPAND_LINE
) +
scale_color_tpa() +
guides(color = "none") +
labs_meta(
meta,
y = "Change in score since first assessment"
) +
coord_cartesian(
clip = "off"
) +
theme_tpa() +
theme_right_labels(labels_400)
# -------------------------------------------------------------------------
# Save
# -------------------------------------------------------------------------
save_chart_aligned(
FIG401,
"fig_4_01"
)
FIG401
